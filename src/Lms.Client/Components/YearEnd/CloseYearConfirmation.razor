@using Lms.Shared.YearEnd

@* The body and actions of the Close year dialog (spec #814 §4, D79): what closing locks, what is worth checking first (warnings never block), blocking
   problems if the server sends any, and a typed confirmation of the year's name, because a closed year can't be reopened. The page owns the dialog. *@
<div class="lms-yearend-dialog" data-testid="year-close-dialog">
    <MudText Typo="Typo.body1">@L["YearEnd_Close_Lead"]</MudText>

    @if (Preview.Blocking.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="year-close-blocking">
            <span id="year-close-why">@L["YearEnd_Close_Blocking"]</span>
            <ul class="lms-issue-list">
                @foreach (var issue in Preview.Blocking)
                {
                    <li>@IssueText(issue) @Link(issue)</li>
                }
            </ul>
        </MudAlert>
    }

    <section aria-labelledby="year-close-will">
        <MudText Typo="Typo.subtitle2" id="year-close-will" Class="mb-2">@L["YearEnd_Close_Will"]</MudText>
        <ul class="lms-effects" data-testid="year-close-effects">
            <li><MudIcon Icon="@Icons.Material.Rounded.Lock" aria-hidden="true" /><span class="lms-effects-text">@L.Count("YearEnd_Close_Gradebooks", Preview.GradebooksToLock, Arabic)</span></li>
            <li><MudIcon Icon="@Icons.Material.Rounded.EventBusy" aria-hidden="true" /><span class="lms-effects-text">@L.Count("YearEnd_Close_Sessions", Preview.AttendanceSessionsToLock, Arabic)</span></li>
            <li><MudIcon Icon="@Icons.Material.Rounded.TrendingUp" aria-hidden="true" /><span class="lms-effects-text">@L["YearEnd_Close_Promotion"]</span></li>
        </ul>
    </section>

    @if (Preview.Warnings.Count > 0)
    {
        <section aria-labelledby="year-close-check">
            <MudText Typo="Typo.subtitle2" id="year-close-check" Class="mb-2">@L["YearEnd_Close_Check"]</MudText>
            <ul class="lms-effects">
                @foreach (var issue in Preview.Warnings)
                {
                    <li class="lms-effects-warn" data-testid="@($"year-close-warning-{issue.Code}")">
                        <MudIcon Icon="@Icons.Material.Rounded.Warning" aria-hidden="true" />
                        <span class="lms-effects-text">@IssueText(issue)</span>
                        @Link(issue)
                    </li>
                }
            </ul>
        </section>
    }

    <div class="lms-confirm-type" data-testid="year-close-confirm-input">
        <MudTextField T="string" Value="_typed" ValueChanged="v => _typed = v" Immediate="true" Variant="Variant.Outlined" dir="ltr"
                      Label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, L["YearEnd_Close_Type"].Value, YearName)" autocomplete="off" />
    </div>
</div>
<div class="lms-dialog-actions">
    <MudButton Variant="Variant.Outlined" OnClick="OnCancel" Disabled="Busy" data-testid="year-close-cancel">@L["Common_Cancel"]</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Lock" Disabled="@(!CanClose)" OnClick="ConfirmAsync"
               aria-describedby="@(Preview.Blocking.Count > 0 ? "year-close-why" : null)" data-testid="year-close-confirm">@L["YearEnd_Close_Confirm"]</MudButton>
</div>

@code {
    private string? _typed;

    [Parameter, EditorRequired] public YearClosePreviewDto Preview { get; set; } = default!;
    /// <summary>Where a Review link of an issue goes (the page knows its routes); null = no link.</summary>
    [Parameter] public Func<YearEndIssueDto, string?>? IssueHref { get; set; }
    [Parameter] public bool Busy { get; set; }
    /// <summary>Raised with the typed name (trimmed) for <see cref="CloseYearRequest"/>.</summary>
    [Parameter] public EventCallback<string> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private static bool Arabic => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    private string YearName => CultureText.Pick(Preview.NameAr, Preview.NameEn);
    private string Typed => (_typed ?? "").Trim();
    private bool NameMatches => Typed.Length > 0 && (Typed == Preview.NameEn || Typed == Preview.NameAr);
    private bool CanClose => NameMatches && Preview.Blocking.Count == 0 && !Busy;

    private string IssueText(YearEndIssueDto issue) => $"{L[$"YearIssue_{issue.Code}"]} ({issue.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)})";

    private RenderFragment Link(YearEndIssueDto issue) => __builder =>
    {
        if (IssueHref?.Invoke(issue) is { } href)
        {
            <MudLink Href="@href" Target="_blank" Class="lms-effects-link">@L["YearEnd_Review"]</MudLink>
        }
    };

    private async Task ConfirmAsync()
    {
        if (CanClose) await OnConfirm.InvokeAsync(Typed);
    }
}
