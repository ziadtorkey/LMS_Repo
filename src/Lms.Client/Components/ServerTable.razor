@typeparam T
@using Lms.Client.Services.Api
@inject NavigationManager Navigation

@* Server-paged table (page size 50) with the shared empty/loading/error states. Pages supply the columns.
   On phones (below 600 px) rows become stacked cards; give each MudTd a DataLabel so the cards stay readable. *@
<MudTable @ref="_table" T="T" ServerData="LoadAsync" RowsPerPage="50" Hover="true" Dense="true" Elevation="0"
          HeaderClass="lms-table-head" Class="@($"lms-server-table lms-table {Class}")">
    <HeaderContent>@HeaderContent</HeaderContent>
    <RowTemplate>@RowTemplate(context)</RowTemplate>
    <NoRecordsContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Class="ma-3" data-testid="table-error"
                      ContentAlignment="HorizontalAlignment.Start">
                <div class="d-flex align-center flex-wrap gap-2">
                    <span>@_error</span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="ReloadAsync"
                               StartIcon="@Icons.Material.Rounded.Refresh" data-testid="table-retry">@L["Common_Retry"]</MudButton>
                </div>
            </MudAlert>
        }
        else
        {
            <EmptyState Title="@(EmptyTitle ?? L["Common_Empty"])" Text="@EmptyText" Icon="@EmptyIcon" TestId="table-empty" />
        }
    </NoRecordsContent>
    <LoadingContent>
        <LoadingState Lines="3" Class="pa-4" />
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 50, 100, 200 })" RowsPerPageString="@L["Table_RowsPerPage"]"
                       InfoFormat="@L["Table_InfoFormat"]" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<T> _table = default!;
    private string? _error;

    [Parameter, EditorRequired] public Func<TableState, CancellationToken, Task<TableData<T>>> ServerData { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<T> RowTemplate { get; set; } = default!;
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Empty-state title; defaults to the generic "Nothing here yet".</summary>
    [Parameter] public string? EmptyTitle { get; set; }
    /// <summary>Optional hint under the empty-state title (for example: change the filters).</summary>
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string EmptyIcon { get; set; } = Icons.Material.Rounded.Inbox;

    public Task ReloadAsync() => _table.ReloadServerData();

    /// <summary>Wraps the page's loader so a failing call shows a message in the table instead of the global error bar.</summary>
    private async Task<TableData<T>> LoadAsync(TableState state, CancellationToken ct)
    {
        _error = null;
        try
        {
            return await ServerData(state, ct);
        }
        catch (Exception ex) when (ApiCalls.TryRedirect(ex, Navigation))
        {
            return Empty();
        }
        catch (ApiProblemException ex)
        {
            _error = ProblemText.For(ex, L);
        }
        catch (HttpRequestException)
        {
            _error = L["Error_Generic"];
        }
        return Empty();
    }

    private static TableData<T> Empty() => new() { Items = [], TotalItems = 0 };
}
