@typeparam T
@using Lms.Client.Services.Api
@inject NavigationManager Navigation

@* Server-paged table (page size 50) with the shared empty/loading/error states. Pages supply the columns. *@
<MudTable @ref="_table" T="T" ServerData="LoadAsync" RowsPerPage="50" Hover="true" Dense="true" Class="lms-server-table">
    <HeaderContent>@HeaderContent</HeaderContent>
    <RowTemplate>@RowTemplate(context)</RowTemplate>
    <NoRecordsContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="ma-2" data-testid="table-error">
                @_error
                <MudButton Variant="Variant.Text" OnClick="ReloadAsync" data-testid="table-retry">@L["Common_Retry"]</MudButton>
            </MudAlert>
        }
        else
        {
            <MudText Class="pa-4" data-testid="table-empty">@L["Common_Empty"]</MudText>
        }
    </NoRecordsContent>
    <LoadingContent>
        <MudText Class="pa-4">@L["Common_Loading"]</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 50, 100, 200 })" RowsPerPageString="@L["Table_RowsPerPage"]"
                       InfoFormat="@L["Table_InfoFormat"]" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<T> _table = default!;
    private string? _error;

    [Parameter, EditorRequired] public Func<TableState, CancellationToken, Task<TableData<T>>> ServerData { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<T> RowTemplate { get; set; } = default!;
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    public Task ReloadAsync() => _table.ReloadServerData();

    /// <summary>Wraps the page's loader so a failing call shows a message in the table instead of the global error bar.</summary>
    private async Task<TableData<T>> LoadAsync(TableState state, CancellationToken ct)
    {
        _error = null;
        try
        {
            return await ServerData(state, ct);
        }
        catch (Exception ex) when (ApiCalls.TryRedirect(ex, Navigation))
        {
            return Empty();
        }
        catch (ApiProblemException ex)
        {
            _error = ProblemText.For(ex, L);
        }
        catch (HttpRequestException)
        {
            _error = L["Error_Generic"];
        }
        return Empty();
    }

    private static TableData<T> Empty() => new() { Items = [], TotalItems = 0 };
}
