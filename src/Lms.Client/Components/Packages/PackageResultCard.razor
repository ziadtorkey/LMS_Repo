@* After the content finished: the result as the server judged it, never computed in the browser (design spec §5.3). *@
<SectionCard TestId="package-result-card">
    <MudStack Spacing="2" AlignItems="AlignItems.Start">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(Completed ? Color.Success : Color.Default)" data-testid="package-result-chip">@L[Completed ? "Package_State_Completed" : "Package_State_InProgress"]</MudChip>
        @if (Score is not null)
        {
            <MudText Typo="Typo.h6" data-testid="package-result-score">@Score</MudText>
        }
        <MudButton Variant="Variant.Outlined" OnClick="OnOpenAgain" data-testid="package-open-again">@L["Package_OpenAgain"]</MudButton>
    </MudStack>
</SectionCard>

@code {
    [Parameter] public bool Completed { get; set; }
    [Parameter] public string? Score { get; set; }
    [Parameter] public EventCallback OnOpenAgain { get; set; }
}
