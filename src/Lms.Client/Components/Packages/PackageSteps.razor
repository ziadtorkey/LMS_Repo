@* The three steps of adding a package: upload, check, attach. At phone width only the current label stays (css: lms-steps). *@
<ol class="lms-steps" aria-label="@L["Package_Steps"]" data-testid="package-steps">
    @for (var i = 1; i <= 3; i++)
    {
        var n = i;
        var state = Failed && n == Current ? "failed" : n < Current ? "done" : n == Current ? "current" : "upcoming";
        <li class="@StateClass(state)" aria-current="@(n == Current ? "step" : null)" data-testid="@($"package-step-{n}")">
            <span class="lms-step-number" aria-hidden="true">
                @if (state == "done")
                {
                    <MudIcon Icon="@Icons.Material.Rounded.Check" Size="Size.Small" />
                }
                else if (state == "failed")
                {
                    <MudIcon Icon="@Icons.Material.Rounded.PriorityHigh" Size="Size.Small" />
                }
                else
                {
                    @n
                }
            </span>
            <span class="lms-step-label">@L[Label(n)]</span>
        </li>
    }
</ol>

@code {
    /// <summary>The current step, 1 to 3.</summary>
    [Parameter] public int Current { get; set; } = 1;
    [Parameter] public bool Failed { get; set; }

    /// <summary>The classes lms-activities.css defines for the steps: done and failed (the current one is styled by aria-current).</summary>
    private static string? StateClass(string state) => state switch { "done" => "lms-step-done", "failed" => "lms-step-failed", _ => null };

    private static string Label(int step) => step switch { 1 => "Package_Step_Upload", 2 => "Package_Step_Check", _ => "Package_Step_Attach" };
}
