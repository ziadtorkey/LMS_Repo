@using System.Globalization
@using Lms.Client.Components
@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Shared.Imports
@using Lms.Shared.Organizations
@implements IDisposable
@inject IImportsApi Api
@inject IUnitLookupApi UnitLookup
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime Js

@* Reusable Excel import: 1 template, 2 target unit + file, 3 review (polls while the server works) and commit, 4 result. *@
<div class="lms-import" data-testid="import-wizard">
    @if (ShowTitle)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">@L[TitleKey]</MudText>
    }
    @Banner
    <SectionCard Class="mb-4">
        <ol class="lms-steps lms-import-steps" aria-label="@L["Import_Steps"]" data-testid="import-steps">
            @for (var i = 0; i < _stepKeys.Length; i++)
            {
                var index = i;
                <li class="@(index < _step ? "lms-step-done" : null)" aria-current="@(index == _step ? "step" : null)" data-testid="@($"import-step-{index}")">
                    <span class="lms-step-number" aria-hidden="true">
                        @if (index < _step)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.Check" Size="Size.Small" />
                        }
                        else
                        {
                            @(index + 1)
                        }
                    </span>
                    <span class="lms-step-label">@L[_stepKeys[index]]</span>
                </li>
            }
        </ol>
    </SectionCard>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3" role="alert" data-testid="import-error">@_error</MudAlert>
    }

    @switch (_step)
    {
        case 0:
            <SectionCard Title="@L["Import_Step_Template"]" TestId="import-step-template">
                <MudStack Spacing="3">
                    @Help
                    <MudRadioGroup T="string" Value="_culture" ValueChanged="c => _culture = c" data-testid="import-template-language">
                        <MudText Typo="Typo.subtitle2">@L["Import_TemplateLanguage"]</MudText>
                        <MudRadio T="string" Value="@("ar")" data-testid="import-lang-ar">العربية</MudRadio>
                        <MudRadio T="string" Value="@("en")" data-testid="import-lang-en">English</MudRadio>
                    </MudRadioGroup>
                    @* The template download as a soft panel with the file icon, as on the Stitch screen. *@
                    <div class="lms-import-template" data-testid="import-template-panel">
                        <span class="lms-kind-tile" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.TableView" /></span>
                        <div class="lms-import-template-text">
                            <div class="lms-cell-strong">@L["Import_TemplateFile"]</div>
                            <div class="lms-muted lms-import-hint">@L["Import_TemplateFileHint"]</div>
                        </div>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Download"
                                   OnClick="DownloadTemplateAsync" data-testid="import-template">@L["Import_DownloadTemplate"]</MudButton>
                    </div>
                    <div class="lms-dialog-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.ArrowForward" IconClass="lms-icon-flip"
                                   OnClick="() => _step = 1" data-testid="import-next">@L["Common_Next"]</MudButton>
                    </div>
                </MudStack>
            </SectionCard>
            break;

        case 1:
            <SectionCard Title="@L["Import_Step_Upload"]" TestId="import-step-upload">
                <MudStack Spacing="3">
                    <UnitPicker Value="_unitId" ValueChanged="id => _unitId = id ?? Guid.Empty"
                                Label="@L["Import_TargetUnit"]" TestId="import-unit" />
                    @* The file input fills the whole drop zone, so dropping a file on it works as well as browsing. *@
                    <div class="lms-dropzone lms-import-dropzone" data-testid="import-dropzone">
                        <MudIcon Icon="@Icons.Material.Rounded.CloudUpload" Size="Size.Large" aria-hidden="true" />
                        <div class="lms-cell-strong">@L["Import_DropHint"]</div>
                        <div class="lms-muted lms-import-hint">@L["Import_DropLimits", ImportLimits.MaxFileBytes / (1024 * 1024)]</div>
                        <InputFile accept=".xlsx" OnChange="FileChosenAsync" data-testid="import-file" aria-label="@L["Import_ChooseFile"]" />
                    </div>
                    @if (_file is not null)
                    {
                        <div class="lms-file-row">
                            <MudIcon Icon="@Icons.Material.Rounded.Description" aria-hidden="true" />
                            <div class="lms-file-row-main"><div class="lms-file-row-name" dir="ltr" data-testid="import-file-name">@_file.Name</div></div>
                        </div>
                    }
                    @if (_fileError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert" data-testid="import-file-error">@_fileError</MudAlert>
                    }
                    <div class="lms-dialog-actions">
                        <MudButton Variant="Variant.Text" OnClick="() => _step = 0" data-testid="import-back">@L["Common_Back"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UploadAsync"
                                   Disabled="@(_file is null || _fileError is not null || _unitId == Guid.Empty || _busy)"
                                   data-testid="import-upload">@L["Import_Upload"]</MudButton>
                    </div>
                </MudStack>
            </SectionCard>
            break;

        case 2 when _batch is not null:
            <MudStack Spacing="3" data-testid="import-step-review">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <ImportStatusChip Status="@_batch.Status" />
                    <MudText dir="ltr" Typo="Typo.body2">@_batch.FileName</MudText>
                </MudStack>

                @if (Working)
                {
                    <MudProgressLinear Indeterminate="true" aria-label="@L[WorkingKey]" />
                    <MudText data-testid="import-working">@L[WorkingKey]</MudText>
                }
                else
                {
                    <div class="lms-stats lms-import-stats" data-testid="import-summary">
                        <span class="lms-visually-hidden">@string.Format(CultureInfo.CurrentCulture, L["Import_RowsSummary"].Value, _batch.RowCount, _batch.ErrorCount)</span>
                        @SummaryTile("import-stat-rows", L["Import_StatRows"], _batch.RowCount, Icons.Material.Rounded.TableRows)
                        @SummaryTile("import-stat-valid", L["Import_StatValid"], Math.Max(0, _batch.RowCount - _batch.ErrorCount), Icons.Material.Rounded.TaskAlt)
                        @SummaryTile("import-stat-errors", L["Import_StatErrors"], _batch.ErrorCount, Icons.Material.Rounded.ErrorOutline)
                    </div>
                }

                @if (_batch.Status == ImportStatuses.Invalid)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="import-blocked">@L["Import_BlockedByErrors"]</MudAlert>
                }
                @if (_batch.Status == ImportStatuses.Failed)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="import-failed">@L["Import_Failed"]</MudAlert>
                }

                @if (_batch.Status is ImportStatuses.Valid or ImportStatuses.Invalid)
                {
                    <ImportPreviewTable @key="_batch.Id" Columns="_columns" LoadRows="LoadRowsAsync" />
                }

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @if (_batch.HasErrorReport)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Download"
                                   OnClick="DownloadErrorsAsync" data-testid="import-error-report">@L["Import_DownloadErrors"]</MudButton>
                    }
                    @if (_batch.Status is ImportStatuses.Valid or ImportStatuses.Invalid or ImportStatuses.Failed)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DiscardAsync" Disabled="_busy"
                                   data-testid="import-discard">@L["Import_Discard"]</MudButton>
                    }
                    @if (_batch.Status == ImportStatuses.Valid)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CommitAsync" Disabled="_busy"
                                   data-testid="import-commit">@string.Format(CultureInfo.CurrentCulture, L["Import_Commit"].Value, _batch.RowCount)</MudButton>
                    }
                </MudStack>
            </MudStack>
            break;

        default:
            <MudStack Spacing="3" data-testid="import-step-done">
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" data-testid="import-done">@string.Format(CultureInfo.CurrentCulture, L["Import_Done"].Value, _batch?.CreatedCount ?? 0)</MudAlert>
                @if (_batch is not null) { @DoneContent?.Invoke(_batch) }
                <MudButton Variant="Variant.Outlined" OnClick="Restart" data-testid="import-again">@L["Import_Another"]</MudButton>
            </MudStack>
            break;
    }
</div>

@code {
    /// <summary>False when the hosting page already shows the title (its page header).</summary>
    [Parameter] public bool ShowTitle { get; set; } = true;

    private static readonly string[] _stepKeys =
        ["Import_Step_Template", "Import_Step_Upload", "Import_Step_Review", "Import_Step_Done"];

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<OrgUnitNodeDto> _units = [];
    private IReadOnlyList<ImportColumnDto> _columns = [];
    private ImportBatchDto? _batch;
    private IBrowserFile? _file;
    private string? _fileError, _error;
    private string _culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "ar" : "en";
    private Guid _unitId;
    private int _step;
    private bool _busy;
    private bool _polling;

    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter] public string TitleKey { get; set; } = "Import_Title";
    [Parameter] public Guid? DefaultOrgUnitId { get; set; }
    [Parameter] public EventCallback<ImportBatchDto> OnCommitted { get; set; }

    /// <summary>Shown above the steps (e.g. which academic year the import applies to).</summary>
    [Parameter] public RenderFragment? Banner { get; set; }

    /// <summary>Shown on the template step (what the columns mean).</summary>
    [Parameter] public RenderFragment? Help { get; set; }

    /// <summary>Shown on the result step of a committed batch (e.g. the one-time credentials sheet).</summary>
    [Parameter] public RenderFragment<ImportBatchDto>? DoneContent { get; set; }

    /// <summary>How often the batch is re-read while the server validates or commits it.</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(2);

    private RenderFragment SummaryTile(string testId, string label, int value, string icon) => __builder =>
    {
        <div class="lms-stat" data-testid="@testId">
            <div>
                <div class="lms-stat-label">@label</div>
                <div class="lms-stat-value" data-testid="@($"{testId}-value")">@value</div>
            </div>
            <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@icon" /></span>
        </div>
    };

    private bool Working => _batch?.Status is ImportStatuses.Uploaded or ImportStatuses.Validating or ImportStatuses.Committing;
    private string WorkingKey => _batch?.Status == ImportStatuses.Committing ? "Import_Committing" : "Import_Validating";

    protected override async Task OnInitializedAsync()
    {
        var (units, failed) = await ApiCalls.RunAsync(() => UnitLookup.GetUnitsAsync(), Navigation);
        if (failed) { _error = L["Api_Error"]; return; }
        _units = units ?? [];
        _unitId = DefaultOrgUnitId ?? UnitTree.Order(_units).FirstOrDefault()?.Id ?? Guid.Empty;
        var (columns, _) = await ApiCalls.RunAsync(() => Api.GetColumnsAsync(Kind), Navigation);
        _columns = columns ?? [];
    }

    private async Task DownloadTemplateAsync() =>
        await DownloadAsync(() => Api.DownloadTemplateAsync(Kind, _culture, _lifetime.Token));

    private async Task DownloadErrorsAsync() =>
        await DownloadAsync(() => Api.DownloadErrorReportAsync(Kind, _batch!.Id, _lifetime.Token));

    private async Task DownloadAsync(Func<Task<(Stream Content, string FileName)>> fetch)
    {
        _error = null;
        await ApiCalls.RunAsync(async () =>
        {
            var (content, fileName) = await fetch();
            using var reference = new DotNetStreamReference(content);
            await Js.InvokeVoidAsync("lmsDownloadFile", fileName, reference);
        }, Navigation, L, message => _error = message);
    }

    private void FileChosenAsync(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _fileError = e.File.Size > ImportLimits.MaxFileBytes ? L["Import_FileTooLarge"].Value : null;
    }

    private async Task UploadAsync()
    {
        _busy = true;
        _error = null;
        var ok = await ApiCalls.RunAsync(async () => _batch = await Api.UploadAsync(Kind, _unitId, _file!, _lifetime.Token),
            Navigation, L, message => _error = message);
        _busy = false;
        if (!ok) return;
        _step = 2;
        _ = PollAsync();
    }

    /// <summary>Asks for confirmation, then commits (the dialog result is not awaited in the click handler).</summary>
    private Task CommitAsync() => DialogFlow.ShowAsync(Dialogs, L["Import_Title"],
        new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, string.Format(CultureInfo.CurrentCulture, L["Import_CommitConfirm"].Value, _batch!.RowCount) },
            { x => x.ConfirmText, string.Format(CultureInfo.CurrentCulture, L["Import_Commit"].Value, _batch.RowCount) },
        }, RunCommitAsync);

    private async Task RunCommitAsync()
    {
        _busy = true;
        _error = null;
        StateHasChanged();
        var ok = await ApiCalls.RunAsync(async () => _batch = await Api.CommitAsync(Kind, _batch!.Id, _lifetime.Token),
            Navigation, L, message => _error = message);
        _busy = false;
        StateHasChanged();
        if (ok) _ = PollAsync();
    }

    private async Task DiscardAsync()
    {
        _busy = true;
        var ok = await ApiCalls.RunAsync(() => Api.DiscardAsync(Kind, _batch!.Id, _lifetime.Token),
            Navigation, L, message => _error = message);
        _busy = false;
        if (ok) Restart();
    }

    private void Restart()
    {
        _batch = null;
        _file = null;
        _fileError = null;
        _error = null;
        _step = 0;
    }

    /// <summary>Re-reads the batch until the server is done with it (Uploaded/Validating/Committing); stops when the wizard is left.</summary>
    private async Task PollAsync()
    {
        if (_polling) return;
        _polling = true;
        try
        {
            while (Working && !_lifetime.IsCancellationRequested)
            {
                await Task.Delay(PollInterval, _lifetime.Token);
                var batch = await Api.GetBatchAsync(Kind, _batch!.Id, _lifetime.Token);
                var wasCommitting = _batch.Status == ImportStatuses.Committing;
                await InvokeAsync(() => { _batch = batch; StateHasChanged(); });
                if (wasCommitting && batch.Status == ImportStatuses.Committed)
                {
                    await OnCommitted.InvokeAsync(batch);
                    _step = 3;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // the wizard was left
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException)
        {
            await InvokeAsync(() => { _error = L["Error_Generic"]; StateHasChanged(); });
        }
        finally
        {
            _polling = false;
        }
    }

    private Task<Lms.Shared.PagedResult<ImportRowDto>> LoadRowsAsync(int page, int pageSize, bool errorsOnly, CancellationToken ct) =>
        Api.GetRowsAsync(Kind, _batch!.Id, errorsOnly, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, page, pageSize, ct);

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
