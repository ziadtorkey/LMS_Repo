@using Lms.Client.Services.Api
@inject IImportsApi Api
@inject IJSRuntime Js
@inject NavigationManager Navigation

@* One-time download of the credentials sheet of a committed student import (D24): the server serves it once, to the requester, for 15 minutes. *@
<MudStack Spacing="2" data-testid="credentials-sheet">
    <MudAlert Severity="Severity.Warning" data-testid="credentials-once-warning">@L["StudentImport_CredentialsOnce"]</MudAlert>
    @if (_message is not null)
    {
        <MudAlert Severity="@(_downloaded ? Severity.Success : Severity.Error)" data-testid="credentials-message">@_message</MudAlert>
    }
    <div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAsync"
                   Disabled="@(_downloaded || _busy)" data-testid="credentials-download">@L["StudentImport_DownloadCredentials"]</MudButton>
    </div>
</MudStack>

@code {
    private bool _downloaded, _busy;
    private string? _message;

    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public Guid BatchId { get; set; }

    private async Task DownloadAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var (content, fileName) = await Api.DownloadCredentialsAsync(Kind, BatchId);
            using var reference = new DotNetStreamReference(content);
            await Js.InvokeVoidAsync("lmsDownloadFile", fileName, reference);
            _downloaded = true;
            _message = L["StudentImport_CredentialsDone"];
        }
        catch (ApiProblemException ex) when (ex.Status is 404 or 410)
        {
            // Already downloaded, expired (15 minutes) or not the requester: there is nothing to download any more.
            _downloaded = true;
            _message = L["StudentImport_CredentialsGone"];
        }
        catch (Exception ex) when (ApiCalls.TryRedirect(ex, Navigation))
        {
        }
        catch (Exception ex) when (ex is ApiProblemException or HttpRequestException)
        {
            _message = L["Api_Error"];
        }
        _busy = false;
    }
}
