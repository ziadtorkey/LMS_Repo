@using Lms.Shared.People
@inject IJSRuntime Js

@* Shows the issued student credentials once (D24): the password is never returned again, so it can be copied here. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" data-testid="credentials-once">@L["Credentials_Once"]</MudAlert>
            <MudTextField T="string" Value="Code" ReadOnly="true" Label="@L["Student_Code"]" dir="ltr" data-testid="credentials-code" />
            <MudTextField T="string" Value="Password" ReadOnly="true" Label="@L["Credentials_Password"]" dir="ltr"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="CopyAsync"
                          AdornmentAriaLabel="@L["Credentials_Copy"]" data-testid="credentials-password" />
            @if (_copied)
            {
                <MudText Typo="Typo.caption" Color="Color.Success" data-testid="credentials-copied">@L["Credentials_Copied"]</MudText>
            }
            <MudText data-testid="credentials-delivery">@L[$"CredentialsDelivery_{SentTo}"]</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close()" data-testid="credentials-done">@L["Common_Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string Password { get; set; } = "";

    /// <summary>A <see cref="CredentialsDelivery"/> value.</summary>
    [Parameter] public string SentTo { get; set; } = CredentialsDelivery.None;

    private bool _copied;

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            _copied = true;
        }
        catch (JSException)
        {
            // Clipboard blocked: the password is still selectable on screen.
        }
    }
}
