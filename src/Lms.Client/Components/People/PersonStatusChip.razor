@using Lms.Shared.People

@* A person's status as a soft, tinted chip with a status dot (PersonStatus_* resources); the text carries the meaning, not only the colour. *@
<MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ColorFor(Status)" Class="lms-status-chip" data-testid="person-status" data-status="@Status">
    @L[$"PersonStatus_{Status}"]
</MudChip>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = PersonStatuses.Active;

    private static Color ColorFor(string status) => status switch
    {
        PersonStatuses.Active => Color.Success,
        PersonStatuses.Expired => Color.Warning,
        _ => Color.Default,
    };
}
