@using System.Globalization
@using Lms.Client.Services.Api
@using Lms.Shared.Grading

@* A strip of the bands over 0 to 100 and, as text, every gap and overlap (colour is never the only signal). A hint: the server has the last word. *@
<div class="lms-band-strip-wrap" data-testid="band-coverage">
    <div class="lms-band-strip" role="img" aria-label="@L["Band_Strip"]">
        @foreach (var b in Segments)
        {
            <span class="lms-band-seg @(b.Valid ? null : "lms-band-seg-bad")" style="inline-size: @(b.Width.ToString("0.##", CultureInfo.InvariantCulture))%" title="@b.Code"></span>
        }
    </div>
    <div class="lms-band-scale" dir="ltr" aria-hidden="true"><span>0</span><span>100</span></div>
    @if (ServerProblems.Count > 0)
    {
        @* What the server found when it refused the save: each gap or overlap with its range, next to the bands it concerns. *@
        <ul class="lms-band-issues" role="alert" data-testid="band-server-issues">
            @foreach (var p in ServerProblems)
            {
                <li data-testid="@($"band-server-{p.Kind}")">@ServerText(p)</li>
            }
        </ul>
    }
    @if (Issues.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Success" role="status" data-testid="band-coverage-ok">@L["Band_CoverageOk"]</MudText>
    }
    else
    {
        <ul class="lms-band-issues" role="status" data-testid="band-coverage-issues">
            @foreach (var issue in Issues)
            {
                <li data-testid="@($"band-issue-{issue.Kind}")">@Text(issue)</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<BandRow> Bands { get; set; } = [];

    /// <summary>The problems the answer to a refused save carried (problems with kind, from and to); empty until then and after the next edit.</summary>
    [Parameter] public IReadOnlyList<ApiProblemItem> ServerProblems { get; set; } = [];

    private string ServerText(ApiProblemItem p)
    {
        var from = p.From?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";
        var to = p.To?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";
        var key = p.Kind switch
        {
            "Gap" => "Band_ServerGap",
            "Overlap" => "Band_ServerOverlap",
            "Range" => "Band_ServerRange",
            "Count" => "Band_ServerCount",
            _ => "Band_ServerOther",
        };
        return string.Format(CultureInfo.CurrentCulture, L[key].Value, from, to);
    }

    private IReadOnlyList<CoverageIssue> Issues => BandCoverage.Analyse(Filled.Select(b => (b.MinPercent!.Value, b.MaxPercent!.Value)));

    private IEnumerable<BandRow> Filled => Bands.Where(b => b.MinPercent is not null && b.MaxPercent is not null);

    private IEnumerable<(string Code, decimal Width, bool Valid)> Segments =>
        Filled.OrderBy(b => b.MinPercent).Select(b => (b.Code, Math.Max(0m, Math.Min(100m, b.MaxPercent!.Value) - Math.Max(0m, b.MinPercent!.Value)), b.MaxPercent >= b.MinPercent));

    private string Text(CoverageIssue issue)
    {
        var from = issue.From.ToString("0.##", CultureInfo.InvariantCulture);
        var to = issue.To.ToString("0.##", CultureInfo.InvariantCulture);
        return issue.Kind switch
        {
            CoverageIssueKind.StartsAbove => string.Format(CultureInfo.CurrentCulture, L["Band_CoverageStart"].Value, from, to),
            CoverageIssueKind.EndsBelow => string.Format(CultureInfo.CurrentCulture, L["Band_CoverageEnd"].Value, from, to),
            CoverageIssueKind.Gap => string.Format(CultureInfo.CurrentCulture, L["Band_CoverageGap"].Value, from, to),
            CoverageIssueKind.Overlap => string.Format(CultureInfo.CurrentCulture, L["Band_CoverageOverlap"].Value, from, to),
            _ => string.Format(CultureInfo.CurrentCulture, L["Band_CoverageInverted"].Value, from, to),
        };
    }
}
