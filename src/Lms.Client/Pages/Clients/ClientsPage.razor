@page "/clients"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared
@using Lms.Shared.Authorization
@using Lms.Shared.Organizations
@inject IClientsApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["Clients_Title"]</PageTitle>
<PageHeader Title="@L["Clients_Title"]" Subtitle="@L["Clients_Subtitle"]" TitleTestId="clients-title">
    <Actions>
        @if (CanCreate)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add"
                       OnClick="NewClientAsync" data-testid="clients-new">@L["Clients_New"]</MudButton>
        }
    </Actions>
</PageHeader>

<SectionCard Flush="true">
    <div class="lms-filters" role="search" aria-label="@L["Common_Filters"]">
        <div class="lms-filter lms-filter-search lms-search-row">
            <MudTextField T="string" @bind-Value="_searchText" Label="@L["Common_Search"]" Immediate="true" Clearable="true"
                          HelperText="@L["Clients_SearchHelp"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search"
                          OnKeyDown="OnSearchKey" data-testid="clients-search" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SearchAsync" aria-label="@L["Common_Search"]"
                       data-testid="clients-search-button">@L["Common_Search"]</MudButton>
        </div>
    </div>

    <ServerTable @ref="_table" T="ClientDto" ServerData="LoadAsync" EmptyTitle="@L["Clients_EmptyTitle"]"
                 EmptyText="@L["Clients_EmptyText"]" EmptyIcon="@Icons.Material.Rounded.Business">
        <HeaderContent>
            <MudTh>@L["Common_Name"]</MudTh>
            <MudTh>@L["Clients_ShortCode"]</MudTh>
            <MudTh>@L["Clients_Type"]</MudTh>
            <MudTh>@L["Common_Status"]</MudTh>
            <MudTh>@L["Clients_CreatedOn"]</MudTh>
            <MudTh><span class="lms-visually-hidden">@L["Common_Actions"]</span></MudTh>
        </HeaderContent>
        <RowTemplate Context="client">
            <MudTd DataLabel="@L["Common_Name"]"><span class="lms-cell-strong">@Culture.Pick(client.NameAr, client.NameEn)</span></MudTd>
            <MudTd DataLabel="@L["Clients_ShortCode"]">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="lms-code-chip">
                    <span dir="ltr" data-testid="@($"client-short-code-{client.Id}")">@client.ShortCode</span>
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["Clients_Type"]">@L[$"ClientType_{client.Type}"]</MudTd>
            <MudTd DataLabel="@L["Common_Status"]">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="lms-status-chip"
                         Color="@(client.Status == OrganizationStatuses.Active ? Color.Success : Color.Warning)">
                    @L[$"ClientStatus_{client.Status}"]
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["Clients_CreatedOn"]">
                <span dir="ltr" class="lms-muted lms-date-cell">@client.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</span>
            </MudTd>
            <MudTd Class="lms-cell-actions">
                @if (CanUpdate)
                {
                    var active = client.Status == OrganizationStatuses.Active;
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="@(active ? Color.Warning : Color.Primary)"
                               StartIcon="@(active ? Icons.Material.Rounded.PauseCircle : Icons.Material.Rounded.PlayCircle)"
                               OnClick="() => ToggleAsync(client)" data-testid="@($"client-toggle-{client.Id}")">
                        @(active ? L["Clients_Suspend"] : L["Clients_Activate"])
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
    </ServerTable>
</SectionCard>

@code {
    private ServerTable<ClientDto> _table = default!;
    private string? _searchText;
    private string? _search;

    // A platform admin may have no active context (so no cached permissions); the server still enforces every call.
    private bool CanCreate => PermState.IsPlatformAdmin || PermState.Has(Permissions.Clients.Create);
    private bool CanUpdate => PermState.IsPlatformAdmin || PermState.Has(Permissions.Clients.Update);

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;

    private async Task<TableData<ClientDto>> LoadAsync(TableState state, CancellationToken ct)
    {
        // Failures (403, stale context, 5xx…) are handled by ServerTable.
        var result = await Api.ListAsync(state.Page + 1, state.PageSize, _search, ct);
        return new TableData<ClientDto> { Items = result.Items, TotalItems = result.Total };
    }

    private Task SearchAsync()
    {
        _search = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim();
        return _table.ReloadAsync();
    }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task NewClientAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateClientDialog>(L["Clients_New"], new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(L["Clients_Created"], Severity.Success);
            await _table.ReloadAsync();
        }
    }

    private async Task ToggleAsync(ClientDto client)
    {
        var status = client.Status == OrganizationStatuses.Active ? OrganizationStatuses.Suspended : OrganizationStatuses.Active;
        try
        {
            await Api.UpdateAsync(client.Id, new UpdateClientRequest(client.NameAr, client.NameEn, status));
            await _table.ReloadAsync();
        }
        catch (ApiProblemException ex)
        {
            Snackbar.Add(ProblemText.For(ex, L), Severity.Error);
        }
    }
}
