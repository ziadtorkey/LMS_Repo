@using System.ComponentModel.DataAnnotations
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Organizations
@inject IClientsApi Api

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Class="lms-form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-testid="dialog-error">@_error</MudAlert>
            }

            <fieldset class="lms-fieldset">
                <legend class="lms-fieldset-legend">@L["Clients_Name"]</legend>
                <BilingualNameFields @bind-NameAr="_nameAr" @bind-NameEn="_nameEn" IdPrefix="client-name" />
                <div class="lms-form-grid">
                    <MudSelect T="string" @bind-Value="_type" Label="@L["Clients_Type"]" data-testid="client-type">
                        @foreach (var type in OrganizationTypes.All)
                        {
                            <MudSelectItem T="string" Value="@type">@L[$"ClientType_{type}"]</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Value="_shortCode" ValueChanged="v => _shortCode = (v ?? string.Empty).ToLowerInvariant()" Label="@L["Clients_ShortCode"]"
                                  HelperText="@L["Clients_ShortCodeHelp"]" Validation="@(new Func<string, string?>(ValidateShortCode))"
                                  MaxLength="20" dir="ltr" Immediate="true" spellcheck="false" data-testid="client-short-code" />
                </div>
            </fieldset>

            <fieldset class="lms-fieldset">
                <legend class="lms-fieldset-legend">@L["Clients_RootLevel"]</legend>
                <BilingualNameFields @bind-NameAr="_rootLevelAr" @bind-NameEn="_rootLevelEn" IdPrefix="root-level" />
                <MudTextField T="string" @bind-Value="_rootCode" Label="@L["Clients_RootCode"]" Required="true"
                              RequiredError="@L["Common_Required"]" Validation="@(new Func<string, string?>(ValidateCode))"
                              MaxLength="50" dir="ltr" spellcheck="false" data-testid="root-code" />
            </fieldset>

            <fieldset class="lms-fieldset">
                <legend class="lms-fieldset-legend">@L["Clients_AdminName"]</legend>
                <BilingualNameFields @bind-NameAr="_adminAr" @bind-NameEn="_adminEn" IdPrefix="admin-name" />
                <MudTextField T="string" @bind-Value="_adminEmail" Label="@L["Clients_AdminEmail"]" Required="true"
                              RequiredError="@L["Common_Required"]" Validation="@(new Func<string, string?>(ValidateEmail))"
                              HelperText="@L["Clients_AdminEmailHelp"]" InputType="InputType.Email" dir="ltr" spellcheck="false"
                              data-testid="admin-email" />
            </fieldset>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => MudDialog.Cancel()" data-testid="dialog-cancel">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving"
                   StartIcon="@(_saving ? null : Icons.Material.Rounded.Check)" data-testid="dialog-save">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" aria-hidden="true" />
            }
            @L["Common_Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private string _nameAr = "", _nameEn = "", _rootLevelAr = "", _rootLevelEn = "", _rootCode = "";
    private string _adminAr = "", _adminEn = "", _adminEmail = "", _shortCode = "";
    private string _type = OrganizationTypes.SchoolGroup;
    private string? _error;
    private bool _saving;

    private string? ValidateCode(string value) =>
        System.Text.RegularExpressions.Regex.IsMatch(value ?? "", "^[A-Za-z0-9_-]{1,50}$") ? null : L["Common_InvalidCode"].Value;

    /// <summary>Optional: empty lets the server derive it from the root unit code (D47); otherwise 2-20 lower-case letters, digits or hyphens.</summary>
    private string? ValidateShortCode(string value) =>
        string.IsNullOrEmpty(value) || System.Text.RegularExpressions.Regex.IsMatch(value, "^[a-z0-9-]{2,20}$") ? null : L["Error_invalid_short_code"].Value;

    private string? ValidateEmail(string value) =>
        new EmailAddressAttribute().IsValid(value) ? null : L["Common_InvalidEmail"].Value;

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true; _error = null;
        try
        {
            await Api.CreateAsync(new CreateClientRequest(
                _nameAr.Trim(), _nameEn.Trim(), _type, _rootLevelAr.Trim(), _rootLevelEn.Trim(),
                _rootCode.Trim(), _adminEmail.Trim(), _adminAr.Trim(), _adminEn.Trim(),
                string.IsNullOrWhiteSpace(_shortCode) ? null : _shortCode.Trim()));
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiProblemException ex)
        {
            _error = ProblemText.For(ex, L);
        }
        finally { _saving = false; }
    }
}
