@page "/classes/import"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Components.Imports
@using Lms.Client.Services
@using Lms.Shared.Authorization
@using Lms.Shared.Imports
@implements IDisposable
@inject PermissionState PermState
@inject IYearStore Years
@inject ICultureService Culture

<PageTitle>@L["ClassImport_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Enrollment.Import))
{
    <Forbidden />
}
else
{
    <MudLink Href="students" Typo="Typo.body2" Class="lms-back-link" data-testid="class-import-back">
        <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
        @L["Student_BackToList"]
    </MudLink>
    <PageHeader Title="@L["ClassImport_Title"]" Subtitle="@L["ClassImport_Subtitle"]" TitleTestId="class-import-title" />
    <ImportWizard Kind="@ImportKinds.ClassStudents" TitleKey="ClassImport_Title" ShowTitle="false">
        <Banner>
            @* Placement always goes into the classes of the current academic year of the unit. *@
            @if (Years.Selected is { } year)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" data-testid="class-import-year">@L["ClassImport_Year", Culture.Pick(year.NameAr, year.NameEn)]</MudAlert>
            }
        </Banner>
        <Help>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="class-import-help">@L["ClassImport_Help"]</MudAlert>
        </Help>
    </ImportWizard>
    <ImportHistory Kind="@ImportKinds.ClassStudents" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        Years.Changed += OnPermissionsChanged; // the banner follows the year selector
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PermState.Changed -= OnPermissionsChanged;
        Years.Changed -= OnPermissionsChanged;
    }
}
