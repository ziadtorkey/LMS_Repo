@page "/classes/{Id:guid}"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Classes
@implements IDisposable
@inject IClassesApi Api
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["Classes_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Classes.View))
{
    <Forbidden />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" data-testid="class-error">@_error</MudAlert>
}
else if (_class is null)
{
    <MudText>@L["Common_Loading"]</MudText>
}
else
{
    <PageHeader Title="@Culture.Pick(_class.NameAr, _class.NameEn)" TitleTestId="class-title"
                Subtitle="@string.Join(" · ", new[] { Culture.Pick(_class.OrgUnitNameAr, _class.OrgUnitNameEn), Culture.Pick(_class.YearNameAr, _class.YearNameEn) }.Where(t => !string.IsNullOrWhiteSpace(t)))">
        <Leading>
            <span class="lms-kind-tile" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.Groups" /></span>
        </Leading>
        <Badges>
            <span class="lms-code-chip" dir="ltr" data-testid="class-code">@_class.Code</span>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="lms-status-chip" Color="@(_class.Status == ClassStatuses.Active ? Color.Success : Color.Default)">@L[$"ClassStatus_{_class.Status}"]</MudChip>
        </Badges>
    </PageHeader>
    @if (_class.IsReadOnly)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" data-testid="class-readonly">@L["Classes_YearClosed"]</MudAlert>
    }

    @* The Stitch stat tiles, from the class's own numbers. *@
    <div class="lms-stats" data-testid="class-stats">
        <div class="lms-stat">
            <div>
                <div class="lms-stat-label">@L["ClassPage_Students"]</div>
                <div class="lms-stat-value" data-testid="class-count"><bdi dir="ltr">@_class.StudentCount@(_class.Capacity is { } cap ? $" / {cap}" : "")</bdi></div>
            </div>
            <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.School" /></span>
        </div>
        <div class="lms-stat">
            <div>
                <div class="lms-stat-label">@L["ClassPage_Courses"]</div>
                <div class="lms-stat-value" data-testid="class-course-count">@_class.CourseCount</div>
            </div>
            <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.MenuBook" /></span>
        </div>
        <div class="lms-stat">
            <div>
                <div class="lms-stat-label">@L["ClassPage_Homeroom"]</div>
                <div class="lms-stat-value lms-stat-text" data-testid="class-homeroom">@(string.IsNullOrEmpty(Culture.Pick(_class.HomeroomTeacherNameAr ?? "", _class.HomeroomTeacherNameEn ?? "")) ? "—" : Culture.Pick(_class.HomeroomTeacherNameAr ?? "", _class.HomeroomTeacherNameEn ?? ""))</div>
            </div>
            <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.Person" /></span>
        </div>
    </div>

    @* No Timetable tab: it arrives with the scheduling milestone. *@
    <SectionCard Flush="true">
    <MudTabs Class="lms-tabs" Elevation="0" Rounded="false" ApplyEffectsToContainer="true" TabPanelsClass="pa-4" data-testid="class-tabs">
        <MudTabPanel Text="@L["ClassPage_Students"]" data-testid="tab-students">
            <MudButton Href="@($"classes/{_class.Id}/students")" Variant="Variant.Outlined" data-testid="open-students">@L["ClassPage_OpenStudents"]</MudButton>
        </MudTabPanel>
        <MudTabPanel Text="@L["ClassPage_Courses"]" data-testid="tab-courses">
            <ClassCoursesTab Class="_class" CanManage="PermState.Has(Permissions.Classes.ManageCourses)" />
        </MudTabPanel>
        <MudTabPanel Text="@L["ClassPage_Teachers"]" data-testid="tab-teachers">
            <MudText data-testid="teachers-soon">@L["ClassPage_TeachersSoon"]</MudText>
        </MudTabPanel>
    </MudTabs>
    </SectionCard>
}

@code {
    private ClassSummaryDto? _class;
    private string? _error;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        PermState.Changed -= OnPermissionsChanged;
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        if (!PermState.Has(Permissions.Classes.View)) return;
        _error = null;
        await ApiCalls.RunAsync(async () => _class = await Api.GetAsync(Id), Navigation, L,
            _ => _error = L["ClassPage_NotFound"]);
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
