@page "/classes/{Id:guid}"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Classes
@implements IDisposable
@inject IClassesApi Api
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["Classes_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Classes.View))
{
    <Forbidden />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" data-testid="class-error">@_error</MudAlert>
}
else if (_class is null)
{
    <MudText>@L["Common_Loading"]</MudText>
}
else
{
    <MudStack Spacing="1" Class="mb-3">
        <MudText Typo="Typo.h4" data-testid="class-title">@Culture.Pick(_class.NameAr, _class.NameEn)</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2"><span dir="ltr" data-testid="class-code">@_class.Code</span></MudText>
            <MudText Typo="Typo.body2">@Culture.Pick(_class.OrgUnitNameAr, _class.OrgUnitNameEn)</MudText>
            <MudText Typo="Typo.body2">@Culture.Pick(_class.YearNameAr, _class.YearNameEn)</MudText>
            <MudChip T="string" Size="Size.Small" Color="@(_class.Status == ClassStatuses.Active ? Color.Success : Color.Default)">@L[$"ClassStatus_{_class.Status}"]</MudChip>
            <MudText Typo="Typo.body2" data-testid="class-count">@_class.StudentCount@(_class.Capacity is { } cap ? $" / {cap}" : "")</MudText>
        </MudStack>
        @if (_class.IsReadOnly)
        {
            <MudAlert Severity="Severity.Info" data-testid="class-readonly">@L["Classes_YearClosed"]</MudAlert>
        }
    </MudStack>

    <MudTabs Elevation="0" Rounded="true" data-testid="class-tabs">
        <MudTabPanel Text="@L["ClassPage_Students"]" data-testid="tab-students">
            <MudButton Href="@($"classes/{_class.Id}/students")" Variant="Variant.Outlined" data-testid="open-students">@L["ClassPage_OpenStudents"]</MudButton>
        </MudTabPanel>
        <MudTabPanel Text="@L["ClassPage_Courses"]" data-testid="tab-courses">
            <ClassCoursesTab Class="_class" CanManage="PermState.Has(Permissions.Classes.ManageCourses)" />
        </MudTabPanel>
        @if (PermState.Has(Permissions.Timetable.View))
        {
            <MudTabPanel Text="@L["ClassPage_Timetable"]" data-testid="tab-timetable">
                <ClassTimetableTab ClassId="_class.Id" />
            </MudTabPanel>
        }
        @if (PermState.Has(Permissions.TeacherAssignments.View))
        {
            <MudTabPanel Text="@L["ClassPage_Teachers"]" data-testid="tab-teachers">
                <ClassTeachersTab Class="_class" CanManage="PermState.Has(Permissions.TeacherAssignments.Manage)" />
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private ClassSummaryDto? _class;
    private string? _error;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        PermState.Changed -= OnPermissionsChanged;
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        if (!PermState.Has(Permissions.Classes.View)) return;
        _error = null;
        await ApiCalls.RunAsync(async () => _class = await Api.GetAsync(Id), Navigation, L,
            _ => _error = L["ClassPage_NotFound"]);
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
