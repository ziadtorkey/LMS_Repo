@page "/notifications/preferences"
@attribute [Authorize]
@using Lms.Client.Services.Api
@using Lms.Shared.Notifications
@inject INotificationsApi Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@L["Notif_Preferences"]</PageTitle>
<MudLink Href="notifications" Typo="Typo.body2" Class="lms-back-link" data-testid="prefs-back">
    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
    @L["Notif_Title"]
</MudLink>
<PageHeader Title="@L["Notif_Preferences"]" Subtitle="@L["Notif_PrefsSubtitle"]" />

@if (_loading)
{
    <LoadingState Lines="6" />
}
else if (_failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="api-error">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>@L["Api_Error"]</span>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Refresh"
                       OnClick="LoadAsync">@L["Common_Retry"]</MudButton>
        </div>
    </MudAlert>
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-testid="prefs-error">@_error</MudAlert>
    }
    <SectionCard Flush="true">
        <div class="lms-prefs-legend">
            <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" aria-hidden="true" />
            <span>@L["Notif_LockedHint"]</span>
        </div>
        <MudSimpleTable Dense="true" Elevation="0" Class="lms-simple-table lms-stack-table lms-prefs-table">
            <thead>
                <tr>
                    <th>@L["Notif_Event"]</th>
                    @foreach (var channel in NotificationChannels.All)
                    {
                        <th class="lms-prefs-channel">@L[$"Channel_{channel}"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in _events)
                {
                    var key = ev;
                    <tr>
                        <td class="lms-cell-strong lms-prefs-event">@L[NotificationText.EventLabelKey(key)]</td>
                        @foreach (var channel in NotificationChannels.All)
                        {
                            var c = channel;
                            var pref = Find(key, c);
                            <td data-label="@L[$"Channel_{c}"]" class="lms-prefs-channel">
                                <span class="lms-prefs-switch">
                                    <MudSwitch T="bool" Value="pref?.Enabled ?? false" ValueChanged="v => Toggle(key, c, v)" Color="@(pref?.Locked == true ? Color.Success : Color.Primary)"
                                               ReadOnly="@(pref?.Locked == true)" Disabled="@(pref is null)"
                                               aria-label="@($"{L[NotificationText.EventLabelKey(key)]} – {L[$"Channel_{c}"]}")"
                                               data-testid="@($"pref-{key}-{c}")" />
                                    @if (pref?.Locked == true)
                                    {
                                        <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" Class="lms-muted" aria-hidden="true" />
                                    }
                                </span>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </SectionCard>
    <div class="lms-prefs-footer">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                   StartIcon="@(_saving ? null : Icons.Material.Rounded.Check)" data-testid="prefs-save">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" aria-hidden="true" />
            }
            @L["Common_Save"]
        </MudButton>
    </div>
}

@code {
    private List<NotificationPreferenceDto> _prefs = [];
    private List<string> _events = [];
    private bool _loading = true, _failed, _saving;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _failed = false;
        var (prefs, failed) = await ApiCalls.RunAsync(() => Api.GetPreferencesAsync(), Navigation);
        _failed = failed;
        _prefs = [.. prefs ?? []];
        _events = _prefs.Select(p => p.EventKey).Distinct(StringComparer.Ordinal).ToList();
        _loading = false;
    }

    private NotificationPreferenceDto? Find(string eventKey, string channel) =>
        _prefs.FirstOrDefault(p => p.EventKey == eventKey && p.Channel == channel);

    private void Toggle(string eventKey, string channel, bool on)
    {
        var i = _prefs.FindIndex(p => p.EventKey == eventKey && p.Channel == channel);
        if (i >= 0 && !_prefs[i].Locked) _prefs[i] = _prefs[i] with { Enabled = on };
    }

    private async Task SaveAsync()
    {
        _saving = true; _error = null;
        var saved = await ApiCalls.RunAsync(() => Api.SavePreferencesAsync(new SetNotificationPreferencesRequest(_prefs)),
            Navigation, L, m => _error = m);
        _saving = false;
        if (saved) Snackbar.Add(L["Common_Saved"], Severity.Success);
    }
}
