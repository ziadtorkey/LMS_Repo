@page "/notifications"
@attribute [Authorize]
@using System.Globalization
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Notifications
@inject INotificationsApi Api
@inject INotificationFeed Feed
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@L["Notif_Title"]</PageTitle>

<PageHeader Title="@L["Notif_Title"]" Subtitle="@L["Notif_Subtitle"]">
    <Actions>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Tune" Href="notifications/preferences"
                   data-testid="notif-prefs-link">@L["Notif_Preferences"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.DoneAll" OnClick="MarkAllAsync"
                   data-testid="notif-mark-all">@L["Notif_MarkAllRead"]</MudButton>
    </Actions>
</PageHeader>

<SectionCard Flush="true">
    <div class="lms-filters lms-filters-inline">
        <MudSwitch T="bool" Value="_unreadOnly" ValueChanged="UnreadOnlyChangedAsync" Color="Color.Primary"
                   Label="@L["Notif_UnreadOnly"]" data-testid="notif-only-unread" />
    </div>

    <ServerTable T="NotificationDto" @ref="_table" ServerData="LoadPageAsync" EmptyTitle="@L["Notif_EmptyTitle"]"
                 EmptyText="@(_unreadOnly ? L["Notif_EmptyUnreadText"].Value : null)" EmptyIcon="@Icons.Material.Rounded.NotificationsNone">
        <HeaderContent>
            <MudTh>@L["Notif_Message"]</MudTh>
            <MudTh>@L["Audit_When"]</MudTh>
            <MudTh>@L["Common_Status"]</MudTh>
        </HeaderContent>
        <RowTemplate Context="n">
            <MudTd DataLabel="@L["Notif_Message"]">
                <span class="lms-notif-cell @(n.IsRead ? null : "lms-notif-cell-unread")">
                    @if (!n.IsRead)
                    {
                        <span class="lms-unread-dot" aria-hidden="true"></span>
                    }
                    <MudLink Typo="Typo.body2" OnClick="() => OpenAsync(n)" data-testid="@($"notif-row-{n.Id}")">
                        @NotificationText.Format(n, L, CultureInfo.CurrentUICulture)
                    </MudLink>
                </span>
            </MudTd>
            <MudTd DataLabel="@L["Audit_When"]"><span dir="ltr" class="lms-muted lms-date-cell">@n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></MudTd>
            <MudTd DataLabel="@L["Common_Status"]">
                @if (!n.IsRead)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="lms-status-chip"
                             data-testid="@($"notif-unread-{n.Id}")">@L["Notif_Unread"]</MudChip>
                }
            </MudTd>
        </RowTemplate>
    </ServerTable>
</SectionCard>

@code {
    private ServerTable<NotificationDto>? _table;
    private bool _unreadOnly;

    private async Task<TableData<NotificationDto>> LoadPageAsync(TableState state, CancellationToken ct)
    {
        var page = await Api.GetPageAsync(_unreadOnly, state.Page + 1, state.PageSize, ct);
        return new TableData<NotificationDto> { Items = page.Items, TotalItems = page.Total };
    }

    private async Task ReloadAsync()
    {
        if (_table is not null) await _table.ReloadAsync();
        await Feed.RefreshAsync();
    }

    private async Task UnreadOnlyChangedAsync(bool on) { _unreadOnly = on; await ReloadAsync(); }

    private async Task MarkAllAsync()
    {
        if (await ApiCalls.RunAsync(() => Api.MarkAllReadAsync(), Navigation, L, m => Snackbar.Add(m, Severity.Error)))
            await ReloadAsync();
    }

    private async Task OpenAsync(NotificationDto n)
    {
        if (!n.IsRead)
        {
            if (!await ApiCalls.RunAsync(() => Api.MarkReadAsync(n.Id), Navigation, L, m => Snackbar.Add(m, Severity.Error))) return;
            await ReloadAsync();
        }
        if (!string.IsNullOrEmpty(n.DeepLink)) Navigation.NavigateTo(n.DeepLink.TrimStart('/'));
    }
}
