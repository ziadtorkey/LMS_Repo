@page "/quizzes/{Id:guid}/builder"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Components.Content
@using Lms.Client.Services.Api
@using Lms.Shared
@using Lms.Shared.Authorization
@using Lms.Shared.Quizzes
@inject IQuizzesApi Api
@inject IClassCourseGroupsApi GroupsApi
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["Quiz_BuilderTitle"]</PageTitle>
<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigationAsync" ConfirmExternalNavigation="Dirty" />
@if (!PermState.Loaded || _loading)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Quizzes.Manage))
{
    <MudAlert Severity="Severity.Warning" data-testid="quiz-forbidden">@L["Forbidden_Title"]</MudAlert>
}
else if (_quiz is null)
{
    <MudAlert Severity="Severity.Error" data-testid="quiz-error">@(_error ?? L["Api_Error"].Value)</MudAlert>
}
else
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" data-testid="quiz-heading">@Culture.Pick(_quiz.Module.TitleAr, _quiz.Module.TitleEn)</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="quiz-total">@L["Quiz_Total", _questions.Count, TotalPoints.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)]</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (Dirty)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" data-testid="quiz-unsaved">@L["Quiz_Unsaved"]</MudChip>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving" data-testid="quiz-save">@L["Common_Save"]</MudButton>
        </MudStack>
    </MudStack>

    @if (_quiz.HasAttempts)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3" data-testid="quiz-has-attempts">@L["Quiz_HasAttemptsNote", _quiz.AttemptCount]</MudAlert>
    }
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="quiz-save-error">@_error</MudAlert>
    }

    <MudTabs Elevation="0" Rounded="true" KeepPanelsAlive="true">
        <MudTabPanel Text="@L["Quiz_TabQuestions"]" data-testid="quiz-tab-questions">
            <MudStack Spacing="2" Class="mt-3">
                @for (var i = 0; i < _questions.Count; i++)
                {
                    var index = i;
                    var question = _questions[i];
                    <QuestionEditor @key="question.Key" Question="question" Index="index" Count="_questions.Count" Locked="_quiz.HasAttempts"
                                    Error="@QuestionError(question)" OnMove="d => Move(index, d)" OnRemove="() => Remove(question)" OnChanged="Touched" />
                }
                @if (_questions.Count == 0)
                {
                    <MudText Class="mud-text-secondary" data-testid="quiz-no-questions">@L["Quiz_NoQuestions"]</MudText>
                }
                @if (!_quiz.HasAttempts)
                {
                    <div>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Add" OnClick="AddQuestion" data-testid="quiz-add-question">@L["Quiz_AddQuestion"]</MudButton>
                    </div>
                }
            </MudStack>
        </MudTabPanel>
        <MudTabPanel Text="@L["Quiz_TabSettings"]" data-testid="quiz-tab-settings">
            <div class="mt-3">
                <QuizSettingsTab Model="_settings" QuestionCount="_questions.Count" Locked="_quiz.HasAttempts" Groups="_groups" Errors="_errors" OnChanged="Touched" />
            </div>
        </MudTabPanel>
        <MudTabPanel Text="@L["Quiz_TabPreview"]" data-testid="quiz-tab-preview">
            <div class="mt-3">
                <QuizPreview QuizId="Id" Dirty="Dirty" Version="_previewVersion" />
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private QuizDto? _quiz;
    private QuizSettingsModel _settings = new();
    private List<QuestionDraft> _questions = [];
    private IReadOnlyList<ModuleGroupOption> _groups = [];
    private Dictionary<string, string> _errors = [];
    private Dictionary<Guid, string> _questionErrors = [];
    private string _savedSignature = "";
    private string? _error;
    private bool _loading = true, _saving;
    private int _previewVersion;

    private decimal TotalPoints => _questions.Sum(q => q.Points);
    private string CurrentSignature() => _settings.Signature() + "|" + string.Join("|", _questions.Select(q => q.Signature()));
    private bool Dirty => _quiz is not null && CurrentSignature() != _savedSignature;

    protected override async Task OnParametersSetAsync()
    {
        PermState.Changed -= OnPermissionsChanged;
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        _loading = true; _error = null; _quiz = null;
        if (PermState.Has(Permissions.Quizzes.Manage)) await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        await ApiCalls.RunAsync(async () => Apply(await Api.GetAsync(Id)), Navigation, L, m => _error = m);
        if (_quiz is not null) _groups = await ModuleGroups.LoadAsync(GroupsApi, _quiz.ClassCourseId);
    }

    private void Apply(QuizDto quiz)
    {
        _quiz = quiz;
        _settings = QuizSettingsModel.From(quiz);
        _questions = quiz.Questions.OrderBy(q => q.Order).Select(QuestionDraft.From).ToList();
        _errors = []; _questionErrors = [];
        _savedSignature = CurrentSignature();
        _previewVersion++;
    }

    private string? QuestionError(QuestionDraft q) => _questionErrors.TryGetValue(q.Key, out var key) ? L[key].Value : null;

    private void Touched() => StateHasChanged();

    private void AddQuestion() => _questions.Add(QuestionDraft.New());

    private void Remove(QuestionDraft q) => _questions.Remove(q);

    private void Move(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _questions.Count) return;
        (_questions[index], _questions[target]) = (_questions[target], _questions[index]);
    }

    private bool ValidateAll()
    {
        _errors = _settings.Validate(_questions.Count);
        _questionErrors = [];
        foreach (var q in _questions)
            if (QuestionRules.Validate(q) is { } key) _questionErrors[q.Key] = key;
        return _errors.Count == 0 && _questionErrors.Count == 0;
    }

    // Order matters: deletions, then edits, then additions, then the order, and the settings last (the pool is checked against
    // the final number of questions). The page reloads from the server afterwards.
    private async Task SaveAsync()
    {
        if (_quiz is null) return;
        _error = null;
        if (!ValidateAll()) return;
        _saving = true;
        var saved = false;
        try
        {
            var existing = _quiz.Questions.ToDictionary(q => q.Id);
            var keep = _questions.Where(q => q.Id is not null).Select(q => q.Id!.Value).ToHashSet();
            foreach (var gone in existing.Keys.Where(id => !keep.Contains(id))) await Api.DeleteQuestionAsync(gone);
            foreach (var q in _questions.Where(q => q.Id is not null && existing.ContainsKey(q.Id.Value)))
                if (QuestionDraft.From(existing[q.Id!.Value]).Signature() != q.Signature()) await Api.UpdateQuestionAsync(q.Id!.Value, q.ToInput());
            foreach (var q in _questions.Where(q => q.Id is null)) q.Id = (await Api.AddQuestionAsync(Id, q.ToInput())).Id;
            if (!_quiz.HasAttempts && _questions.Count > 1) await Api.ReorderQuestionsAsync(Id, _questions.Select(q => q.Id!.Value).ToList());
            await Api.UpdateAsync(Id, new UpdateQuizRequest(_settings.ToModuleSettings(), Blank(_settings.DescriptionAr), Blank(_settings.DescriptionEn), _settings.ToSettings()));
            Apply(await Api.GetAsync(Id));
            saved = true;
            Snackbar.Add(L["Common_Saved"], Severity.Success);
        }
        catch (Exception ex) when (ApiCalls.TryRedirect(ex, Navigation))
        {
        }
        catch (ApiProblemException ex) when (ex.Code == ProblemCodes.pool_draw_invalid)
        {
            _errors["draw"] = "Quiz_Err_Draw";
        }
        catch (ApiProblemException ex) when (ex.Code == ProblemCodes.quiz_has_attempts)
        {
            // someone started an attempt meanwhile: show the lock and keep the teacher's edits
            _error = L["Error_quiz_has_attempts"];
        }
        catch (ApiProblemException ex)
        {
            _error = ProblemText.For(ex, L);
        }
        catch (HttpRequestException)
        {
            _error = L["Error_Generic"];
        }
        finally
        {
            // a save that stopped half way: take the server's question ids again, so a retry does not act on stale ones
            if (!saved) await ResyncAsync();
            _saving = false;
        }
    }

    // Keeps the teacher's edits, replaces the known server state. A draft whose question is gone on the server is saved again as new.
    private async Task ResyncAsync()
    {
        try
        {
            var fresh = await Api.GetAsync(Id);
            var ids = fresh.Questions.Select(q => q.Id).ToHashSet();
            foreach (var q in _questions.Where(q => q.Id is { } id && !ids.Contains(id))) q.Id = null;
            _quiz = fresh;
        }
        catch (Exception ex) when (ex is ApiProblemException or HttpRequestException)
        {
        }
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private async Task OnBeforeNavigationAsync(LocationChangingContext context)
    {
        if (!Dirty) return;
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Quiz_UnsavedTitle"], L["Quiz_UnsavedMessage"], L["Quiz_Leave"]))
            context.PreventNavigation();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
