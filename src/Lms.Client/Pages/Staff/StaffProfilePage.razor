@page "/staff/{Id:guid}"
@attribute [Authorize]
@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Client.Components
@using Lms.Shared.Authorization
@using Lms.Shared.People
@inject IStaffApi Api
@inject ILmsApi Me
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["Staff_Title"]</PageTitle>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" data-testid="profile-error">@_error</MudAlert>
}
else if (_detail is null)
{
    <MudText>@L["Common_Loading"]</MudText>
}
else
{
    var s = _detail.Summary;
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudAvatar Size="Size.Large"><MudIcon Icon="@Icons.Material.Filled.Person" /></MudAvatar>
            <div>
                <MudText Typo="Typo.h4" data-testid="profile-name">@Culture.Pick(s.NameAr, s.NameEn)</MudText>
                <MudText Typo="Typo.body2">@Culture.Pick(s.JobTitleAr ?? "", s.JobTitleEn ?? "")</MudText>
            </div>
            <PersonStatusChip Status="@s.Status" />
            @if (!_detail.IsActivated)
            {
                <MudChip T="string" Size="Size.Small" data-testid="profile-not-activated">@L["Staff_NotActivated"]</MudChip>
            }
        </MudStack>

        @if (_detail.IsLimitedView)
        {
            <MudAlert Severity="Severity.Info" data-testid="profile-limited">@L["Staff_LimitedView"]</MudAlert>
        }

        @if (!_detail.IsLimitedView)
        {
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" data-testid="profile-actions">
                @if (PermState.Has(Permissions.Staff.Update))
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync"
                               data-testid="action-edit">@L["Staff_Edit"]</MudButton>
                }
                @if (PermState.Has(Permissions.Staff.Update) && !_isOwn)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ChangeStatusAsync"
                               data-testid="action-status">@(s.Status == PersonStatuses.Active ? L["Staff_Deactivate"] : L["Staff_Reactivate"])</MudButton>
                }
                @if (PermState.Has(Permissions.Staff.Update) && !_detail.IsActivated)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="ResendAsync" data-testid="action-resend">@L["Staff_ResendInvitation"]</MudButton>
                }
                @if (PermState.Has(Permissions.Assignments.Create))
                {
                    <MudButton Variant="Variant.Outlined" OnClick="ShareAsync" data-testid="action-share">@L["Staff_Share"]</MudButton>
                }
                @if (PermState.Has(Permissions.Staff.Delete) && !_isOwn)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync"
                               data-testid="action-delete">@L["Common_Delete"]</MudButton>
                }
            </MudStack>
        }

        <MudPaper Class="pa-3">
            <MudStack Spacing="1">
                <MudText data-testid="profile-email">@L["Staff_Email"]: <span dir="ltr">@s.Email</span></MudText>
                @if (!_detail.IsLimitedView)
                {
                    <MudText data-testid="profile-mobile">@L["Staff_Mobile"]: <span dir="ltr">@s.Mobile</span></MudText>
                    <MudText data-testid="profile-national-id">@L["Staff_NationalId"]: <span dir="ltr">@_detail.NationalId</span></MudText>
                }
                <MudText>@L["Staff_HomeUnit"]: @Culture.Pick(s.HomeOrgUnitNameAr, s.HomeOrgUnitNameEn)</MudText>
                @if (s.ExpiresOn is { } expires)
                {
                    <MudText data-testid="profile-expires">@L["Staff_ExpiresOn"]: @expires.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</MudText>
                }
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.h6">@L["Staff_Roles"]</MudText>
        <MudTable Items="s.Roles" Dense="true" Hover="true" Class="lms-staff-roles" data-testid="profile-roles">
            <HeaderContent>
                <MudTh>@L["Staff_Role"]</MudTh>
                <MudTh>@L["Staff_RoleUnit"]</MudTh>
                <MudTh>@L["Staff_ValidFrom"]</MudTh>
                <MudTh>@L["Staff_ValidTo"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="role">
                <MudTd>
                    @Culture.Pick(role.RoleNameAr, role.RoleNameEn)
                    @if (role.IsShare)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["Staff_Shared"]</MudChip>
                    }
                </MudTd>
                <MudTd>@Culture.Pick(role.OrgUnitNameAr, role.OrgUnitNameEn)</MudTd>
                <MudTd>@role.ValidFrom?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                <MudTd>@role.ValidTo?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                <MudTd>
                    @if (role.IsShare && PermState.Has(Permissions.Assignments.Delete))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveShareAsync(role)"
                                   data-testid="@($"remove-share-{role.AssignmentId}")">@L["Staff_RemoveShare"]</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (!_detail.IsLimitedView)
        {
            <MudText Typo="Typo.h6">@L["Staff_StatusHistory"]</MudText>
            <MudTable Items="_detail.StatusHistory" Dense="true" data-testid="profile-history">
                <HeaderContent>
                    <MudTh>@L["Common_Status"]</MudTh>
                    <MudTh>@L["Staff_Reason"]</MudTh>
                    <MudTh>@L["Audit_When"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="change">
                    <MudTd>@L[$"PersonStatus_{change.FromStatus}"] → @L[$"PersonStatus_{change.ToStatus}"]</MudTd>
                    <MudTd>@change.Reason</MudTd>
                    <MudTd>@change.ChangedAt.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
}

@code {
    private StaffDetailDto? _detail;
    private string? _error;
    private bool _isOwn;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _detail = null;
        _error = null;
        await ApiCalls.RunAsync(async () =>
        {
            _detail = await Api.GetAsync(Id);
            _isOwn = (await Me.GetMeAsync()).UserId == _detail.Summary.UserId;
        }, Navigation, L, message => _error = message);
    }

    /// <summary>Runs a write; on success shows the message and reloads, on failure shows the problem as a snackbar.</summary>
    private async Task RunAsync(Func<Task> write, string done)
    {
        var ok = await ApiCalls.RunAsync(write, Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (!ok) return;
        Snackbar.Add(done, Severity.Success);
        await LoadAsync();
    }

    private string DisplayName => _detail is null ? "" : Culture.Pick(_detail.Summary.NameAr, _detail.Summary.NameEn);

    private async Task EditAsync()
    {
        var dialog = await Dialogs.ShowAsync<EditStaffDialog>(L["Staff_Edit"], new DialogParameters<EditStaffDialog> { { x => x.Person, _detail! } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(L["Common_Saved"], Severity.Success); await LoadAsync(); }
    }

    private async Task ChangeStatusAsync()
    {
        var reactivate = _detail!.Summary.Status != PersonStatuses.Active;
        var dialog = await Dialogs.ShowAsync<PersonStatusDialog>(L[reactivate ? "Staff_Reactivate" : "Staff_Deactivate"],
            new DialogParameters<PersonStatusDialog> { { x => x.Name, DisplayName }, { x => x.Reactivate, reactivate } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: string reason })
            await RunAsync(() => Api.SetStatusAsync(Id, new SetPersonStatusRequest(reactivate ? PersonStatuses.Active : PersonStatuses.Deactivated, reason)),
                L["Common_Saved"]);
    }

    private Task ResendAsync() => RunAsync(() => Api.ResendInvitationAsync(Id), L["Staff_InvitationSent"]);

    private async Task ShareAsync()
    {
        var dialog = await Dialogs.ShowAsync<ShareStaffDialog>(L["Staff_Share"], new DialogParameters<ShareStaffDialog> { { x => x.StaffId, Id } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(L["Common_Saved"], Severity.Success); await LoadAsync(); }
    }

    private Task RemoveShareAsync(StaffRoleDto role) =>
        RunAsync(() => Api.RemoveShareAsync(Id, role.AssignmentId), L["Common_Saved"]);

    private async Task DeleteAsync()
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], L["Staff_DeleteConfirm"], L["Common_Delete"])) return;
        var ok = await ApiCalls.RunAsync(() => Api.DeleteAsync(Id), Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (ok) Navigation.NavigateTo("staff");
    }
}
