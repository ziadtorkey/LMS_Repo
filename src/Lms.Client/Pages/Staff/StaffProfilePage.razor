@page "/staff/{Id:guid}"
@attribute [Authorize]
@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Client.Components
@using Lms.Shared.Authorization
@using Lms.Shared.People
@inject IStaffApi Api
@inject ILmsApi Me
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["Staff_Title"]</PageTitle>
<MudLink Href="staff" Typo="Typo.body2" Class="lms-back-link" data-testid="profile-back">
    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
    @L["Staff_BackToList"]
</MudLink>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="profile-error">@_error</MudAlert>
}
else if (_detail is null)
{
    <LoadingState Lines="5" TestId="profile-loading" />
}
else
{
    var s = _detail.Summary;
    var name = Culture.Pick(s.NameAr, s.NameEn);
    <PageHeader Title="@name" Subtitle="@Culture.Pick(s.JobTitleAr ?? "", s.JobTitleEn ?? "")" TitleTestId="profile-name"
                Class="lms-profile-header">
        <Leading>
            <StaffAvatar PhotoFileId="s.PhotoFileId" Name="@name" Size="Size.Large" />
        </Leading>
        <Badges>
            <PersonStatusChip Status="@s.Status" />
            @if (!_detail.IsActivated)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Rounded.MarkEmailUnread"
                         data-testid="profile-not-activated">@L["Staff_NotActivated"]</MudChip>
            }
        </Badges>
        <Actions>
            @if (!_detail.IsLimitedView)
            {
                <div class="lms-action-bar" data-testid="profile-actions">
                    @if (PermState.Has(Permissions.Staff.Update))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Edit" OnClick="EditAsync"
                                   data-testid="action-edit">@L["Staff_Edit"]</MudButton>
                    }
                    @if (PermState.Has(Permissions.Staff.Update) && PermState.Has(Permissions.Assignments.Create))
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Share" OnClick="ShareAsync"
                                   data-testid="action-share">@L["Staff_Share"]</MudButton>
                    }
                    @if (PermState.Has(Permissions.Staff.Update) && !_detail.IsActivated)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Send" OnClick="ResendAsync"
                                   data-testid="action-resend">@L["Staff_ResendInvitation"]</MudButton>
                    }
                    @if (PermState.Has(Permissions.Staff.Update) && !_isOwn)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="ChangeStatusAsync"
                                   StartIcon="@(s.Status == PersonStatuses.Active ? Icons.Material.Rounded.PersonOff : Icons.Material.Rounded.HowToReg)"
                                   data-testid="action-status">@(s.Status == PersonStatuses.Active ? L["Staff_Deactivate"] : L["Staff_Reactivate"])</MudButton>
                    }
                    @if (PermState.Has(Permissions.Staff.Delete) && !_isOwn)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Rounded.DeleteOutline" OnClick="DeleteAsync"
                                   data-testid="action-delete">@L["Common_Delete"]</MudButton>
                    }
                </div>
            }
        </Actions>
    </PageHeader>

    @if (_detail.IsLimitedView)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" data-testid="profile-limited">@L["Staff_LimitedView"]</MudAlert>
    }

    <div class="lms-profile-grid">
        <SectionCard Title="@L["Staff_Details"]" Class="lms-profile-details">
            <dl class="lms-details">
                <DetailItem Label="@L["Staff_Email"]" Value="@s.Email" Ltr="true" TestId="profile-email" />
                @if (!_detail.IsLimitedView)
                {
                    <DetailItem Label="@L["Staff_Mobile"]" Value="@s.Mobile" Ltr="true" TestId="profile-mobile" />
                    <DetailItem Label="@L["Staff_NationalId"]" Value="@_detail.NationalId" Ltr="true" TestId="profile-national-id" />
                }
                <DetailItem Label="@L["Staff_HomeUnit"]" Value="@Culture.Pick(s.HomeOrgUnitNameAr, s.HomeOrgUnitNameEn)" />
                @if (s.ExpiresOn is { } expires)
                {
                    <DetailItem Label="@L["Staff_ExpiresOn"]" Value="@expires.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                                Ltr="true" TestId="profile-expires" />
                }
            </dl>
        </SectionCard>

        <div class="lms-profile-main">
            <SectionCard Title="@L["Staff_Roles"]" Flush="true">
                <MudTable Items="s.Roles" Dense="true" Hover="true" Elevation="0" HeaderClass="lms-table-head"
                          Class="lms-staff-roles lms-table" data-testid="profile-roles">
                    <HeaderContent>
                        <MudTh>@L["Staff_Role"]</MudTh>
                        <MudTh>@L["Staff_RoleUnit"]</MudTh>
                        <MudTh>@L["Staff_ValidFrom"]</MudTh>
                        <MudTh>@L["Staff_ValidTo"]</MudTh>
                        <MudTh><span class="lms-visually-hidden">@L["Common_Actions"]</span></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="role">
                        <MudTd DataLabel="@L["Staff_Role"]">
                            <span class="lms-cell-strong">@Culture.Pick(role.RoleNameAr, role.RoleNameEn)</span>
                            @if (role.IsShare)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                                         Icon="@Icons.Material.Rounded.Share">@L["Staff_Shared"]</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Staff_RoleUnit"]">@Culture.Pick(role.OrgUnitNameAr, role.OrgUnitNameEn)</MudTd>
                        <MudTd DataLabel="@L["Staff_ValidFrom"]"><span dir="ltr">@(role.ValidFrom?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span></MudTd>
                        <MudTd DataLabel="@L["Staff_ValidTo"]"><span dir="ltr">@(role.ValidTo?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span></MudTd>
                        <MudTd Class="lms-cell-actions">
                            @if (role.IsShare && PermState.Has(Permissions.Assignments.Delete))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveShareAsync(role)"
                                           data-testid="@($"remove-share-{role.AssignmentId}")">@L["Staff_RemoveShare"]</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <EmptyState Title="@L["Staff_NoRoles"]" Icon="@Icons.Material.Rounded.WorkOutline" />
                    </NoRecordsContent>
                </MudTable>
            </SectionCard>

            @if (!_detail.IsLimitedView)
            {
                <SectionCard Title="@L["Staff_StatusHistory"]" Flush="true">
                    <MudTable Items="_detail.StatusHistory" Dense="true" Elevation="0" HeaderClass="lms-table-head" Class="lms-table"
                              data-testid="profile-history">
                        <HeaderContent>
                            <MudTh>@L["Common_Status"]</MudTh>
                            <MudTh>@L["Staff_Reason"]</MudTh>
                            <MudTh>@L["Audit_When"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="change">
                            <MudTd DataLabel="@L["Common_Status"]">
                                <span class="lms-status-change">
                                    @L[$"PersonStatus_{change.FromStatus}"]
                                    <MudIcon Icon="@(Culture.IsRightToLeft ? Icons.Material.Filled.ArrowBack : Icons.Material.Filled.ArrowForward)" Size="Size.Small"
                                             Class="lms-muted" data-testid="history-arrow" />
                                    <span class="lms-cell-strong">@L[$"PersonStatus_{change.ToStatus}"]</span>
                                </span>
                            </MudTd>
                            <MudTd DataLabel="@L["Staff_Reason"]">@change.Reason</MudTd>
                            <MudTd DataLabel="@L["Audit_When"]"><span dir="ltr" class="lms-muted">@change.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <EmptyState Title="@L["Staff_NoHistory"]" Icon="@Icons.Material.Rounded.History" />
                        </NoRecordsContent>
                    </MudTable>
                </SectionCard>
            }
        </div>
    </div>
}

@code {
    private StaffDetailDto? _detail;
    private string? _error;
    private bool _isOwn;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _detail = null;
        _error = null;
        await ApiCalls.RunAsync(async () =>
        {
            _detail = await Api.GetAsync(Id);
            _isOwn = (await Me.GetMeAsync()).UserId == _detail.Summary.UserId;
        }, Navigation, L, message => _error = message);
    }

    /// <summary>Runs a write; on success shows the message and reloads, on failure shows the problem as a snackbar.</summary>
    private async Task RunAsync(Func<Task> write, string done)
    {
        var ok = await ApiCalls.RunAsync(write, Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (!ok) return;
        Snackbar.Add(done, Severity.Success);
        await LoadAsync();
    }

    private string DisplayName => _detail is null ? "" : Culture.Pick(_detail.Summary.NameAr, _detail.Summary.NameEn);

    private async Task EditAsync()
    {
        var dialog = await Dialogs.ShowAsync<EditStaffDialog>(L["Staff_Edit"], new DialogParameters<EditStaffDialog> { { x => x.Person, _detail! } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(L["Common_Saved"], Severity.Success); await LoadAsync(); }
    }

    private async Task ChangeStatusAsync()
    {
        var reactivate = _detail!.Summary.Status != PersonStatuses.Active;
        var dialog = await Dialogs.ShowAsync<PersonStatusDialog>(L[reactivate ? "Staff_Reactivate" : "Staff_Deactivate"],
            new DialogParameters<PersonStatusDialog> { { x => x.Name, DisplayName }, { x => x.Reactivate, reactivate } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: string reason })
            await RunAsync(() => Api.SetStatusAsync(Id, new SetPersonStatusRequest(reactivate ? PersonStatuses.Active : PersonStatuses.Deactivated, reason)),
                L["Common_Saved"]);
    }

    private Task ResendAsync() => RunAsync(() => Api.ResendInvitationAsync(Id), L["Staff_InvitationSent"]);

    private async Task ShareAsync()
    {
        var dialog = await Dialogs.ShowAsync<ShareStaffDialog>(L["Staff_Share"], new DialogParameters<ShareStaffDialog> { { x => x.StaffId, Id } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(L["Common_Saved"], Severity.Success); await LoadAsync(); }
    }

    private Task RemoveShareAsync(StaffRoleDto role) =>
        RunAsync(() => Api.RemoveShareAsync(Id, role.AssignmentId), L["Common_Saved"]);

    private async Task DeleteAsync()
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], L["Staff_DeleteConfirm"], L["Common_Delete"])) return;
        var ok = await ApiCalls.RunAsync(() => Api.DeleteAsync(Id), Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (ok) Navigation.NavigateTo("staff");
    }
}
