@page "/courses/import"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Components.Imports
@using Lms.Shared.Authorization
@using Lms.Shared.Imports
@inject PermissionState PermState
@implements IDisposable

<PageTitle>@L["CourseImport_Title"]</PageTitle>
<MudLink Href="courses" Typo="Typo.body2" Class="lms-back-link" data-testid="course-import-back">
    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
    @L["Course_BackToList"]
</MudLink>
@if (!PermState.Loaded)
{
    <LoadingState Lines="3" TestId="course-import-loading" />
}
else if (!PermState.Has(Permissions.Courses.Import))
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="course-import-forbidden">@L["Forbidden_Title"]</MudAlert>
}
else
{
    <PageHeader Title="@L["CourseImport_Title"]" Subtitle="@L["CourseImport_Subtitle"]" TitleTestId="course-import-title" />
    <ImportWizard Kind="@ImportKinds.Courses" TitleKey="CourseImport_Title" ShowTitle="false" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
