@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Access
@using Lms.Shared.Authorization
@inject IAccessAdminApi Api
@inject NavigationManager Navigation

@* Create or edit one role. The base kind of an existing role (built-in or custom) is never editable. *@
<MudPaper Class="pa-4" data-testid="role-editor">
    <MudStack Spacing="3">
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" data-testid="role-error">@_error</MudAlert>
        }

        <BilingualNameFields @bind-NameAr="_nameAr" @bind-NameEn="_nameEn" />

        @if (Role is null)
        {
            <MudSelect T="string" @bind-Value="_baseKind" Label="@L["Roles_BaseKind"]" data-testid="role-basekind">
                @foreach (var kind in new[] { RoleBaseKinds.Staff, RoleBaseKinds.Student, RoleBaseKinds.Guardian })
                {
                    <MudSelectItem Value="@kind">@L[$"BaseKind_{kind}"]</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudText data-testid="role-basekind-fixed">@L["Roles_BaseKind"]: @L[$"BaseKind_{Role.BaseKind}"]</MudText>
        }

        <MudText Typo="Typo.h6">@L["Roles_Permissions"]</MudText>
        <PermissionMatrix Groups="Groups" Selected="_selected" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton OnClick="OnCancel" data-testid="role-cancel">@L["Common_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                       data-testid="role-save">@L["Common_Save"]</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    private string _nameAr = "", _nameEn = "", _baseKind = RoleBaseKinds.Staff;
    private HashSet<string> _selected = [];
    private string? _error;
    private bool _saving;

    /// <summary>The role being edited; null creates a new custom role.</summary>
    [Parameter] public RoleDto? Role { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<PermissionGroupDto> Groups { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        if (Role is null) return;
        _nameAr = Role.NameAr; _nameEn = Role.NameEn; _baseKind = Role.BaseKind;
        _selected = [.. Role.Permissions];
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_nameAr) || string.IsNullOrWhiteSpace(_nameEn))
        {
            _error = L["Common_Required"];
            return;
        }
        _saving = true; _error = null;
        var permissions = _selected.OrderBy(p => p, StringComparer.Ordinal).ToArray();
        var saved = await ActionCalls.TryAsync(
            () => Role is null
                ? Api.CreateRoleAsync(new CreateRoleRequest(_nameAr, _nameEn, _baseKind, permissions))
                : Api.UpdateRoleAsync(Role.Id, new UpdateRoleRequest(_nameAr, _nameEn, permissions)),
            Navigation, L, message => _error = message);
        _saving = false;
        if (saved) await OnSaved.InvokeAsync();
    }
}
