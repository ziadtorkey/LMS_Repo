@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Access
@using Lms.Shared.Authorization
@inject IAccessAdminApi Api
@inject NavigationManager Navigation

@* Create or edit one role. The base kind of an existing role (built-in or custom) is never editable. *@
<div class="lms-role-editor" data-testid="role-editor">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-testid="role-error">@_error</MudAlert>
    }

    @* Summary tiles (Stitch roles_permissions_matrix screen, issue 565): counted from the current selection. *@
    <div class="lms-stats" role="list" aria-label="@L["Roles_Summary"]" data-testid="role-stats">
        <div class="lms-stat" role="listitem" data-testid="role-stat-granted">
            <div><div class="lms-stat-label">@L["Roles_StatGranted"]</div><div class="lms-stat-value"><span dir="ltr">@_selected.Count / @Total</span></div></div>
            <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.VerifiedUser" /></span>
        </div>
        <div class="lms-stat" role="listitem" data-testid="role-stat-modules">
            <div><div class="lms-stat-label">@L["Roles_StatModules"]</div><div class="lms-stat-value">@FullModules</div></div>
            <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.Widgets" /></span>
        </div>
        <div class="lms-stat" role="listitem" data-testid="role-stat-kind">
            <div><div class="lms-stat-label">@L["Roles_BaseKind"]</div><div class="lms-stat-value lms-stat-value-text">@L[$"BaseKind_{(Role?.BaseKind ?? _baseKind)}"]</div></div>
            <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.Badge" /></span>
        </div>
    </div>

    <SectionCard Title="@(Role is null ? L["Roles_New"] : L["Roles_EditTitle"])">
        <BilingualNameFields @bind-NameAr="_nameAr" @bind-NameEn="_nameEn" />
        <div class="mt-2">
            @if (Role is null)
            {
                <MudSelect T="string" @bind-Value="_baseKind" Label="@L["Roles_BaseKind"]" HelperText="@L["Roles_BaseKindHelp"]" data-testid="role-basekind">
                    @foreach (var kind in new[] { RoleBaseKinds.Staff, RoleBaseKinds.Student, RoleBaseKinds.Guardian })
                    {
                        <MudSelectItem Value="@kind">@L[$"BaseKind_{kind}"]</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <dl class="lms-details">
                    <DetailItem Label="@L["Roles_BaseKind"]" TestId="role-basekind-fixed">
                        @L[$"BaseKind_{Role.BaseKind}"]
                    </DetailItem>
                </dl>
            }
        </div>
    </SectionCard>

    <SectionCard Title="@L["Roles_Permissions"]">
        <PermissionMatrix Groups="Groups" Selected="_selected" SelectedChanged="_ => StateHasChanged()" />
    </SectionCard>

    <div class="lms-save-bar" data-testid="role-save-bar">
        <span class="lms-save-bar-text lms-save-bar-info">@L["Roles_GrantedCount", _selected.Count, Total]</span>
        <MudButton Variant="Variant.Text" OnClick="OnCancel" data-testid="role-cancel">@L["Common_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                   StartIcon="@(_saving ? null : Icons.Material.Rounded.Check)" data-testid="role-save">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" aria-hidden="true" />
            }
            @L["Common_Save"]
        </MudButton>
    </div>
</div>

@code {
    private string _nameAr = "", _nameEn = "", _baseKind = RoleBaseKinds.Staff;
    private HashSet<string> _selected = [];
    private string? _error;
    private bool _saving;

    /// <summary>The role being edited; null creates a new custom role.</summary>
    [Parameter] public RoleDto? Role { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<PermissionGroupDto> Groups { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private int Total => Groups.Sum(g => g.Permissions.Count);
    private int FullModules => Groups.Count(g => g.Permissions.Count > 0 && g.Permissions.All(_selected.Contains));

    protected override void OnInitialized()
    {
        if (Role is null) return;
        _nameAr = Role.NameAr; _nameEn = Role.NameEn; _baseKind = Role.BaseKind;
        _selected = [.. Role.Permissions];
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_nameAr) || string.IsNullOrWhiteSpace(_nameEn))
        {
            _error = L["Common_Required"];
            return;
        }
        _saving = true; _error = null;
        var permissions = _selected.OrderBy(p => p, StringComparer.Ordinal).ToArray();
        var saved = await ApiCalls.RunAsync(
            () => Role is null
                ? Api.CreateRoleAsync(new CreateRoleRequest(_nameAr, _nameEn, _baseKind, permissions))
                : Api.UpdateRoleAsync(Role.Id, new UpdateRoleRequest(_nameAr, _nameEn, permissions)),
            Navigation, L, message => _error = message);
        _saving = false;
        if (saved) await OnSaved.InvokeAsync();
    }
}
