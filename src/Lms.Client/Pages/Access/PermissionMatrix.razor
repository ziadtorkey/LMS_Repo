@using Lms.Shared.Access

@* Permissions grouped by module with a "select all" per module. Labels come from Perm_{Module}_{Action}. *@
<MudStack Spacing="3">
    @foreach (var group in Groups)
    {
        var g = group;
        <MudPaper Outlined="true" Class="pa-3" data-testid="@($"module-{g.Module}")">
            <MudCheckBox T="bool" Value="AllSelected(g)" ValueChanged="v => ToggleModuleAsync(g, v)"
                         Label="@L[$"PermModule_{g.Module}"]" Disabled="ReadOnly"
                         Color="Color.Primary" aria-label="@($"{L["Roles_SelectModule"]}: {L[$"PermModule_{g.Module}"]}")" data-testid="@($"select-module-{g.Module}")" />
            <MudDivider Class="mb-2" />
            <MudGrid Spacing="1">
                @foreach (var permission in g.Permissions)
                {
                    var p = permission;
                    <MudItem xs="12" sm="6" md="4">
                        <MudCheckBox T="bool" Value="Selected.Contains(p)" ValueChanged="v => ToggleAsync(p, v)"
                                     Label="@L[PermissionLabelKey(p)]" Disabled="ReadOnly"
                                     Dense="true" data-testid="@($"perm-{p}")" />
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PermissionGroupDto> Groups { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> Selected { get; set; } = [];
    [Parameter] public EventCallback<HashSet<string>> SelectedChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>"OrgUnits.Create" → "Perm_OrgUnits_Create".</summary>
    public static string PermissionLabelKey(string permission) => "Perm_" + permission.Replace('.', '_');

    private bool AllSelected(PermissionGroupDto g) => g.Permissions.All(Selected.Contains);

    private Task ToggleModuleAsync(PermissionGroupDto g, bool on)
    {
        foreach (var p in g.Permissions)
        {
            if (on) Selected.Add(p); else Selected.Remove(p);
        }
        return SelectedChanged.InvokeAsync(Selected);
    }

    private Task ToggleAsync(string permission, bool on)
    {
        if (on) Selected.Add(permission); else Selected.Remove(permission);
        return SelectedChanged.InvokeAsync(Selected);
    }
}
