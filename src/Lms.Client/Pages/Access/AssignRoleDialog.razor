@using Lms.Client.Services.Api
@using Lms.Shared.Access
@using Lms.Client.Pages.Staff
@using Lms.Shared.Authorization
@using Lms.Shared.Organizations
@using Lms.Shared.People
@inject IAccessAdminApi Api
@inject IStaffApi StaffApi
@inject PermissionState PermState
@inject IDialogService Dialogs
@inject NavigationManager Navigation

@* Assign a role by email (new users are invited), or edit the validity of an existing assignment. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" data-testid="assign-error">@_error</MudAlert>
            }

            @if (Existing is null)
            {
                <MudAutocomplete T="StaffSummaryDto" Label="@L["Assign_Person"]" Placeholder="@L["Assign_PersonSearch"]"
                                 Value="_person" ValueChanged="p => _person = p" SearchFunc="SearchStaffAsync"
                                 ToStringFunc="DisplayStaff" DebounceInterval="300" MaxItems="20" Clearable="true"
                                 data-testid="assign-person" />
                @if (PermState.Has(Permissions.Staff.Create))
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CreateStaffAsync"
                               data-testid="assign-create-staff">@L["Assign_CreateStaff"]</MudButton>
                }
                <MudSelect T="Guid" @bind-Value="_roleId" Label="@L["Assignments_Role"]" data-testid="assign-role">
                    @foreach (var role in StaffRoles)
                    {
                        <MudSelectItem Value="@role.Id">@CultureText.Pick(role.NameAr, role.NameEn)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid" @bind-Value="_unitId" Label="@L["Assignments_Unit"]" data-testid="assign-unit">
                    @foreach (var unit in Units)
                    {
                        <MudSelectItem Value="@unit.Id">@(new string(' ', unit.Depth * 3) + CultureText.Pick(unit.NameAr, unit.NameEn))</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText data-testid="assign-existing">
                    @CultureText.Pick(Existing.UserDisplayNameAr, Existing.UserDisplayNameEn) — @CultureText.Pick(Existing.RoleNameAr, Existing.RoleNameEn)
                </MudText>
            }

            <MudDatePicker Date="_validFrom" DateChanged="d => _validFrom = d" Label="@L["Assignments_ValidFrom"]"
                           Clearable="true" data-testid="assign-from" />
            <MudDatePicker Date="_validTo" DateChanged="d => _validTo = d" Label="@L["Assignments_ValidTo"]"
                           Clearable="true" data-testid="assign-to" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" data-testid="assign-cancel">@L["Common_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                   data-testid="assign-save">@L["Common_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private StaffSummaryDto? _person;
    private Guid _roleId, _unitId;
    private DateTime? _validFrom, _validTo;
    private string? _error;
    private bool _saving;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<RoleDto> Roles { get; set; } = [];
    /// <summary>Only Staff-kind roles can be given to staff members.</summary>
    private IEnumerable<RoleDto> StaffRoles => Roles.Where(r => r.BaseKind == RoleBaseKinds.Staff);
    [Parameter] public IReadOnlyList<OrgUnitNodeDto> Units { get; set; } = [];
    [Parameter] public Guid? DefaultUnitId { get; set; }
    /// <summary>When set the dialog only edits the validity dates of this assignment.</summary>
    [Parameter] public AssignmentDto? Existing { get; set; }

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _validFrom = Existing.ValidFrom?.ToDateTime(TimeOnly.MinValue);
            _validTo = Existing.ValidTo?.ToDateTime(TimeOnly.MinValue);
            return;
        }
        _roleId = StaffRoles.FirstOrDefault()?.Id ?? Guid.Empty;
        _unitId = DefaultUnitId ?? Units.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private string DisplayStaff(StaffSummaryDto? person) => person is null ? "" :
        $"{CultureText.Pick(person.NameAr, person.NameEn)} ({person.Email})";

    private async Task<IEnumerable<StaffSummaryDto>> SearchStaffAsync(string? text, CancellationToken ct)
    {
        IEnumerable<StaffSummaryDto> found = [];
        await ApiCalls.RunAsync(async () =>
            found = (await StaffApi.ListAsync(new StaffQuery(null, true, null, PersonStatuses.Active,
                string.IsNullOrWhiteSpace(text) ? null : text.Trim(), true, null, 1, 20), ct)).Items,
            Navigation, L, message => _error = message);
        return found;
    }

    private async Task CreateStaffAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateStaffDialog>(L["Staff_New"], new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: StaffDetailDto created })
            _person = created.Summary;
    }

    /// <summary>True when the validity window is empty-ended or ordered.</summary>
    public static bool DatesValid(DateTime? from, DateTime? to) => from is null || to is null || to >= from;

    private async Task SaveAsync()
    {
        _error = null;
        if (!DatesValid(_validFrom, _validTo))
        {
            _error = L["Assignments_DateOrder"];
            return;
        }
        if (Existing is null && _person is null)
        {
            _error = L["Common_Required"];
            return;
        }

        _saving = true;
        var from = _validFrom is { } f ? DateOnly.FromDateTime(f) : (DateOnly?)null;
        var to = _validTo is { } t ? DateOnly.FromDateTime(t) : (DateOnly?)null;
        var saved = await ApiCalls.RunAsync(
            () => Existing is null
                ? Api.CreateAssignmentAsync(new CreateAssignmentRequest(_person!.Email, null, null, _roleId, _unitId, from, to))
                : Api.UpdateAssignmentAsync(Existing.Id, new UpdateAssignmentRequest(from, to)),
            Navigation, L, message => _error = message);
        _saving = false;
        if (saved) MudDialog.Close(DialogResult.Ok(true));
    }
}
