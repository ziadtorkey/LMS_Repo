@page "/identity-providers"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.IdentityProviders
@implements IDisposable
@inject IIdentityProvidersApi Api
@inject PermissionState Perms
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IServiceProvider Services

<PageTitle>@L["Idp_Title"]</PageTitle>
@if (!Perms.Loaded)
{
    <LoadingState Lines="4" />
}
else if (!Perms.Has(Permissions.IdentityProviders.View))
{
    <Forbidden />
}
else
{
    <PageHeader Title="@L["Idp_Title"]" Subtitle="@L["Idp_Subtitle"]" TitleTestId="idp-title">
        <Actions>
            @if (Perms.Has(Permissions.IdentityProviders.Manage))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add"
                           OnClick="() => OpenAsync(null)" data-testid="idp-new">@L["Idp_New"]</MudButton>
                @if (HasSso)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenSsoAsync" data-testid="idp-new-sso">@L["Sso_New"]</MudButton>
                }
            }
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <LoadingState Lines="4" />
    }
    else if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="api-error">
            <div class="d-flex align-center flex-wrap gap-2">
                <span>@L["Api_Error"]</span>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Refresh"
                           OnClick="LoadAsync">@L["Common_Retry"]</MudButton>
            </div>
        </MudAlert>
    }
    else if (_items.Count == 0)
    {
        <SectionCard>
            <EmptyState Title="@L["Idp_EmptyTitle"]" Text="@L["Idp_EmptyText"]" Icon="@Icons.Material.Rounded.Login" TestId="table-empty" />
        </SectionCard>
    }
    else
    {
        <SectionCard Flush="true">
            <MudTable T="IdentityProviderDto" Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0"
                      HeaderClass="lms-table-head" Class="lms-table">
                <HeaderContent>
                    <MudTh>@L["Common_Name"]</MudTh>
                    <MudTh>@L["Idp_Kind"]</MudTh>
                    <MudTh>@L["Idp_Slug"]</MudTh>
                    <MudTh>@L["Idp_EmailDomains"]</MudTh>
                    <MudTh>@L["Common_Enabled"]</MudTh>
                    <MudTh><span class="lms-visually-hidden">@L["Common_Actions"]</span></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Common_Name"]"><span class="lms-cell-strong">@CultureText.Pick(context.DisplayNameAr, context.DisplayNameEn)</span></MudTd>
                    <MudTd DataLabel="@L["Idp_Kind"]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="lms-role-chip">@L[$"IdpKind_{context.Kind}"]</MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["Idp_Slug"]"><span dir="ltr" class="lms-muted">@context.Slug</span></MudTd>
                    <MudTd DataLabel="@L["Idp_EmailDomains"]">
                        <div class="lms-chip-row">
                            @foreach (var domain in context.EmailDomains)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"><span dir="ltr">@domain</span></MudChip>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="@L["Common_Enabled"]">
                        <MudSwitch T="bool" Value="context.Enabled" ValueChanged="v => ToggleAsync(context, v)" Color="Color.Primary"
                                   Disabled="@(!Perms.Has(Permissions.IdentityProviders.Manage))" aria-label="@L["Common_Enabled"]"
                                   data-testid="@($"idp-enabled-{context.Id}")" />
                    </MudTd>
                    <MudTd Class="lms-cell-actions">
                        @if (Perms.Has(Permissions.IdentityProviders.Manage))
                        {
                            <div class="lms-row-actions">
                                <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" aria-label="@L["Common_Edit"]"
                                               OnClick="() => OpenAsync(context)" data-testid="@($"idp-edit-{context.Id}")" />
                                <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Color="Color.Error" aria-label="@L["Common_Delete"]"
                                               OnClick="() => DeleteAsync(context)" data-testid="@($"idp-delete-{context.Id}")" />
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </SectionCard>
    }
}

@code {
    private IReadOnlyList<IdentityProviderDto> _items = [];
    private bool _loading = true, _failed;

    protected override async Task OnInitializedAsync()
    {
        Perms.Changed += OnPermissionsChanged;
        if (!Perms.Loaded) await Perms.RefreshAsync();
        if (Perms.Has(Permissions.IdentityProviders.View)) await LoadAsync();
        else _loading = false;
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Perms.Changed -= OnPermissionsChanged;

    private async Task LoadAsync()
    {
        _loading = true;
        _failed = false;
        var (items, failed) = await ApiCalls.RunAsync(() => Api.ListAsync(), Navigation);
        _failed = failed;
        _items = items ?? [];
        _loading = false;
    }

    /// <summary>SAML and LDAP are offered only when the SSO client is registered (the contract is not in yet, so a real build does not show them).</summary>
    private bool HasSso => Services.GetService(typeof(Lms.Client.Services.Sso.ISsoProvidersApi)) is not null;

    private async Task OpenSsoAsync()
    {
        var dialog = await Dialogs.ShowAsync<Lms.Client.Components.Sso.SsoProviderDialog>(L["Sso_New"], new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) Snackbar.Add(L["Common_Saved"], Severity.Success);
    }

    private async Task OpenAsync(IdentityProviderDto? existing)
    {
        var parameters = new DialogParameters<IdentityProviderDialog> { { d => d.Existing, existing } };
        var dialog = await Dialogs.ShowAsync<IdentityProviderDialog>(
            existing is null ? L["Idp_New"] : CultureText.Pick(existing.DisplayNameAr, existing.DisplayNameEn), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(L["Common_Saved"], Severity.Success);
            await LoadAsync();
        }
    }

    /// <summary>The switch saves the whole provider with the new flag; the stored secret is kept (null).</summary>
    private async Task ToggleAsync(IdentityProviderDto p, bool enabled)
    {
        var request = new SaveIdentityProviderRequest(p.Kind, p.Slug, p.DisplayNameAr, p.DisplayNameEn,
            p.Authority, p.AzureTenantId, p.ClientId, null, p.Scopes, p.MatchBy, p.NationalIdClaim, p.EmailDomains, enabled);
        await ApiCalls.RunAsync(() => Api.UpdateAsync(p.Id, request), Navigation, L, m => Snackbar.Add(m, Severity.Error));
        await LoadAsync();
    }

    private async Task DeleteAsync(IdentityProviderDto p)
    {
        var confirmed = await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"],
            string.Format(L["Idp_DeleteConfirm"], CultureText.Pick(p.DisplayNameAr, p.DisplayNameEn)));
        if (!confirmed) return;
        if (await ApiCalls.RunAsync(() => Api.DeleteAsync(p.Id), Navigation, L, m => Snackbar.Add(m, Severity.Error)))
            await LoadAsync();
    }
}
