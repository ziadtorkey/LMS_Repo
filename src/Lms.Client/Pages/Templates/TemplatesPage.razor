@page "/templates"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Organizations
@inject ITemplatesApi Api
@inject IOrgApi OrgApi
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["Templates_Title"]</PageTitle>
<PageHeader Title="@L["Templates_Title"]" Subtitle="@L["Templates_Subtitle"]" TitleTestId="templates-title" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-testid="templates-error">@_error</MudAlert>
}

<SectionCard Flush="true">
    @if (_loading)
    {
        <LoadingState Lines="4" Class="pa-4" />
    }
    else if (_items.Count == 0)
    {
        <EmptyState Title="@L["Templates_EmptyTitle"]" Text="@L["Templates_EmptyText"]" Icon="@Icons.Material.Rounded.BookmarkBorder" TestId="table-empty" />
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="lms-simple-table lms-stack-table">
            <thead>
                <tr>
                    <th>@L["Common_Name"]</th>
                    <th>@L["Templates_Visibility"]</th>
                    <th>@L["Templates_Owner"]</th>
                    <th>@L["Templates_Units"]</th>
                    <th>@L["Templates_Placeholders"]</th>
                    <th><span class="lms-visually-hidden">@L["Common_Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _items)
                {
                    var template = t;
                    var shared = template.Visibility == TemplateVisibilities.Shared;
                    <tr data-testid="@($"template-row-{template.Id}")">
                        <td data-label="@L["Common_Name"]" class="lms-cell-strong">@Culture.Pick(template.NameAr, template.NameEn)</td>
                        <td data-label="@L["Templates_Visibility"]">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(shared ? Color.Info : Color.Default)"
                                     Icon="@(shared ? Icons.Material.Rounded.Groups : Icons.Material.Rounded.Lock)">@(shared ? L["Visibility_Shared"] : L["Visibility_Private"])</MudChip>
                        </td>
                        <td data-label="@L["Templates_Owner"]">@Culture.Pick(template.OwnerNameAr, template.OwnerNameEn)</td>
                        <td data-label="@L["Templates_Units"]">@string.Format(L["Templates_UnitsCount"].Value, template.UnitCount)</td>
                        <td data-label="@L["Templates_Placeholders"]"><span dir="ltr" class="lms-muted">@string.Join(", ", template.Placeholders.Select(p => "{" + p + "}"))</span></td>
                        <td class="lms-cell-actions">
                            <div class="lms-row-actions">
                                @if (PermState.Has(Permissions.Templates.Apply))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PlaylistAdd"
                                               OnClick="() => ApplyAsync(template)" data-testid="@($"template-apply-{template.Id}")">@L["Templates_Apply"]</MudButton>
                                }
                                @if (PermState.Has(Permissions.Templates.Delete))
                                {
                                    <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                   aria-label="@L["Common_Delete"]" OnClick="() => DeleteAsync(template)"
                                                   data-testid="@($"template-delete-{template.Id}")" />
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</SectionCard>

@code {
    private IReadOnlyList<OrgTemplateSummaryDto> _items = [];
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    private Task<bool> RunAsync(Func<Task> action) => ApiCalls.RunAsync(action, Navigation, L, message => _error = message);

    private async Task LoadAsync()
    {
        await RunAsync(async () => _items = await Api.ListAsync());
        _loading = false;
    }

    private async Task ApplyAsync(OrgTemplateSummaryDto template)
    {
        _error = null;
        IReadOnlyList<OrgUnitNodeDto> units = [];
        if (!await RunAsync(async () => units = await OrgApi.GetOrgUnitsAsync(null))) return;
        var dialog = await Dialogs.ShowAsync<ApplyTemplateDialog>(L["Templates_Apply"], new DialogParameters<ApplyTemplateDialog>
        {
            { x => x.Template, template }, { x => x.AllUnits, units },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
    }

    private async Task DeleteAsync(OrgTemplateSummaryDto template)
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], L["Templates_DeleteConfirm"], L["Common_Delete"])) return;
        _error = null;
        await RunAsync(() => Api.DeleteAsync(template.Id));
        await LoadAsync();
    }

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
