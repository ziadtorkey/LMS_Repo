@page "/class-courses/{Id:guid}/gradebook"
@attribute [Authorize]
@implements IDisposable
@using Lms.Client.Components
@using Lms.Client.Components.Gradebook
@using Lms.Client.Pages.Forums
@using Lms.Client.Services
@using Lms.Client.Services.Api
@using Lms.Client.Services.Grading
@using Lms.Shared.Authorization
@using Lms.Shared.Grading
@inject IGradebookApi Api
@inject PermissionState PermState
@inject ICultureService Culture
@inject IViewport Viewport
@inject IJSRuntime Js
@inject IGradebookUnit UnitOf
@inject NavigationManager Navigation
@inject IDialogService Dialogs

@* The gradebook of a class course, read and render (M5 Task 24): the desktop grid, or on a phone the student-first list (ONE layout, L19). Every number
   comes from the server (L18). Editing, publishing, import and export are Tasks 25 to 28. *@
<PageTitle>@L["Grd_Title"]</PageTitle>
<ClassCourseTabs ClassCourseId="Id" Active="gradebook" />
@if (!PermState.Loaded)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Grades.View) && !PermState.Has(Permissions.Grades.Manage))
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="gradebook-forbidden">@L["Forbidden_Title"]</MudAlert>
}
else
{
    <PageHeader Title="@L["Grd_Title"]" Subtitle="@Subtitle" TitleTestId="gradebook-title">
        <Actions>
            @if (CanManageBook)
            {
                <MudIconButton Icon="@Icons.Material.Rounded.Settings" aria-label="@L["Grd_Config_Open"]" aria-expanded="@(_settingsOpen ? "true" : "false")" aria-controls="gradebook-config"
                               OnClick="() => _settingsOpen = !_settingsOpen" data-testid="gradebook-settings" />
            }
        </Actions>
    </PageHeader>
    @if (_error is not null && _book is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="gradebook-error">
            <div class="d-flex align-center flex-wrap gap-2">
                <span>@_error</span>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="() => LoadAsync(_pageNo)"
                           data-testid="gradebook-retry">@L["Common_Retry"]</MudButton>
            </div>
        </MudAlert>
    }
    else if (_book is null || !Viewport.Ready)
    {
        <LoadingState Lines="8" TestId="gradebook-loading" />
    }
    else
    {
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3" data-testid="gradebook-error">
                <div class="d-flex align-center flex-wrap gap-2">
                    <span>@_error</span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="() => LoadAsync(_pageNo)" data-testid="gradebook-retry">@L["Common_Retry"]</MudButton>
                </div>
            </MudAlert>
        }
        @if (_book.State == GradebookStates.Locked)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" data-testid="gradebook-locked">@L["Grd_Locked_Banner"]</MudAlert>
        }
        @if (_settingsOpen && CanManageBook)
        {
            <GradebookConfigPanel Book="_book" ClassCourseId="Id" TermId="_book.TermId" OnChanged="() => LoadAsync(_pageNo)" />
        }
        <SectionCard Flush="true" TestId="gradebook-card">
            <div class="lms-gb-toolbar" role="toolbar" aria-label="@L["Grd_Toolbar"]">
                <TermPicker Terms="_terms" Current="_book.TermId" CurrentName="@Culture.Pick(_book.TermNameAr, _book.TermNameEn)" OnPick="PickTermAsync" />
                <WeightsChip Total="_book.WeightsTotal" />
                @if (_book.CanManage && _book.Items.Any(i => i.IsManual))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.UploadFile" OnClick="OpenImportAsync"
                               data-testid="gradebook-import">@L["GradeImport_Open"]</MudButton>
                }
                @if (_book.CanPublish && _book.Items.Count > 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Visibility" OnClick="OpenPublishAsync"
                               data-testid="gradebook-publish">@L["Publish_Open"]</MudButton>
                }
            </div>
            @if (_book.Rows.Total == 0)
            {
                <EmptyState Title="@L["Grd_Empty_Students_Title"]" Text="@L["Grd_Empty_Students_Text"]" Icon="@Icons.Material.Rounded.GroupOff" TestId="gradebook-no-students">
                    <MudButton Variant="Variant.Outlined" Href="@($"class-courses/{Id}/plan")" data-testid="gradebook-enrollment-link">@L["Grd_Empty_Students_Action"]</MudButton>
                </EmptyState>
            }
            else if (_groups.Count == 0)
            {
                <EmptyState Title="@L["Grd_Empty_Items_Title"]" Text="@L["Grd_Empty_Items_Text"]" Icon="@Icons.Material.Rounded.PlaylistAdd" TestId="gradebook-no-items" />
            }
            else if (Viewport.IsPhone)
            {
                <StudentFirstList Groups="_groups" Rows="_book.Rows.Items" Places="_book.Config.DecimalPlaces" OnStudent="OpenStudentAsync" Session="_session" CanEdit="CanEdit" />
            }
            else
            {
                <GradebookGrid Groups="_groups" Rows="_book.Rows.Items" Places="_book.Config.DecimalPlaces" OnStudent="OpenStudentAsync" Session="_session" CanEdit="CanEdit" />
            }
            @if (_book.Rows.Total > _book.Rows.PageSize)
            {
                <div class="d-flex justify-center pa-3" data-testid="gradebook-paging">
                    <MudPagination Count="PageCount" Selected="_pageNo" SelectedChanged="LoadAsync" aria-label="@L["Grd_Paging"]" />
                </div>
            }
        </SectionCard>
    }
    @if (_session is not null)
    {
        <GridLiveRegion Session="_session" />
    }
    <StudentDetailDrawer Open="_drawerOpen" OpenChanged="CloseDrawerAsync" StudentName="@_drawerName" Data="_preview" Loading="_previewLoading" Failed="_previewFailed" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "termId")] public Guid? TermId { get; set; }

    private GradebookDto? _book;
    private IReadOnlyList<Lms.Shared.AcademicYears.TermDto> _terms = [];
    private Guid? _loadedTerm;
    private IReadOnlyList<CategoryGroup> _groups = [];
    private string? _error;
    private int _pageNo = 1;
    private bool _drawerOpen, _previewLoading, _previewFailed;
    private string _drawerName = "";
    private StudentCourseGradesDto? _preview;
    private GradebookEditSession? _session;
    private bool _settingsOpen;

    /// <summary>Settings (categories, weights, scale, items) are for someone who may manage a gradebook that is still open.</summary>
    private bool CanManageBook => _book is { CanManage: true, State: not GradebookStates.Locked };

    /// <summary>Scores can be changed by someone who may manage the gradebook, while it is open.</summary>
    private bool CanEdit => _book is { CanManage: true, State: not GradebookStates.Locked };

    /// <summary>Import or export a grade column. Only manual items: the server rejects an import into an event item (its score comes from the assignment or quiz).</summary>
    private Task OpenImportAsync() =>
        DialogFlow.ShowAsync(Dialogs, L["GradeImport_Title"], new DialogParameters<GradeColumnImportDialog>
        {
            { x => x.ClassCourseId, Id },
            { x => x.Items, _book!.Items.Where(i => i.IsManual).ToList() },
        }, () => InvokeAsync(async () => { await LoadAsync(_pageNo); StateHasChanged(); }));

    /// <summary>Publish, schedule or hide items. Allowed on a locked gradebook too (Lead ruling): the server only refuses entering grades there.</summary>
    private Task OpenPublishAsync() =>
        DialogFlow.ShowAsync(Dialogs, L["Publish_Title"], new DialogParameters<PublishItemsDialog>
        {
            { x => x.ClassCourseId, Id },
            { x => x.Items, _book!.Items },
            { x => x.Preselected, _book.Items.Where(i => i.PublishState == PublishStates.Hidden).Select(i => i.Id).ToList() },
            { x => x.ScaleProvisional, _book.Config.ScaleProvisional },
        }, () => InvokeAsync(async () => { await LoadAsync(_pageNo); StateHasChanged(); })); // the grid shows the new states

    private int PageCount => _book is null ? 1 : (int)Math.Ceiling(_book.Rows.Total / (double)Math.Max(1, _book.Rows.PageSize));

    private string? Subtitle
    {
        get
        {
            if (_book is null) return null;
            var term = Culture.Pick(_book.TermNameAr, _book.TermNameEn);
            var scale = _book.Config.ScaleNameAr is null && _book.Config.ScaleNameEn is null ? null : Culture.Pick(_book.Config.ScaleNameAr ?? "", _book.Config.ScaleNameEn ?? "");
            return string.IsNullOrEmpty(scale) ? term : string.Format(Culture.Current, L["Grd_TermScale"].Value, term, scale);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        _leaving = Navigation.RegisterLocationChangingHandler(CommitBeforeLeavingAsync);
        await Viewport.EnsureAsync();
        _terms = await UnitOf.TermsAsync(Id);
        _loadedTerm = TermId;
        await LoadAsync(1);
    }

    private GradebookEditSession CreateSession()
    {
        var session = new GradebookEditSession(Api, Id, _book?.TermId, L, () => LoadAsync(_pageNo));
        session.RowReplaced += OnRowReplaced;
        return session;
    }

    /// <summary>The server row replaces the optimistic one: a new list with only that row changed, so only its component renders again.</summary>
    private void OnRowReplaced(GradeRowDto row)
    {
        if (_book is null) return;
        var items = _book.Rows.Items.Select(r => r.StudentId == row.StudentId ? row : r).ToList();
        _book = _book with { Rows = _book.Rows with { Items = items } };
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Another term in the address: a different gradebook, so its own page of students and a new edit session.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_book is null || TermId == _loadedTerm) return;
        _loadedTerm = TermId;
        if (_session is not null) _session.RowReplaced -= OnRowReplaced;
        _session = null; // unsaved edits belong to the term they were typed in
        _settingsOpen = false;
        await LoadAsync(1);
    }

    private void PickTermAsync(Guid term) => Navigation.NavigateTo($"class-courses/{Id}/gradebook?termId={term}");

    private void OnViewportChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync(int page)
    {
        _pageNo = page;
        _error = null;
        try
        {
            var book = await Api.GetAsync(Id, new GradebookQuery(TermId, page, GradingLimits.GridPageSize));
            _book = book;
            _session ??= CreateSession();
            // One stable list per loaded gradebook: the rows compare it by reference to skip re-rendering.
            _groups = CategoryGroup.From(book.Categories, book.Items);
        }
        catch (Exception ex) when (ApiCalls.TryRedirect(ex, Navigation))
        {
            // The page is navigating away.
        }
        catch (Exception ex) when (ex is ApiProblemException or HttpRequestException)
        {
            _error = L["Api_Error"];
        }

        // A reload can be asked for by an edit deep in the grid, whose event handler does not render this page.
        await InvokeAsync(StateHasChanged);
    }

    private Guid? _drawerStudent;

    private async Task FocusAsync(string testId)
    {
        await Task.Delay(120); // the drawer renders a moment after it opens
        try
        {
            var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/gradebook-grid.js");
            await module.InvokeVoidAsync("focusTestId", testId);
        }
        catch (JSException)
        {
        }
    }

    /// <summary>Closing the drawer returns the focus to the student button that opened it.</summary>
    private async Task CloseDrawerAsync(bool open)
    {
        _drawerOpen = open;
        if (open || _drawerStudent is not { } id) return;
        await Task.Delay(50); // the drawer's overlay is still releasing the focus
        try
        {
            var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/gradebook-grid.js");
            await module.InvokeVoidAsync("focusTestId", $"student-{id}");
        }
        catch (JSException)
        {
        }
    }

    private async Task OpenStudentAsync(GradeRowDto row)
    {
        _drawerStudent = row.StudentId;
        _drawerName = Culture.Pick(row.StudentNameAr, row.StudentNameEn);
        _drawerOpen = true;
        _preview = null;
        _previewFailed = false;
        _previewLoading = true;
        _ = FocusAsync("drawer-close"); // the focus moves into the drawer so Esc and Tab work there
        try
        {
            _preview = await Api.GetStudentViewAsync(Id, row.StudentId, _book?.TermId);
        }
        catch (Exception ex) when (ApiCalls.TryRedirect(ex, Navigation))
        {
            // Navigating away.
        }
        catch (Exception ex) when (ex is ApiProblemException or HttpRequestException)
        {
            _previewFailed = true;
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private IDisposable? _leaving;

    /// <summary>Leaving the page with a half-typed score saves it first (the FormFlush rule of the plan): a click on a link does not lose it.</summary>
    private async ValueTask CommitBeforeLeavingAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (_session?.Editing is not { } e || _book is null) return;
        var row = _book.Rows.Items.FirstOrDefault(r => r.StudentId == e.Student);
        var item = _book.Items.FirstOrDefault(i => i.Id == e.Item);
        if (row is null || item is null) return;
        await _session.SetScoreAsync(row, item, _session.Draft);
        _session.EndEdit();
    }

    public void Dispose()
    {
        _leaving?.Dispose();
        Viewport.Changed -= OnViewportChanged;
        if (_session is not null) _session.RowReplaced -= OnRowReplaced;
    }
}
