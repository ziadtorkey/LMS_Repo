@page "/courses/{Id:guid}/blueprint"
@attribute [Authorize]
@using System.Text.Json
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Blueprints
@using Lms.Shared.Configuration
@using Lms.Shared.Courses
@inject IBlueprintsApi Api
@inject ICoursesApi Courses
@inject IConfigApi Config
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["Blueprint_Title"]</PageTitle>
<NavigationLock OnBeforeInternalNavigation="OnLeavingAsync" ConfirmExternalNavigation="@(_editing && _model.IsDirty)" />

<MudLink Href="@($"courses/{Id}")" Typo="Typo.body2" Class="lms-back-link" data-testid="blueprint-back">
    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
    @L["Blueprint_BackToCourse"]
</MudLink>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="blueprint-error">@_error</MudAlert>
}
else if (_course is null)
{
    <LoadingState Lines="5" TestId="blueprint-loading" />
}
else
{
    <PageHeader Title="@L["Blueprint_Title"]" Subtitle="@Culture.Pick(_course.Summary.NameAr, _course.Summary.NameEn)" TitleTestId="blueprint-title">
        <Badges>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_editing ? Color.Warning : Color.Default)"
                     data-testid="blueprint-status">@StatusText</MudChip>
        </Badges>
        <Actions>
            @if (_editing)
            {
                <div class="lms-action-bar">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Save" OnClick="SaveAsync" Disabled="_busy || !_model.IsDirty"
                               data-testid="blueprint-save">@L["Common_Save"]</MudButton>
                    @if (PermState.Has(Permissions.Blueprints.Publish))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Publish" OnClick="PublishAsync"
                                   Disabled="_busy || _model.IsDirty || _model.Sections.Count == 0" data-testid="blueprint-publish">@L["Blueprint_Publish"]</MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.ContentCopy" OnClick="CopyAsync" data-testid="blueprint-copy">@L["Blueprint_Copy"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Rounded.Undo" OnClick="DiscardAsync"
                               data-testid="blueprint-discard">@L["Blueprint_Discard"]</MudButton>
                </div>
            }
            else if (CanEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Edit" OnClick="EditDraftAsync" Disabled="_busy"
                           data-testid="blueprint-edit">@L["Blueprint_EditDraft"]</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudStack Spacing="3">
        @if (_stale)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="blueprint-stale">
                @L["Blueprint_Stale"]
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ReloadDraftAsync" data-testid="blueprint-reload">@L["Blueprint_Reload"]</MudButton>
            </MudAlert>
        }
        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="blueprint-message">@_message</MudAlert>
        }
        @if (_editing && _model.IsDirty)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" data-testid="blueprint-unsaved">@L["Blueprint_Unsaved"]</MudAlert>
        }
        @if (_validation is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="blueprint-validation">@_validation</MudAlert>
        }

        @if (!_editing && _shown is null)
        {
            <SectionCard>
                <EmptyState Title="@L["Blueprint_NoPublished"]" Text="@L["Blueprint_NoPublishedText"]" Icon="@Icons.Material.Rounded.AccountTree" TestId="blueprint-none" />
            </SectionCard>
        }
        else
        {
            <BlueprintTree Model="_model" ReadOnly="!_editing" SectionLabel="@_sectionLabel" OnChanged="() => InvokeAsync(StateHasChanged)" />
        }

        <SectionCard Title="@L["Blueprint_Versions"]" Flush="true">
            <MudSimpleTable Dense="true" Elevation="0" Class="lms-simple-table lms-stack-table" data-testid="blueprint-versions">
                <thead>
                    <tr>
                        <th>@L["Blueprint_Version"]</th>
                        <th>@L["Common_Status"]</th>
                        <th>@L["Blueprint_PublishedOn"]</th>
                        <th>@L["Blueprint_Content"]</th>
                        <th><span class="lms-visually-hidden">@L["Common_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _versions)
                    {
                        <tr>
                            <td data-label="@L["Blueprint_Version"]">@(v.Version == 0 ? L["BlueprintStatus_Draft"].Value : L["Blueprint_VersionN", v.Version].Value)</td>
                            <td data-label="@L["Common_Status"]">@L[$"BlueprintStatus_{v.Status}"]</td>
                            <td data-label="@L["Blueprint_PublishedOn"]"><span dir="ltr">@(v.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</span></td>
                            <td data-label="@L["Blueprint_Content"]">@L["Blueprint_Counts", v.SectionCount, v.LessonCount]</td>
                            <td class="lms-cell-actions">
                                @if (v.Version > 0)
                                {
                                    <div class="lms-row-actions">
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => ViewVersionAsync(v.Version)"
                                                   data-testid="@($"version-view-{v.Version}")">@L["Blueprint_View"]</MudButton>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </SectionCard>
    </MudStack>
}

@code {
    private CourseDetailDto? _course;
    private BlueprintModel _model = new();
    private BlueprintSummaryDto? _shown;
    private IReadOnlyList<BlueprintSummaryDto> _versions = [];
    private string _sectionLabel = "Week";
    private string? _error, _message, _validation;
    private bool _editing, _busy, _stale;

    [Parameter] public Guid Id { get; set; }

    private bool CanEdit => _course is { CanEdit: true } && PermState.Has(Permissions.Blueprints.Edit);

    private string StatusText => _editing ? L["Blueprint_EditingDraft"].Value
        : _shown is null ? L["Blueprint_NoPublished"].Value : L["Blueprint_ViewingVersion", _shown.Version].Value;

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;

    private async Task LoadAsync()
    {
        _error = _message = _validation = null;
        _stale = _editing = false;
        await ApiCalls.RunAsync(async () =>
        {
            _course = await Courses.GetAsync(Id);
            await LoadSectionLabelAsync();
            await LoadVersionsAsync();
            var latest = _versions.Where(v => v.Status == BlueprintStatuses.Published).OrderByDescending(v => v.Version).FirstOrDefault();
            if (latest is null)
            {
                _shown = null;
                _model = new BlueprintModel();
            }
            else await ShowVersionAsync(latest.Version);
        }, Navigation, L, message => _error = message);
    }

    // The label is a convenience: without permission to read settings the default (Week) is used.
    private async Task LoadSectionLabelAsync() =>
        await ApiCalls.RunAsync(async () =>
        {
            var settings = await Config.GetSettingsAsync(_course!.Summary.OwnerOrgUnitId);
            if (settings.FirstOrDefault(s => s.Name == SettingKeys.BlueprintsSectionLabel.Name) is { } s
                && JsonSerializer.Deserialize<string>(s.ValueJson) is { Length: > 0 } label)
                _sectionLabel = label;
        }, Navigation, L, _ => { });

    private async Task LoadVersionsAsync() => _versions = await Api.ListVersionsAsync(Id);

    private async Task ShowVersionAsync(int version)
    {
        var dto = await Api.GetVersionAsync(Id, version);
        _shown = dto.Summary;
        _model = BlueprintModel.From(dto);
    }

    private async Task ViewVersionAsync(int version)
    {
        if (_editing && _model.IsDirty && !await ConfirmLeaveAsync()) return;
        _editing = false;
        _validation = null;
        await ApiCalls.RunAsync(() => ShowVersionAsync(version), Navigation, L, message => _error = message);
    }

    private async Task EditDraftAsync()
    {
        _busy = true;
        _validation = null;
        await ApiCalls.RunAsync(async () =>
        {
            var draft = await Api.GetDraftAsync(Id) ?? await Api.CreateDraftAsync(Id);
            _model = BlueprintModel.From(draft);
            _editing = true;
            await LoadVersionsAsync();
        }, Navigation, L, message => _error = message);
        _busy = false;
    }

    private async Task ReloadDraftAsync()
    {
        _stale = false;
        await EditDraftAsync();
    }

    private async Task DiscardAsync()
    {
        if (_model.IsDirty && !await ConfirmLeaveAsync()) return;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        _validation = null;
        if (!_model.IsComplete)
        {
            _validation = L["Blueprint_TitlesRequired"];
            return;
        }
        await SaveCoreAsync();
    }

    /// <summary>Saves the draft; false when it failed (stale revision, validation, server error).</summary>
    private async Task<bool> SaveCoreAsync()
    {
        _busy = true;
        _message = null;
        var staleRevision = false;
        BlueprintDto? saved = null;
        var ok = await ApiCalls.RunAsync(async () =>
        {
            try
            {
                saved = await Api.SaveDraftAsync(Id, _model.ToRequest());
            }
            catch (ApiProblemException ex) when (ex.Code == ProblemCodesStale)
            {
                staleRevision = true;
            }
        }, Navigation, L, message => _error = message);
        _busy = false;
        if (staleRevision)
        {
            _stale = true;
            return false;
        }
        if (!ok || saved is null) return false;
        _model.MarkSaved(saved);
        await LoadVersionsAsync();
        Snackbar.Add(L["Common_Saved"], Severity.Success);
        return true;
    }

    private const string ProblemCodesStale = "blueprint_stale";

    private async Task PublishAsync()
    {
        _validation = null;
        if (!_model.IsComplete || _model.Sections.Count == 0 || _model.Sections.Any(s => s.Lessons.Count == 0))
        {
            _validation = L["Blueprint_EmptyOrIncomplete"];
            return;
        }
        var dialog = await Dialogs.ShowAsync<PublishBlueprintDialog>(L["Blueprint_Publish"], new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: string mode }) return;

        _busy = true;
        PublishBlueprintResultDto? result = null;
        var ok = await ApiCalls.RunAsync(async () => result = await Api.PublishAsync(Id, new PublishBlueprintRequest(mode)),
            Navigation, L, message => _error = message);
        _busy = false;
        if (!ok || result is null) return;

        await LoadAsync();
        _message = mode == BlueprintApplyModes.PushToExisting
            ? L["Blueprint_PublishedQueued", result.Blueprint.Version, result.ClassesQueued].Value
            : L["Blueprint_PublishedNew", result.Blueprint.Version].Value;
    }

    private async Task CopyAsync()
    {
        var dialog = await Dialogs.ShowAsync<CopyBlueprintDialog>(L["Blueprint_Copy"], new DialogParameters<CopyBlueprintDialog> { { x => x.CourseId, Id } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: CopyBlueprintRequest request }) return;

        _busy = true;
        // Copy writes over the saved draft, so unsaved local edits would be lost: they are saved first only if the user confirms the dialog above.
        await ApiCalls.RunAsync(async () =>
        {
            var copied = await Api.CopyFromAsync(Id, request);
            _model = BlueprintModel.From(copied);
            await LoadVersionsAsync();
        }, Navigation, L, message => _error = message);
        _busy = false;
    }

    private async Task<bool> ConfirmLeaveAsync() =>
        await ConfirmDialog.AskAsync(Dialogs, L["Blueprint_Unsaved"], L["Blueprint_LeaveConfirm"], L["Blueprint_LeaveAnyway"]);

    private async Task OnLeavingAsync(LocationChangingContext context)
    {
        if (_editing && _model.IsDirty && !await ConfirmLeaveAsync()) context.PreventNavigation();
    }
}
