@page "/"
@attribute [Authorize]
@inject ILmsApi Api
@inject NavigationManager Navigation
@inject PermissionState PermState
@using Lms.Client.Components.Content
@using Lms.Shared.Authorization

<PageTitle>@L["Home_Title"]</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">@L["Home_Title"]</MudText>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (_failed)
{
    <MudAlert Severity="Severity.Error" data-testid="api-error">
        @L["Api_Error"]
        <MudButton Variant="Variant.Text" OnClick="LoadAsync">@L["Common_Retry"]</MudButton>
    </MudAlert>
}
else if (_name is not null)
{
    <MudText>@string.Format(L["Home_Welcome"].Value, _name)</MudText>
    @if (PermState.Has(Permissions.CourseAssignments.View) || PermState.Has(Permissions.Quizzes.View) || PermState.Has(Permissions.CourseAssignments.Grade))
    {
        <HomeActivityCards />
    }
    @if (PermState.Has(Permissions.Modules.View) && !PermState.Has(Permissions.Modules.Manage))
    {
        <ContinueLearningCards />
        <Lms.Client.Components.Packages.PackageStatesCard />
    }
    @if (PermState.Has(Lms.Shared.Authorization.Permissions.Students.ViewChildren))
    {
        <MudPaper Class="pa-4 mt-4" data-testid="home-children-card">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" Size="Size.Large" />
                <MudText Typo="Typo.h6">@L["MyChildren_Title"]</MudText>
                <MudButton Href="me/children" Variant="Variant.Filled" Color="Color.Primary" data-testid="home-children-link">@L["MyChildren_Open"]</MudButton>
            </MudStack>
        </MudPaper>
    }
    @if (PermState.Has(Permissions.LessonPlans.View))
    {
        <MudCard Class="mt-4" Style="max-width: 420px" data-testid="home-my-class-courses">
            <MudCardContent>
                <MudText Typo="Typo.h6">@L["MyClassCourses_Title"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Home_MyClassCoursesHint"]</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="me/class-courses" data-testid="home-my-class-courses-link">@L["MyClassCourses_OpenPlan"]</MudButton>
            </MudCardActions>
        </MudCard>
    }
}

@code {
    private string? _name;
    private bool _loading = true;
    private bool _failed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _failed = false;
        var (me, failed) = await ApiCalls.RunAsync(() => Api.GetMeAsync(), Navigation);
        _failed = failed;
        if (me is not null)
            _name = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? me.DisplayNameAr : me.DisplayNameEn;
        _loading = false;
    }
}
