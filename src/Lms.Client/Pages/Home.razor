@page "/"
@attribute [Authorize]
@inject ILmsApi Api
@inject NavigationManager Navigation
@inject PermissionState PermState
@inject ICultureService Culture
@using Lms.Client.Components.Content
@using Lms.Shared.Authorization


<PageTitle>@L["Home_Title"]</PageTitle>
@if (_loading)
{
    <LoadingState Lines="4" TestId="home-loading" />
}
else if (_failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="api-error">
        @L["Api_Error"]
        <MudButton Variant="Variant.Text" OnClick="LoadAsync">@L["Common_Retry"]</MudButton>
    </MudAlert>
}
else if (_name is not null)
{
    <PageHeader Title="@L["Home_Title"]" Subtitle="@string.Format(L["Home_Welcome"].Value, _name)" TitleTestId="home-title" />

    @if (PermState.Has(Lms.Shared.Authorization.Permissions.Students.ViewChildren))
    {
        <SectionCard Class="mb-4" TestId="home-children-card">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Rounded.FamilyRestroom" Size="Size.Large" aria-hidden="true" />
                <MudText Typo="Typo.subtitle1" Class="flex-grow-1">@L["MyChildren_Title"]</MudText>
                <MudButton Href="me/children" Variant="Variant.Filled" Color="Color.Primary" data-testid="home-children-link">@L["MyChildren_Open"]</MudButton>
            </MudStack>
        </SectionCard>
    }
    @if (PermState.Has(Permissions.Modules.View) && !PermState.Has(Permissions.Modules.Manage))
    {
        <ContinueLearningCards />
    }
    @if (PermState.Has(Permissions.CourseAssignments.View) || PermState.Has(Permissions.Quizzes.View) || PermState.Has(Permissions.CourseAssignments.Grade))
    {
        <HomeActivityCards />
    }
    @if (PermState.Has(Permissions.LessonPlans.View))
    {
        <SectionCard Title="@L["MyClassCourses_Title"]" Class="mt-4" TestId="home-my-class-courses">
            <Actions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="me/class-courses"
                           EndIcon="@(Culture.IsRightToLeft ? Icons.Material.Rounded.ArrowBack : Icons.Material.Rounded.ArrowForward)"
                           data-testid="home-my-class-courses-link">@L["MyClassCourses_OpenPlan"]</MudButton>
            </Actions>
            <ChildContent>
                <MudText Typo="Typo.body2" Class="lms-muted">@L["Home_MyClassCoursesHint"]</MudText>
            </ChildContent>
        </SectionCard>
    }
}

@code {
    private string? _name;
    private bool _loading = true;
    private bool _failed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _failed = false;
        var (me, failed) = await ApiCalls.RunAsync(() => Api.GetMeAsync(), Navigation);
        _failed = failed;
        if (me is not null)
            _name = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? me.DisplayNameAr : me.DisplayNameEn;
        _loading = false;
    }
}
