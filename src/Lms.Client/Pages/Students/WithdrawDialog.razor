@using Lms.Client.Services.Api
@using Lms.Client.Services.YearEnd
@using Lms.Shared.YearEnd
@inject ILifecycleApi Api
@inject NavigationManager Navigation
@inject TimeProvider Clock

@* Withdraw a student (FR-STU-08, D81, D82): a reason from the client's list (or Other with a note) and the effective date. The effect is said in plain words first; a
   future date says when sign-in stops. The reason is for staff only. The server checks everything again (400 reason, 422 effective date, 409 already inactive). *@
<MudDialog Class="lms-dialog-fs">
    <DialogContent>
        <div class="lms-form" data-testid="withdraw-dialog">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3" data-testid="withdraw-error">@_error</MudAlert>
            }
            <p data-testid="withdraw-effect">@string.Format(L["Lifecycle_WithdrawEffect"].Value, Name)</p>
            <MudSelect T="string" @bind-Value="_reason" Label="@L["Lifecycle_Reason"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" data-testid="withdraw-reason">
                @foreach (var r in _reasons)
                {
                    <MudSelectItem Value="@r.Key">@CultureText.Pick(r.NameAr, r.NameEn)</MudSelectItem>
                }
                <MudSelectItem Value="@WithdrawalReasons.Other">@L["Lifecycle_ReasonOther"]</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" @bind-Value="_note" Label="@L["Lifecycle_Note"]" Lines="2" MaxLength="LifecycleLimits.NoteMaxLength" Immediate="true" Variant="Variant.Outlined" Class="mt-2"
                          Required="@(_reason == WithdrawalReasons.Other)" HelperText="@L["Lifecycle_NoteHelp"]" data-testid="withdraw-note" />
            <MudDatePicker Date="_date" DateChanged="d => _date = d" Label="@L["Lifecycle_EffectiveDate"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                           Editable="true" Required="true" data-testid="withdraw-date" />
            @if (IsFuture)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2" data-testid="withdraw-future">
                    @string.Format(L["Lifecycle_FutureHint"].Value, "⁦" + _date!.Value.ToString("yyyy-MM-dd") + "⁩")
                </MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => MudDialog.Cancel()" data-testid="withdraw-cancel">@L["Common_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="!CanSubmit" OnClick="SubmitAsync" data-testid="withdraw-confirm">@L["Lifecycle_Withdraw"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public Guid StudentId { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    private IReadOnlyList<WithdrawalReasonDto> _reasons = [];
    private string? _reason, _note, _error;
    private DateTime? _date;
    private bool _busy;

    private DateTime Today => Clock.GetLocalNow().DateTime.Date;
    private bool IsFuture => _date is { } d && d.Date > Today;

    private bool CanSubmit => !_busy && !string.IsNullOrEmpty(_reason) && _date is not null && (_reason != WithdrawalReasons.Other || !string.IsNullOrWhiteSpace(_note));

    protected override async Task OnInitializedAsync()
    {
        _date = Today;
        var (reasons, _) = await ApiCalls.RunAsync(() => Api.GetReasonsAsync(), Navigation);
        _reasons = [.. (reasons ?? []).Where(r => r.IsActive)];
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit) return;
        _busy = true; _error = null;
        var note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim();
        var ok = await ApiCalls.RunAsync(() => Api.WithdrawAsync(StudentId, new WithdrawStudentRequest(_reason!, note, DateOnly.FromDateTime(_date!.Value))), Navigation, L, e => _error = e);
        _busy = false;
        if (ok) MudDialog.Close(DialogResult.Ok(true));
    }
}
