@page "/students/{Id:guid}"
@attribute [Authorize]
@using System.Globalization
@using Lms.Client.Components
@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.People
@implements IDisposable
@inject IStudentsApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["Students_Title"]</PageTitle>
<MudLink Href="students" Typo="Typo.body2" Class="lms-back-link" data-testid="profile-back">
    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
    @L["Student_BackToList"]
</MudLink>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="profile-error">@_error</MudAlert>
}
else if (_detail is null)
{
    <LoadingState Lines="5" TestId="profile-loading" />
}
else
{
    var s = _detail.Summary;
    var name = Culture.Pick(s.NameAr, s.NameEn);
    <PageHeader Title="@name" TitleTestId="profile-name" Class="lms-profile-header">
        <Leading>
            <StaffAvatar PhotoFileId="s.PhotoFileId" Name="@name" Size="Size.Large" />
        </Leading>
        <Badges>
            <PersonStatusChip Status="@s.Status" />
            <span class="lms-muted" dir="ltr" data-testid="profile-code">@s.StudentCode</span>
            @if (s.CurrentClassId is null)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" data-testid="profile-unplaced">@L["Student_Unplaced"]</MudChip>
            }
        </Badges>
        <Actions>
            <div class="lms-action-bar" data-testid="profile-actions">
                @if (PermState.Has(Permissions.Students.Update))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Edit" OnClick="EditAsync"
                               data-testid="action-edit">@L["Student_Edit"]</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.LockReset" OnClick="ResetPasswordAsync"
                               data-testid="action-reset">@L["Student_ResetPassword"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="ChangeStatusAsync"
                               StartIcon="@(s.Status == PersonStatuses.Active ? Icons.Material.Rounded.PersonOff : Icons.Material.Rounded.HowToReg)"
                               data-testid="action-status">@(s.Status == PersonStatuses.Active ? L["Staff_Deactivate"] : L["Staff_Reactivate"])</MudButton>
                }
                @if ((s.Status == PersonStatuses.Active && PermState.Has(Permissions.Students.Withdraw)) || (s.Status != PersonStatuses.Active && PermState.Has(Permissions.Students.Readmit)))
                {
                    <MudMenu Label="@L["Lifecycle_Record"]" Variant="Variant.Outlined" EndIcon="@Icons.Material.Rounded.ArrowDropDown" AriaLabel="@L["Lifecycle_Record"]" data-testid="student-record-menu">
                        @if (s.Status == PersonStatuses.Active)
                        {
                            <MudMenuItem OnClick="WithdrawAsync" data-testid="withdraw-open">@L["Lifecycle_Withdraw"]</MudMenuItem>
                            <MudMenuItem OnClick="GraduateAsync" data-testid="graduate-open">@L["Lifecycle_Graduate"]</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem OnClick="ReadmitAsync" data-testid="readmit-open">@L["Lifecycle_Readmit"]</MudMenuItem>
                        }
                    </MudMenu>
                }
                @if (PermState.Has(Permissions.Students.Delete))
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Rounded.DeleteOutline" OnClick="DeleteAsync"
                               data-testid="action-delete">@L["Common_Delete"]</MudButton>
                }
            </div>
        </Actions>
    </PageHeader>

    <div class="lms-profile-grid">
        <SectionCard Title="@L["Student_Profile"]" Class="lms-profile-details" TestId="tab-profile">
            <dl class="lms-details">
                <DetailItem Label="@L["Student_Account"]" TestId="profile-account">@AccountState</DetailItem>
                <DetailItem Label="@L["Student_Class"]">
                    @if (s.CurrentClassId is { } classId)
                    {
                        <MudLink Href="@($"classes/{classId}")" data-testid="profile-class">@Culture.Pick(s.CurrentClassNameAr ?? "", s.CurrentClassNameEn ?? "")</MudLink>
                    }
                    else
                    {
                        <span class="lms-detail-empty">—</span>
                    }
                </DetailItem>
                <DetailItem Label="@L["Staff_HomeUnit"]" Value="@Culture.Pick(s.HomeOrgUnitNameAr, s.HomeOrgUnitNameEn)" />
                <DetailItem Label="@L["Student_DateOfBirth"]" Value="@s.DateOfBirth.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" Ltr="true" />
                <DetailItem Label="@L["Student_Gender"]" Value="@L[$"Gender_{s.Gender}"]" />
                <DetailItem Label="@L["Student_Religion"]" Value="@L[$"Religion_{_detail.Religion}"]" />
                <DetailItem Label="@L["Student_Nationality"]" Value="@NationalityName(_detail.Nationality)" TestId="profile-nationality" />
                <DetailItem Label="@L["Student_NationalId"]" Value="@_detail.NationalId" Ltr="true" TestId="profile-national-id" />
                <DetailItem Label="@L["Student_Mobile"]" Value="@_detail.Mobile" Ltr="true" TestId="profile-mobile" />
                <DetailItem Label="@L["Student_Email"]" Value="@_detail.Email" Ltr="true" TestId="profile-email" />
            </dl>
        </SectionCard>

        <div class="lms-profile-main">
            <SectionCard>
                <MudTabs Elevation="0" Rounded="true" Class="lms-student-tabs" data-testid="profile-tabs">
                    <MudTabPanel Text="@L["Student_Guardians"]" data-testid="tab-guardians">
                        <StudentGuardiansTab Student="_detail" CanEdit="PermState.Has(Permissions.Students.Update)" OnChanged="LoadAsync" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Student_Enrollments"]" data-testid="tab-enrollments">
                        @* Hosts StudentEnrollmentsTab (enrollments, optional courses, unenroll and transfer) once that component exists. *@
                        <EmptyState Title="@L["Common_Empty"]" Icon="@Icons.Material.Rounded.School" TestId="enrollments-placeholder" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Student_FeatureFlags"]" data-testid="tab-flags">
                        <StudentFeatureFlagsTab Student="_detail" CanEdit="PermState.Has(Permissions.Students.Update)" OnSaved="LoadAsync" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Student_History"]" data-testid="tab-history">
                        <MudTable Items="_detail.StatusHistory" Dense="true" Elevation="0" HeaderClass="lms-table-head" Class="lms-table" data-testid="profile-history">
                            <HeaderContent>
                                <MudTh>@L["Common_Status"]</MudTh>
                                <MudTh>@L["Staff_Reason"]</MudTh>
                                <MudTh>@L["Audit_When"]</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="change">
                                <MudTd DataLabel="@L["Common_Status"]">@L[$"PersonStatus_{change.FromStatus}"] <MudIcon Icon="@(Culture.IsRightToLeft ? Icons.Material.Rounded.ArrowBack : Icons.Material.Rounded.ArrowForward)" Size="Size.Small" Class="align-middle" aria-hidden="true" /> @L[$"PersonStatus_{change.ToStatus}"]</MudTd>
                                <MudTd DataLabel="@L["Staff_Reason"]">@change.Reason</MudTd>
                                <MudTd DataLabel="@L["Audit_When"]"><span class="lms-date-cell"><span dir="ltr">@change.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span></span></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudTabPanel>
                </MudTabs>
            </SectionCard>
        </div>
    </div>
}

@code {
    private StudentDetailDto? _detail;
    private string? _error;

    [Parameter] public Guid Id { get; set; }

    private string AccountState => _detail switch
    {
        null => "",
        { HasAccount: false } => L["Student_NoAccount"],
        { MustChangePassword: true } => L["Student_MustChangePassword"],
        _ => L["Student_AccountActive"],
    };

    /// <summary>The localized country name; an unknown code is shown as it is.</summary>
    private string NationalityName(string code) =>
        Nationalities.Find(code) is { } n ? Culture.Pick(n.NameAr, n.NameEn) : code;

    private string DisplayName => _detail is null ? "" : Culture.Pick(_detail.Summary.NameAr, _detail.Summary.NameEn);

    protected override async Task OnParametersSetAsync()
    {
        PermState.Changed -= OnPermissionsChanged;
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;

    private async Task LoadAsync()
    {
        _error = null;
        await ApiCalls.RunAsync(async () => _detail = await Api.GetAsync(Id), Navigation, L, message => _error = message);
    }

    /// <summary>Runs a write; on success shows the message and reloads, on failure shows the problem as a snackbar.</summary>
    private async Task RunAsync(Func<Task> write, string done)
    {
        var ok = await ApiCalls.RunAsync(write, Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (!ok) return;
        Snackbar.Add(done, Severity.Success);
        await LoadAsync();
    }

    private async Task WithdrawAsync()
    {
        var dialog = await Dialogs.ShowAsync<WithdrawDialog>(L["Lifecycle_Withdraw"],
            new DialogParameters<WithdrawDialog> { { x => x.StudentId, Id }, { x => x.Name, DisplayName } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(string.Format(L["Lifecycle_Withdrawn"].Value, DisplayName), Severity.Success); await LoadAsync(); }
    }

    private async Task GraduateAsync()
    {
        var dialog = await Dialogs.ShowAsync<GraduateDialog>(L["Lifecycle_Graduate"],
            new DialogParameters<GraduateDialog> { { x => x.StudentId, Id }, { x => x.Name, DisplayName } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(string.Format(L["Lifecycle_Graduated"].Value, DisplayName), Severity.Success); await LoadAsync(); }
    }

    private async Task ReadmitAsync()
    {
        var dialog = await Dialogs.ShowAsync<ReadmitDialog>(L["Lifecycle_Readmit"],
            new DialogParameters<ReadmitDialog> { { x => x.StudentId, Id }, { x => x.Name, DisplayName } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(string.Format(L["Lifecycle_Readmitted"].Value, DisplayName), Severity.Success); await LoadAsync(); }
    }

    private async Task EditAsync()
    {
        var dialog = await Dialogs.ShowAsync<EditStudentDialog>(L["Student_Edit"], new DialogParameters<EditStudentDialog> { { x => x.Student, _detail! } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(L["Common_Saved"], Severity.Success); await LoadAsync(); }
    }

    private async Task ChangeStatusAsync()
    {
        var reactivate = _detail!.Summary.Status != PersonStatuses.Active;
        var dialog = await Dialogs.ShowAsync<PersonStatusDialog>(L[reactivate ? "Staff_Reactivate" : "Staff_Deactivate"],
            new DialogParameters<PersonStatusDialog> { { x => x.Name, DisplayName }, { x => x.Reactivate, reactivate } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: string reason })
            await RunAsync(() => Api.SetStatusAsync(Id, new SetPersonStatusRequest(reactivate ? PersonStatuses.Active : PersonStatuses.Deactivated, reason)),
                L["Common_Saved"]);
    }

    /// <summary>Issues a new default password (D24); like create, it is shown once and delivered by the rules of Task 37.</summary>
    private async Task ResetPasswordAsync()
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Student_ResetPassword"], L["Student_ResetPasswordConfirm", DisplayName].Value, L["Student_ResetPassword"])) return;
        StudentCreatedDto? issued = null;
        var ok = await ApiCalls.RunAsync(async () => issued = await Api.ResetPasswordAsync(Id, new ResetStudentPasswordRequest(null)),
            Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (!ok || issued is null) return;
        var dialog = await Dialogs.ShowAsync<CredentialsDialog>(L["Credentials_Title"], new DialogParameters<CredentialsDialog>
        {
            { x => x.Code, issued.Student.Summary.StudentCode },
            { x => x.Password, issued.IssuedPassword },
            { x => x.SentTo, issued.CredentialsSentTo },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], L["Student_DeleteConfirm"], L["Common_Delete"])) return;
        var ok = await ApiCalls.RunAsync(() => Api.DeleteAsync(Id), Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (ok) Navigation.NavigateTo("students");
    }
}
