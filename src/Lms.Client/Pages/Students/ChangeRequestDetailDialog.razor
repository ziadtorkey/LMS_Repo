@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Shared.People
@inject IChangeRequestsApi Api
@inject ICultureService Culture
@inject NavigationManager Navigation

@* Shows the change request as before → after per field; a pending one can be approved (optional comment) or rejected (comment required). *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="dialog-error">@_error</MudAlert>
            }
            <MudText data-testid="detail-student">@Culture.Pick(Request.StudentNameAr, Request.StudentNameEn) (<span dir="ltr">@Request.StudentCode</span>)</MudText>
            <MudTable Items="Request.Changes" Dense="true" Breakpoint="Breakpoint.Xs" data-testid="detail-changes">
                <HeaderContent>
                    <MudTh>@L["MyProfile_Fields"]</MudTh>
                    <MudTh>@L["ChangeRequest_Before"]</MudTh>
                    <MudTh>@L["ChangeRequest_After"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="change">
                    <MudTd DataLabel="@L["MyProfile_Fields"]">@L[$"StudentField_{change.Field}"]</MudTd>
                    <MudTd DataLabel="@L["ChangeRequest_Before"]" data-testid="@($"before-{change.Field}")">@StudentFieldText.Display(change.Field, change.Before, Text)</MudTd>
                    <MudTd DataLabel="@L["ChangeRequest_After"]" data-testid="@($"after-{change.Field}")">@StudentFieldText.Display(change.Field, change.After, Text)</MudTd>
                </RowTemplate>
            </MudTable>
            @if (!string.IsNullOrWhiteSpace(Request.Note))
            {
                <MudText data-testid="detail-note"><strong>@L["ChangeRequest_Note"]:</strong> @Request.Note</MudText>
            }
            @if (Request.Status == ChangeRequestStatuses.Pending)
            {
                <MudTextField T="string" @bind-Value="_comment" Label="@L["ChangeRequest_Comment"]" Lines="3" MaxLength="500"
                              Error="_commentError" ErrorText="@L["ChangeRequest_CommentRequired"]" data-testid="decision-comment" />
            }
            else
            {
                <MudText data-testid="detail-decided">@L[$"ChangeRequestStatus_{Request.Status}"]@(string.IsNullOrWhiteSpace(Request.DecisionComment) ? "" : ": " + Request.DecisionComment)</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <div class="lms-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="() => MudDialog.Cancel()" data-testid="dialog-cancel">@L["Common_Close"]</MudButton>
            @if (Request.Status == ChangeRequestStatuses.Pending)
            {
                <MudButton Color="Color.Error" OnClick="RejectAsync" Disabled="_saving" data-testid="decision-reject">@L["ChangeRequest_Reject"]</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApproveAsync" Disabled="_saving"
                           data-testid="decision-approve">@L["ChangeRequest_Approve"]</MudButton>
            }
    
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public StudentChangeRequestDto Request { get; set; } = default!;

    private string _comment = "";
    private bool _commentError, _saving;
    private string? _error;

    private string Text(string key) => L[key].Value;

    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private Task ApproveAsync() => DecideAsync(() => Api.ApproveAsync(Request.Id, new DecideChangeRequestRequest(Blank(_comment))));

    private Task RejectAsync()
    {
        _commentError = string.IsNullOrWhiteSpace(_comment);
        return _commentError ? Task.CompletedTask : DecideAsync(() => Api.RejectAsync(Request.Id, new DecideChangeRequestRequest(Blank(_comment))));
    }

    /// <summary>change_request_stale / change_request_closed come back as problems and are shown as the localized message.</summary>
    private async Task DecideAsync(Func<Task> decide)
    {
        _error = null;
        _saving = true;
        var ok = await ApiCalls.RunAsync(decide, Navigation, L, message => _error = message);
        _saving = false;
        if (ok) MudDialog.Close(DialogResult.Ok(true));
    }
}
