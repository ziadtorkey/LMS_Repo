@page "/students/import"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Components.Imports
@using Lms.Shared.Authorization
@using Lms.Shared.Imports
@implements IDisposable
@inject PermissionState PermState

<PageTitle>@L["StudentImport_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Students.Import))
{
    <Forbidden />
}
else
{
    <MudLink Href="students" Typo="Typo.body2" Class="lms-back-link" data-testid="student-import-back">
        <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
        @L["Student_BackToList"]
    </MudLink>
    <PageHeader Title="@L["StudentImport_Title"]" Subtitle="@L["StudentImport_Subtitle"]" TitleTestId="student-import-title" />
    <ImportWizard Kind="@ImportKinds.Students" TitleKey="StudentImport_Title" ShowTitle="false">
        <Help>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="student-import-help">
                <MudText Typo="Typo.body2">@L["StudentImport_Help"]</MudText>
                <MudText Typo="Typo.body2" Class="mt-2"><strong>ClassCode:</strong> @L["StudentImport_HelpClassCode"]</MudText>
                <MudText Typo="Typo.body2" Class="mt-2"><strong>DefaultPassword:</strong> @L["StudentImport_HelpPassword"]</MudText>
            </MudAlert>
        </Help>
        <DoneContent Context="batch">
            @* The generated passwords exist only in the commit result: the sheet is offered right after the commit, once. *@
            <CredentialsSheetButton Kind="@ImportKinds.Students" BatchId="batch.Id" />
        </DoneContent>
    </ImportWizard>
    <ImportHistory Kind="@ImportKinds.Students" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
