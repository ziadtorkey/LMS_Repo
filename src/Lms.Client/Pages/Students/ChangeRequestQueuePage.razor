@page "/student-change-requests"
@attribute [Authorize]
@using System.Globalization
@using Lms.Client.Components
@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.People
@implements IDisposable
@inject IChangeRequestsApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture

<PageTitle>@L["Nav_ChangeRequests"]</PageTitle>
@if (!PermState.Loaded)
{
    <LoadingState Lines="4" TestId="queue-loading" />
}
else if (!PermState.Has(Permissions.Students.ApproveChanges))
{
    <Forbidden />
}
else
{
    <PageHeader Title="@L["Nav_ChangeRequests"]" Subtitle="@L["ChangeRequests_Subtitle"]" TitleTestId="queue-title" />

    <ListCountStat Label="@L["ChangeRequests_StatTotal"]" Value="_total" Icon="@Icons.Material.Rounded.EditNote" TestId="queue-stat-total" />


    <SectionCard Flush="true">
        <div class="lms-filters" role="search" aria-label="@L["Common_Filters"]">
            <div class="lms-filter">
                <UnitPicker Value="_unitId" ValueChanged="OnUnitChanged" Label="@L["Staff_HomeUnit"]" Clearable="true" TestId="queue-filter-unit" />
            </div>
            <div class="lms-filter">
                <MudSelect T="string" Value="_status" ValueChanged="OnStatusChanged" Label="@L["Common_Status"]" Clearable="true"
                           data-testid="queue-filter-status">
                    @foreach (var status in ChangeRequestStatuses.All)
                    {
                        <MudSelectItem T="string" Value="@status">@L[$"ChangeRequestStatus_{status}"]</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>
        <ServerTable @ref="_table" T="StudentChangeRequestDto" ServerData="LoadAsync" EmptyTitle="@L["ChangeRequests_EmptyTitle"]"
                     EmptyText="@L["ChangeRequests_EmptyText"]" EmptyIcon="@Icons.Material.Rounded.EditNote">
            <HeaderContent>
                <MudTh>@L["Common_Name"]</MudTh>
                <MudTh>@L["Student_Code"]</MudTh>
                <MudTh>@L["Staff_HomeUnit"]</MudTh>
                <MudTh>@L["MyProfile_Fields"]</MudTh>
                <MudTh>@L["Common_Status"]</MudTh>
                <MudTh>@L["Audit_When"]</MudTh>
                <MudTh><span class="lms-visually-hidden">@L["Common_Actions"]</span></MudTh>
            </HeaderContent>
            <RowTemplate Context="request">
                <MudTd DataLabel="@L["Common_Name"]"><span class="lms-cell-strong">@Culture.Pick(request.StudentNameAr, request.StudentNameEn)</span></MudTd>
                <MudTd DataLabel="@L["Student_Code"]"><span dir="ltr" class="lms-muted">@request.StudentCode</span></MudTd>
                <MudTd DataLabel="@L["Staff_HomeUnit"]">@Culture.Pick(request.HomeOrgUnitNameAr, request.HomeOrgUnitNameEn)</MudTd>
                <MudTd DataLabel="@L["MyProfile_Fields"]">@string.Join("، ", request.Changes.Select(c => L[$"StudentField_{c.Field}"].Value))</MudTd>
                <MudTd DataLabel="@L["Common_Status"]" data-testid="@($"queue-status-{request.Id}")">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColor(request.Status)">@L[$"ChangeRequestStatus_{request.Status}"]</MudChip>
                </MudTd>
                <MudTd DataLabel="@L["Audit_When"]"><span class="lms-date-cell"><span dir="ltr">@request.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span></span></MudTd>
                <MudTd Class="lms-cell-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenAsync(request)"
                               data-testid="@($"queue-open-{request.Id}")">@L["ChangeRequest_Review"]</MudButton>
                </MudTd>
            </RowTemplate>
        </ServerTable>
    </SectionCard>
}

@code {
    private int? _total;
    private ServerTable<StudentChangeRequestDto> _table = default!;
    private Guid? _unitId;
    private string? _status = ChangeRequestStatuses.Pending;

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;

    private async Task<TableData<StudentChangeRequestDto>> LoadAsync(TableState state, CancellationToken ct)
    {
        var result = await Api.ListAsync(new ChangeRequestQuery(_unitId, _status, state.Page + 1, state.PageSize), ct);
        if (_total != result.Total) { _total = result.Total; await InvokeAsync(StateHasChanged); }
        return new TableData<StudentChangeRequestDto> { Items = result.Items, TotalItems = result.Total };
    }

    private static Color StatusColor(string status) => status switch
    {
        ChangeRequestStatuses.Pending => Color.Warning,
        ChangeRequestStatuses.Approved => Color.Success,
        ChangeRequestStatuses.Rejected => Color.Error,
        _ => Color.Default,
    };

    private Task OnUnitChanged(Guid? id) { _unitId = id; return _table.ReloadAsync(); }
    private Task OnStatusChanged(string? status) { _status = status; return _table.ReloadAsync(); }

    private async Task OpenAsync(StudentChangeRequestDto request)
    {
        var dialog = await Dialogs.ShowAsync<ChangeRequestDetailDialog>(L["ChangeRequest_Review"],
            new DialogParameters<ChangeRequestDetailDialog> { { x => x.Request, request } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(L["Common_Saved"], Severity.Success); await _table.ReloadAsync(); }
    }
}
