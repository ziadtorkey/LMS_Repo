@page "/academic-years"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.AcademicYears
@using Lms.Shared.Authorization
@using Lms.Shared.Organizations
@implements IDisposable
@inject IYearsApi Api
@inject IUnitLookupApi UnitsApi
@inject PermissionState Perms
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@L["Years_Title"]</PageTitle>
<PageHeader Title="@L["Years_Title"]" Subtitle="@L["Years_Subtitle"]">
    <Actions>
        @if (CanCreateHere)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add"
                       OnClick="() => OpenYearAsync(null)" data-testid="year-new">@L["Years_New"]</MudButton>
        }
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingState Lines="5" />
}
else if (_failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="api-error">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>@L["Api_Error"]</span>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Refresh"
                       OnClick="LoadAsync">@L["Common_Retry"]</MudButton>
        </div>
    </MudAlert>
}
else
{
    @if (_hasPicker)
    {
        <div class="lms-years-toolbar">
            <MudSelect T="Guid" Value="_unitId" ValueChanged="UnitChangedAsync" Label="@L["Assignments_Unit"]"
                       AdornmentIcon="@Icons.Material.Rounded.AccountTree" Adornment="Adornment.Start" data-testid="unit-picker">
                @foreach (var unit in _units)
                {
                    <MudSelectItem Value="@unit.Id">@(new string(' ', unit.Depth * 3) + CultureText.Pick(unit.NameAr, unit.NameEn))</MudSelectItem>
                }
            </MudSelect>
        </div>
    }

    @if (_context is { } ctx)
    {
        @if (Inherited)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" data-testid="years-inherited">
                <div class="d-flex align-center flex-wrap gap-2">
                    <span>@string.Format(L["Years_DefinedAt"], DefiningUnitName)</span>
                    @if (Perms.Has(Permissions.AcademicYears.Create))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="() => OpenYearAsync(null)"
                                   data-testid="years-define-own">@L["Years_DefineOwn"]</MudButton>
                    }
                </div>
            </MudAlert>
        }

        @if (ctx.Years.Count == 0)
        {
            <SectionCard>
                <EmptyState Title="@L["Years_Empty"]" Text="@(CanCreateHere ? L["Years_EmptyHint"].Value : null)" Icon="@Icons.Material.Rounded.CalendarMonth"
                            TestId="years-empty" />
            </SectionCard>
        }
        @if (Headline is { } head)
        {
            @* The Stitch dashboard row, from the year's own data (no invented figures): the year that is running now (else the first one). *@
            <div class="lms-stats" data-testid="years-stats">
                <div class="lms-stat" data-testid="stat-year">
                    <div>
                        <div class="lms-stat-label">@L["Years_StatCurrent"]</div>
                        <div class="lms-stat-value">@CultureText.Pick(head.NameAr, head.NameEn)</div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColor(head.Status)" Class="lms-status-chip">@L[$"YearStatus_{head.Status}"]</MudChip>
                    </div>
                    <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" /></span>
                </div>
                <div class="lms-stat" data-testid="stat-days">
                    <div>
                        <div class="lms-stat-label">@L["Years_StatDays"]</div>
                        <div class="lms-stat-value">@(head.EndDate.DayNumber - head.StartDate.DayNumber + 1)</div>
                    </div>
                    <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.DateRange" /></span>
                </div>
                <div class="lms-stat" data-testid="stat-terms">
                    <div>
                        <div class="lms-stat-label">@L["Years_StatTerms"]</div>
                        <div class="lms-stat-value">@head.Terms.Count</div>
                    </div>
                    <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.ViewTimeline" /></span>
                </div>
                @* The term the server judges current (no clock here: the browser's date is not the school's). *@
                @if (head.Terms.FirstOrDefault(t => t.IsCurrent) is { } current)
                {
                    <div class="lms-stat" data-testid="stat-term">
                        <div>
                            <div class="lms-stat-label">@L["Years_StatCurrentTerm"]</div>
                            <div class="lms-stat-value lms-stat-text">@CultureText.Pick(current.NameAr, current.NameEn)</div>
                            <div class="lms-muted lms-stat-sub" dir="ltr">@current.StartDate.ToString("yyyy-MM-dd") – @current.EndDate.ToString("yyyy-MM-dd")</div>
                        </div>
                        <span class="lms-stat-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.EventAvailable" /></span>
                    </div>
                }
            </div>
        }
        <div class="lms-years">
            @foreach (var year in ctx.Years)
            {
                var y = year;
                var closed = y.Status == AcademicYearStatuses.Closed;
                var editable = !y.IsInherited && !closed && Perms.Has(Permissions.AcademicYears.Update);
                var calendarEditable = !closed && Perms.Has(Permissions.AcademicYears.Update); // a unit may add entries to an inherited year
                <section class="lms-section lms-year" data-testid="@($"year-{y.Id}")">
                    <div class="lms-year-head">
                        <div class="lms-year-title">
                            <span class="lms-section-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" Size="Size.Small" /></span>
                            @* The year name stays an h6: the E2E page object finds a year by its h6 text. *@
                            <MudText Typo="Typo.h6" Class="lms-section-title">@CultureText.Pick(y.NameAr, y.NameEn)</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColor(y.Status)" Class="lms-status-chip"
                                     data-testid="@($"year-status-{y.Id}")" data-status="@y.Status">
                                @L[$"YearStatus_{y.Status}"]
                            </MudChip>
                            @if (closed)
                            {
                                <MudTooltip Text="@L["Years_ClosedHint"]">
                                    <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" Class="lms-muted" title="@L["Years_ClosedHint"]"
                                             data-testid="@($"year-lock-{y.Id}")" />
                                </MudTooltip>
                            }
                            <span class="lms-year-dates lms-muted" dir="ltr">
                                <MudIcon Icon="@Icons.Material.Rounded.DateRange" Size="Size.Small" aria-hidden="true" />
                                @y.StartDate.ToString("yyyy-MM-dd") – @y.EndDate.ToString("yyyy-MM-dd")
                            </span>
                        </div>
                        @if (editable)
                        {
                            <div class="lms-row-actions">
                                @if (y.Status == AcademicYearStatuses.Planned)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PlayArrow"
                                               OnClick="() => ActivateAsync(y)" data-testid="@($"year-activate-{y.Id}")">@L["Years_Activate"]</MudButton>
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Edit" OnClick="() => OpenYearAsync(y)"
                                           data-testid="@($"year-edit-{y.Id}")">@L["Common_Edit"]</MudButton>
                                @if (y.Status == AcademicYearStatuses.Planned && Perms.Has(Permissions.AcademicYears.Delete))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Rounded.DeleteOutline"
                                               OnClick="() => DeleteAsync(y)" data-testid="@($"year-delete-{y.Id}")">@L["Common_Delete"]</MudButton>
                                }
                            </div>
                        }
                    </div>
                    <div class="lms-year-body">
                        <TermsPanel Year="y" CanEdit="editable" OnChanged="LoadAsync" />
                        <CalendarPanel Year="y" UnitId="@(_hasPicker ? _unitId : null)" CanEdit="calendarEditable" />
                    </div>
                </section>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<OrgUnitNodeDto> _units = [];
    private YearContextDto? _context;
    private Guid _unitId;
    private bool _loading = true, _failed, _hasPicker;

    [Parameter, SupplyParameterFromQuery(Name = "unit")] public Guid? UnitId { get; set; }

    /// <summary>The year the dashboard row describes: the active one, else the first.</summary>
    private AcademicYearDto? Headline => _context is { Years.Count: > 0 } c ? c.Years.FirstOrDefault(y => y.Status == AcademicYearStatuses.Active) ?? c.Years[0] : null;

    private bool Inherited => _hasPicker && _context is { } c && c.DefiningOrgUnitId != _unitId;
    private bool CanCreateHere => !_loading && !_failed && _hasPicker && _unitId != Guid.Empty && Perms.Has(Permissions.AcademicYears.Create) && !Inherited;
    /// <summary>Name of the unit that defines the years, taken from the years themselves (it may not be in the user's unit list).</summary>
    private string DefiningUnitName => _context?.Years.FirstOrDefault(y => y.OrgUnitId == _context.DefiningOrgUnitId) is { } y
        ? CultureText.Pick(y.OrgUnitNameAr, y.OrgUnitNameEn) : "";

    protected override async Task OnInitializedAsync()
    {
        Perms.Changed += OnPermissionsChanged;
        if (!Perms.Loaded) await Perms.RefreshAsync();
        // Only users who may see units get the unit picker (listing units needs OrgUnits.View); everyone else
        // sees the years of their own context unit.
        _hasPicker = Perms.Has(Permissions.OrgUnits.View);
        if (_hasPicker)
        {
            var (units, failed) = await ApiCalls.RunAsync(() => UnitsApi.GetUnitsAsync(), Navigation);
            _failed = failed;
            _units = UnitTree.Order(units ?? []);
            _unitId = UnitId is { } q && _units.Any(u => u.Id == q) ? q : _units.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_hasPicker && _unitId == Guid.Empty) { _loading = false; return; }
        _loading = true; _failed = false;
        var (context, failed) = await ApiCalls.RunAsync(() => Api.GetEffectiveAsync(_hasPicker ? _unitId : null), Navigation);
        _failed = failed;
        _context = context;
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UnitChangedAsync(Guid id) { _unitId = id; await LoadAsync(); }

    private Task OpenYearAsync(AcademicYearDto? year) =>
        DialogFlow.ShowAsync(Dialogs, year is null ? L["Years_New"] : L["Common_Edit"],
            new DialogParameters<YearDialog> { { x => x.UnitId, _unitId }, { x => x.Existing, year } },
            () => { Snackbar.Add(L["Common_Saved"], Severity.Success); return LoadAsync(); });

    private async Task ActivateAsync(AcademicYearDto year)
    {
        if (await ApiCalls.RunAsync(() => Api.ActivateYearAsync(year.Id), Navigation, L, m => Snackbar.Add(m, Severity.Error)))
            await LoadAsync();
    }

    private async Task DeleteAsync(AcademicYearDto year)
    {
        var name = CultureText.Pick(year.NameAr, year.NameEn);
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], string.Format(L["Years_DeleteConfirm"], name))) return;
        if (await ApiCalls.RunAsync(() => Api.DeleteYearAsync(year.Id), Navigation, L, m => Snackbar.Add(m, Severity.Error)))
            await LoadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        AcademicYearStatuses.Active => Color.Success,
        AcademicYearStatuses.Planned => Color.Info,
        _ => Color.Default,
    };

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Perms.Changed -= OnPermissionsChanged;
}
