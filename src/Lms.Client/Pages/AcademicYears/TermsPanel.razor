@using Lms.Client.Components
@using Lms.Shared.AcademicYears
@using Lms.Client.Services.Api
@inject IYearsApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudStack Spacing="1" data-testid="@($"terms-{Year.Id}")">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.subtitle1">@L["Terms_Title"]</MudText>
        @if (CanEdit)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenAsync(null)"
                       data-testid="@($"term-new-{Year.Id}")">@L["Terms_New"]</MudButton>
        }
    </MudStack>
    @if (Year.Terms.Count == 0)
    {
        <MudText Typo="Typo.body2">@L["Common_Empty"]</MudText>
    }
    @foreach (var term in Year.Terms)
    {
        var t = term;
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudText>@CultureText.Pick(t.NameAr, t.NameEn)</MudText>
            <MudText Typo="Typo.body2" dir="ltr">@t.StartDate.ToString("yyyy-MM-dd") – @t.EndDate.ToString("yyyy-MM-dd")</MudText>
            @if (t.IsCurrent)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" data-testid="@($"term-current-{t.Id}")">@L["Terms_Current"]</MudChip>
            }
            @if (CanEdit)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Common_Edit"]"
                               OnClick="() => OpenAsync(t)" data-testid="@($"term-edit-{t.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Common_Delete"]"
                               OnClick="() => DeleteAsync(t)" data-testid="@($"term-delete-{t.Id}")" />
            }
        </MudStack>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public AcademicYearDto Year { get; set; } = default!;
    /// <summary>False for inherited or closed years, or without AcademicYears.Update.</summary>
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task OpenAsync(TermDto? term) =>
        DialogFlow.ShowAsync(Dialogs, term is null ? L["Terms_New"] : L["Common_Edit"],
            new DialogParameters<TermDialog> { { x => x.YearId, Year.Id }, { x => x.Existing, term } },
            () => OnChanged.InvokeAsync());

    private async Task DeleteAsync(TermDto term)
    {
        var name = CultureText.Pick(term.NameAr, term.NameEn);
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], string.Format(L["Terms_DeleteConfirm"], name))) return;
        if (await ActionCalls.TryAsync(() => Api.DeleteTermAsync(term.Id), Navigation, L, m => Snackbar.Add(m, Severity.Error)))
            await OnChanged.InvokeAsync();
    }
}
