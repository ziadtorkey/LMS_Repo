@using Lms.Client.Components
@using Lms.Shared.AcademicYears
@using Lms.Client.Services.Api
@inject IYearsApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<div class="lms-year-panel" data-testid="@($"terms-{Year.Id}")">
    <div class="lms-year-panel-head">
        <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="lms-year-panel-title">@L["Terms_Title"]</MudText>
        @if (CanEdit)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => OpenAsync(null)"
                       data-testid="@($"term-new-{Year.Id}")">@L["Terms_New"]</MudButton>
        }
    </div>
    @if (Year.Terms.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="lms-muted lms-year-empty">@L["Terms_Empty"]</MudText>
    }
    <ul class="lms-item-list">
        @foreach (var term in Year.Terms)
        {
            var t = term;
            <li class="lms-item @(t.IsCurrent ? "lms-item-current" : null)">
                <div class="lms-item-main">
                    <span class="lms-cell-strong">@CultureText.Pick(t.NameAr, t.NameEn)</span>
                    @if (t.IsCurrent)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success" Class="lms-status-chip"
                                 data-testid="@($"term-current-{t.Id}")">@L["Terms_Current"]</MudChip>
                    }
                    <span class="lms-item-meta lms-muted" dir="ltr">@t.StartDate.ToString("yyyy-MM-dd") – @t.EndDate.ToString("yyyy-MM-dd")</span>
                </div>
                @if (CanEdit)
                {
                    <div class="lms-row-actions">
                        <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" aria-label="@L["Common_Edit"]"
                                       OnClick="() => OpenAsync(t)" data-testid="@($"term-edit-{t.Id}")" />
                        <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Color="Color.Error" aria-label="@L["Common_Delete"]"
                                       OnClick="() => DeleteAsync(t)" data-testid="@($"term-delete-{t.Id}")" />
                    </div>
                }
            </li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public AcademicYearDto Year { get; set; } = default!;
    /// <summary>False for inherited or closed years, or without AcademicYears.Update.</summary>
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task OpenAsync(TermDto? term) =>
        DialogFlow.ShowAsync(Dialogs, term is null ? L["Terms_New"] : L["Common_Edit"],
            new DialogParameters<TermDialog> { { x => x.YearId, Year.Id }, { x => x.Existing, term } },
            () => OnChanged.InvokeAsync());

    private async Task DeleteAsync(TermDto term)
    {
        var name = CultureText.Pick(term.NameAr, term.NameEn);
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], string.Format(L["Terms_DeleteConfirm"], name))) return;
        if (await ApiCalls.RunAsync(() => Api.DeleteTermAsync(term.Id), Navigation, L, m => Snackbar.Add(m, Severity.Error)))
            await OnChanged.InvokeAsync();
    }
}
