@page "/messages"
@page "/messages/{Id:guid}"
@page "/messages/new"
@attribute [Authorize]
@using Lms.Client.Components.Messaging
@using Lms.Client.Services.Messaging
@using Lms.Shared.Authorization
@using Lms.Shared.Messaging
@inject IMessagingApi Messaging
@inject IMessagingState State
@inject PermissionState PermState
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>@L["Msg_Page_Title"]</PageTitle>
<PageHeader Title="@L["Msg_Page_Title"]" Subtitle="@L["Msg_Page_Subtitle"]" TitleTestId="messages-title">
    <Actions>
        @if (PermState.Has(Permissions.Messaging.Send))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Edit" OnClick="() => NewAsync(null)" data-testid="messages-new">@L["Msg_New_Message"]</MudButton>
        }
    </Actions>
</PageHeader>
@if (_unavailable)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" data-testid="messages-unavailable">@L["Msg_Recipient_Unavailable"]</MudAlert>
}

@if (!PermState.Loaded || _loading)
{
    <LoadingState Lines="6" TestId="messages-loading" />
}
else if (!PermState.Has(Permissions.Messaging.View))
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="messages-forbidden">@L["Forbidden_Title"]</MudAlert>
}
else if (_failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="messages-error">
        @L["Error_Generic"] <MudButton Variant="Variant.Text" OnClick="LoadAsync">@L["Common_Retry"]</MudButton>
    </MudAlert>
}
else
{
    <InboxLayout ShowThread="Id is not null">
        <List>
            <ConversationListPane Items="_inbox" CurrentId="Id" Total="_total" />
        </List>
        <Thread>
            @if (Id is { } id)
            {
                <ThreadPaneHost @key="id" ConversationId="id" UnreadCount="UnreadOf(id)" OnChanged="ChangedAsync" />
            }
            else
            {
                <EmptyState Title="@L["Msg_Pick_Title"]" Text="@L["Msg_Pick_Text"]" Icon="@Icons.Material.Rounded.Forum" TestId="messages-pick" Class="lms-thread-empty" />
            }
        </Thread>
    </InboxLayout>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    /// <summary>/messages/new?to=: the person to write to. The deep link opens the form with them picked, or says, without a name, that they cannot be reached.</summary>
    [SupplyParameterFromQuery(Name = "to")] public Guid? To { get; set; }

    private IReadOnlyList<ConversationListItemDto> _inbox = [];
    private int _total;
    private bool _loading = true, _failed;
    private Guid? _unreadFor;
    private int _unreadAtOpen;
    private bool _unavailable, _newOpened;

    protected override async Task OnInitializedAsync()
    {
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (!IsNewRoute) _newOpened = false; // leaving /messages/new and coming back (a link from a profile) opens the form again
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_newOpened || _loading || !PermState.Loaded || !IsNewRoute) return;
        _newOpened = true;
        RecipientDto? person = null;
        if (To is { } to)
        {
            var (people, _) = await ApiCalls.RunAsync(() => Messaging.GetRecipientsAsync(), Navigation);
            person = people?.FirstOrDefault(p => p.UserId == to);
            if (person is null) { _unavailable = true; StateHasChanged(); return; } // no name, no reason: the same words for every refusal
        }
        await NewAsync(person);
    }

    private bool IsNewRoute => new Uri(Navigation.Uri).AbsolutePath.EndsWith("/messages/new", StringComparison.OrdinalIgnoreCase);

    private async Task NewAsync(RecipientDto? person)
    {
        var dialog = await Dialogs.ShowAsync<NewConversationDialog>(L["Msg_New_Message"],
            new DialogParameters<NewConversationDialog> { { x => x.Preselected, person } }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Guid created }) Navigation.NavigateTo($"messages/{created}");
        else if (Id is null && IsNewRoute) Navigation.NavigateTo("messages");
    }

    /// <summary>The unread count of the conversation as the list showed it when it was opened; later refreshes (after it was marked read) do not move the divider.</summary>
    private int UnreadOf(Guid id)
    {
        if (_unreadFor != id)
        {
            _unreadFor = id;
            _unreadAtOpen = _inbox.FirstOrDefault(c => c.Id == id)?.UnreadCount ?? 0;
        }
        return _unreadAtOpen;
    }

    private async Task LoadAsync()
    {
        _loading = true; _failed = false;
        if (PermState.Has(Permissions.Messaging.View))
        {
            var (page, failed) = await ApiCalls.RunAsync(() => Messaging.ListConversationsAsync(1, 100), Navigation);
            _failed = failed;
            if (page is not null) { _inbox = page.Items; _total = page.Total; }
        }
        _loading = false;
    }

    private async Task ChangedAsync()
    {
        var (page, _) = await ApiCalls.RunAsync(() => Messaging.ListConversationsAsync(1, 100), Navigation);
        if (page is not null) { _inbox = page.Items; _total = page.Total; }
        await State.RefreshAsync();
        StateHasChanged();
    }
}
