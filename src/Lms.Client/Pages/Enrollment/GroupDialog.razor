@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Courses
@using Lms.Shared.Enrollment
@using Lms.Shared.People
@inject IGroupsApi Api
@inject NavigationManager Navigation

@* Creates or renames a group of a class course; an optional match (restriction type and value) lets the members dialog suggest students. *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="dialog-error">@_error</MudAlert>
                }
                <BilingualNameFields @bind-NameAr="_nameAr" @bind-NameEn="_nameEn" IdPrefix="group-name" />
                <MudSelect T="string" Value="_matchType" ValueChanged="OnTypeChanged" Label="@L["Group_MatchType"]" Clearable="true" data-testid="group-match-type">
                    @foreach (var type in CourseRestrictionTypes.All)
                    {
                        <MudSelectItem T="string" Value="@type">@L[$"RestrictionType_{type}"]</MudSelectItem>
                    }
                </MudSelect>
                @if (_matchType is CourseRestrictionTypes.Gender or CourseRestrictionTypes.Religion)
                {
                    <MudSelect T="string" @bind-Value="_matchValue" Label="@L["Group_MatchValue"]" Required="true" RequiredError="@L["Common_Required"]"
                               data-testid="group-match-value">
                        @foreach (var value in _matchType == CourseRestrictionTypes.Gender ? Genders.All : Religions.All)
                        {
                            <MudSelectItem T="string" Value="@value">@L[$"{(_matchType == CourseRestrictionTypes.Gender ? "Gender" : "Religion")}_{value}"]</MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (_matchType is not null)
                {
                    <MudTextField T="string" @bind-Value="_matchValue" Label="@L["Group_MatchValue"]" Required="true" RequiredError="@L["Common_Required"]"
                                  MaxLength="100" dir="ltr" data-testid="group-match-value" />
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <div class="lms-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="() => MudDialog.Cancel()" data-testid="dialog-cancel">@L["Common_Cancel"]</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving" data-testid="dialog-save">@L["Common_Save"]</MudButton>
    
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid ClassCourseId { get; set; }

    /// <summary>The group being edited; null = a new group.</summary>
    [Parameter] public StudentGroupDto? Existing { get; set; }

    private MudForm _form = default!;
    private string _nameAr = "", _nameEn = "";
    private string? _matchType, _matchValue, _error;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Existing is not { } g) return;
        (_nameAr, _nameEn, _matchType, _matchValue) = (g.NameAr, g.NameEn, g.MatchType, g.MatchValue);
    }

    private void OnTypeChanged(string? type)
    {
        if (type != _matchType) _matchValue = null;
        _matchType = type;
    }

    private async Task SaveAsync()
    {
        _error = null;
        await _form.ValidateAsync();
        if (!_form.IsValid || (_matchType is not null && string.IsNullOrWhiteSpace(_matchValue))) return;
        var request = new SaveGroupRequest(_nameAr.Trim(), _nameEn.Trim(), _matchType, _matchType is null ? null : _matchValue?.Trim());

        _saving = true;
        var saved = await ApiCalls.RunAsync(
            async () =>
            {
                if (Existing is null) await Api.CreateAsync(ClassCourseId, request);
                else await Api.UpdateAsync(Existing.Id, request);
            },
            Navigation, L, message => _error = message);
        _saving = false;
        if (saved) MudDialog.Close(DialogResult.Ok(true));
    }
}
