@using System.Globalization
@using Lms.Client.Services.Api
@using Lms.Shared.Enrollment
@using Lms.Shared.People
@inject IEnrollmentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ICultureService Culture
@inject NavigationManager Navigation

@* The student's side of enrollment: course enrollments with their source and status, and the history of transfers between classes. *@
<MudStack Spacing="3" data-testid="student-enrollments-tab">
    @if (CanTransfer && Student.Summary.CurrentClassId is not null)
    {
        <div>
            <MudButton Variant="Variant.Outlined" OnClick="TransferAsync" data-testid="student-transfer">@L["Transfer_Title"]</MudButton>
        </div>
    }
    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" data-testid="api-error">@L["Api_Error"]</MudAlert>
    }

    <MudText Typo="Typo.h6">@L["Enrollment_Title"]</MudText>
    @if (_enrollments.Count == 0)
    {
        <MudText data-testid="enrollments-empty">@L["Common_Empty"]</MudText>
    }
    else
    {
        <MudTable Items="_enrollments" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" data-testid="enrollments-table">
            <HeaderContent>
                <MudTh>@L["Enrollment_Course"]</MudTh>
                <MudTh>@L["Student_Class"]</MudTh>
                <MudTh>@L["Enrollment_Source"]</MudTh>
                <MudTh>@L["Common_Status"]</MudTh>
                <MudTh>@L["Enrollment_From"]</MudTh>
                <MudTh>@L["Enrollment_To"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="e">
                <MudTd DataLabel="@L["Enrollment_Course"]">@Culture.Pick(e.CourseNameAr, e.CourseNameEn) (<span dir="ltr">@e.CourseCode</span>)</MudTd>
                <MudTd DataLabel="@L["Student_Class"]">@Culture.Pick(e.ClassNameAr, e.ClassNameEn)</MudTd>
                <MudTd DataLabel="@L["Enrollment_Source"]" data-testid="@($"enrollment-source-{e.CourseCode}")">@L[$"EnrollmentSource_{e.Source}"]</MudTd>
                <MudTd DataLabel="@L["Common_Status"]" data-testid="@($"enrollment-status-{e.CourseCode}")">
                    @L[$"EnrollmentStatus_{e.Status}"]
                    @if (!string.IsNullOrWhiteSpace(e.DropReason))
                    {
                        <MudText Typo="Typo.caption">@e.DropReason</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Enrollment_From"]"><span dir="ltr">@e.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span></MudTd>
                <MudTd DataLabel="@L["Enrollment_To"]"><span dir="ltr">@e.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span></MudTd>
                <MudTd>
                    @if (CanManage && e.Status == EnrollmentStatuses.Active)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DropAsync(e)"
                                   data-testid="@($"enrollment-drop-{e.CourseCode}")">@L["Enrollment_Drop"]</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudText Typo="Typo.h6">@L["Transfer_History"]</MudText>
    @if (_transfers.Count == 0)
    {
        <MudText data-testid="transfers-empty">@L["Common_Empty"]</MudText>
    }
    else
    {
        <MudTable Items="_transfers" Dense="true" Breakpoint="Breakpoint.Sm" data-testid="transfers-table">
            <HeaderContent>
                <MudTh>@L["Enrollment_EffectiveOn"]</MudTh>
                <MudTh>@L["Transfer_From"]</MudTh>
                <MudTh>@L["Transfer_ToClass"]</MudTh>
                <MudTh>@L["Staff_Reason"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="t">
                <MudTd DataLabel="@L["Enrollment_EffectiveOn"]"><span dir="ltr">@t.EffectiveOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span></MudTd>
                <MudTd DataLabel="@L["Transfer_From"]">@Culture.Pick(t.FromClassNameAr, t.FromClassNameEn)</MudTd>
                <MudTd DataLabel="@L["Transfer_ToClass"]">@Culture.Pick(t.ToClassNameAr, t.ToClassNameEn)</MudTd>
                <MudTd DataLabel="@L["Staff_Reason"]">@t.Reason</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    private IReadOnlyList<EnrollmentDto> _enrollments = [];
    private IReadOnlyList<StudentTransferDto> _transfers = [];
    private bool _failed;

    [Parameter, EditorRequired] public StudentDetailDto Student { get; set; } = default!;

    /// <summary>True with Enrollment.Manage: dropping an enrollment.</summary>
    [Parameter] public bool CanManage { get; set; }

    /// <summary>True with Enrollment.Transfer.</summary>
    [Parameter] public bool CanTransfer { get; set; }

    /// <summary>The student's current academic year (for the transfer targets).</summary>
    [Parameter] public Guid? AcademicYearId { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _failed = false;
        var id = Student.Summary.Id;
        var failed = !await ApiCalls.RunAsync(async () =>
        {
            _enrollments = (await Api.ListEnrollmentsAsync(new EnrollmentQuery(id, null, null, 1, 200))).Items;
            _transfers = await Api.ListTransfersAsync(id);
        }, Navigation, L, _ => { });
        _failed = failed;
    }

    private async Task DropAsync(EnrollmentDto enrollment)
    {
        var dialog = await Dialogs.ShowAsync<ReasonDialog>(L["Enrollment_Drop"],
            new DialogParameters<ReasonDialog>
            {
                { x => x.Message, L["Enrollment_DropConfirm", Culture.Pick(enrollment.CourseNameAr, enrollment.CourseNameEn)].Value },
                { x => x.ConfirmText, L["Enrollment_Drop"] },
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: ReasonResult reason }) return;
        var ok = await ApiCalls.RunAsync(() => Api.DropAsync(enrollment.Id, new DropEnrollmentRequest(reason.Reason, reason.EffectiveOn)),
            Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (!ok) return;
        Snackbar.Add(L["Common_Saved"], Severity.Success);
        await LoadAsync();
    }

    private async Task TransferAsync()
    {
        var s = Student.Summary;
        var dialog = await Dialogs.ShowAsync<TransferDialog>(L["Transfer_Title"],
            new DialogParameters<TransferDialog>
            {
                { x => x.StudentId, s.Id },
                { x => x.StudentName, Culture.Pick(s.NameAr, s.NameEn) },
                { x => x.OrgUnitId, s.HomeOrgUnitId },
                { x => x.AcademicYearId, AcademicYearId },
                { x => x.CurrentClassId, s.CurrentClassId },
            }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(L["Transfer_Done"], Severity.Success);
            await LoadAsync();
        }
    }
}
