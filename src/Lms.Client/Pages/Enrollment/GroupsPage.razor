@page "/class-courses/{ClassCourseId:guid}/groups"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Shared.Authorization
@implements IDisposable
@inject PermissionState PermState

<PageTitle>@L["Group_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <LoadingState Lines="3" />
}
else if (!PermState.Has(Permissions.Groups.View))
{
    <Forbidden />
}
else
{
    @* A thin host for the groups tab (the class course view that will embed it belongs to the classes pages). *@
    <PageHeader Title="@L["Group_Title"]" Subtitle="@L["Group_Subtitle"]" TitleTestId="groups-title" />
    <GroupsTab ClassCourseId="ClassCourseId" CanManage="PermState.Has(Permissions.Groups.Manage)" />
}

@code {
    [Parameter] public Guid ClassCourseId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
