@using System.Globalization
@using Lms.Client.Services.Api
@using Lms.Shared.Classes
@using Lms.Shared.Enrollment
@inject IEnrollmentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ICultureService Culture
@inject NavigationManager Navigation

@* Who is enrolled in one course of a class. An optional course can be enrolled in or dropped by hand; a required one follows the class (auto). *@
<MudStack Spacing="2" data-testid="classcourse-enrollments-tab">
    @if (!IsRequired && CanManage)
    {
        <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2">@L["Enrollment_EnrollOptional"]</MudText>
            @if (_candidates.Count == 0)
            {
                <MudText Typo="Typo.caption" data-testid="enroll-none">@L["Enrollment_NoCandidates"]</MudText>
            }
            else
            {
                <MudStack Spacing="0" Style="max-height: 14rem; overflow-y: auto" data-testid="enroll-candidates">
                    @foreach (var student in _candidates)
                    {
                        var id = student.StudentId;
                        <MudCheckBox T="bool" Value="_picked.Contains(id)" ValueChanged="v => Pick(id, v)" Dense="true"
                                     Label="@($"{Culture.Pick(student.NameAr, student.NameEn)} ({student.StudentCode})")" data-testid="@($"enroll-pick-{id}")" />
                    }
                </MudStack>
                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EnrollAsync" Disabled="@(_picked.Count == 0)"
                               data-testid="enroll-submit">@L["Enrollment_Enroll"]</MudButton>
                </div>
            }
        </MudStack>
    }

    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="api-error">@L["Api_Error"]</MudAlert>
    }
    else if (_enrollments.Count == 0)
    {
        <EmptyState Title="@L["Common_Empty"]" Icon="@Icons.Material.Rounded.School" TestId="enrollments-empty" />
    }
    else
    {
        <MudTable Items="_enrollments" Dense="true" Elevation="0" HeaderClass="lms-table-head" Class="lms-table" Hover="true" Breakpoint="Breakpoint.Sm" data-testid="classcourse-enrollments-table">
            <HeaderContent>
                <MudTh>@L["Student_Code"]</MudTh>
                <MudTh>@L["Common_Name"]</MudTh>
                <MudTh>@L["Enrollment_Source"]</MudTh>
                <MudTh>@L["Enrollment_From"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="e">
                <MudTd DataLabel="@L["Student_Code"]"><span dir="ltr">@e.StudentCode</span></MudTd>
                <MudTd DataLabel="@L["Common_Name"]">@Culture.Pick(e.StudentNameAr, e.StudentNameEn)</MudTd>
                <MudTd DataLabel="@L["Enrollment_Source"]">@L[$"EnrollmentSource_{e.Source}"]</MudTd>
                <MudTd DataLabel="@L["Enrollment_From"]"><span dir="ltr">@e.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span></MudTd>
                <MudTd>
                    @if (!IsRequired && CanManage)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DropAsync(e)"
                                   data-testid="@($"drop-{e.StudentId}")">@L["Enrollment_Drop"]</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    private IReadOnlyList<EnrollmentDto> _enrollments = [];
    private IReadOnlyList<ClassStudentDto> _candidates = [];
    private readonly HashSet<Guid> _picked = [];
    private bool _failed;

    [Parameter, EditorRequired] public Guid ClassCourseId { get; set; }
    [Parameter, EditorRequired] public Guid ClassId { get; set; }

    /// <summary>A required course enrolls the whole class automatically: nothing to enroll or drop by hand.</summary>
    [Parameter] public bool IsRequired { get; set; }

    /// <summary>True with Enrollment.Manage.</summary>
    [Parameter] public bool CanManage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _failed = false;
        _picked.Clear();
        var failed = !await ApiCalls.RunAsync(async () =>
        {
            _enrollments = (await Api.ListEnrollmentsAsync(new EnrollmentQuery(null, ClassCourseId, EnrollmentStatuses.Active, 1, 200))).Items;
            if (!IsRequired && CanManage)
            {
                // Candidates: active students of the class who are not enrolled in this course yet.
                var enrolled = _enrollments.Select(e => e.StudentId).ToHashSet();
                _candidates = (await Api.ListClassStudentsAsync(ClassId)).Where(s => s.Status == ClassStudentStatuses.Active && !enrolled.Contains(s.StudentId)).ToList();
            }
        }, Navigation, L, _ => { });
        _failed = failed;
    }

    private void Pick(Guid id, bool value)
    {
        if (value) _picked.Add(id); else _picked.Remove(id);
    }

    private async Task EnrollAsync()
    {
        var ok = await ApiCalls.RunAsync(() => Api.EnrollAsync(ClassCourseId, new EnrollStudentsRequest(_picked.ToList())),
            Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (!ok) return;
        Snackbar.Add(L["Common_Saved"], Severity.Success);
        await LoadAsync();
    }

    private async Task DropAsync(EnrollmentDto enrollment)
    {
        var dialog = await Dialogs.ShowAsync<ReasonDialog>(L["Enrollment_Drop"],
            new DialogParameters<ReasonDialog>
            {
                { x => x.Message, L["Enrollment_DropConfirm", Culture.Pick(enrollment.StudentNameAr, enrollment.StudentNameEn)].Value },
                { x => x.ConfirmText, L["Enrollment_Drop"] },
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: ReasonResult reason }) return;
        var ok = await ApiCalls.RunAsync(() => Api.DropAsync(enrollment.Id, new DropEnrollmentRequest(reason.Reason, reason.EffectiveOn)),
            Navigation, L, message => Snackbar.Add(message, Severity.Error));
        if (!ok) return;
        Snackbar.Add(L["Common_Saved"], Severity.Success);
        await LoadAsync();
    }
}
