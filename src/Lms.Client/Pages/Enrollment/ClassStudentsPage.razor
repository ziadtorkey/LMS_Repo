@page "/classes/{ClassId:guid}/students"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Classes
@using Lms.Shared.Enrollment
@implements IDisposable
@inject IClassesApi Classes
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["ClassStudents_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Classes.View))
{
    <Forbidden />
}
else if (_class is null)
{
    <MudText>@(_loaded ? L["Common_Empty"] : L["Common_Loading"])</MudText>
}
else
{
    @* A thin host for the students tab (the class view that will embed it belongs to the classes pages). *@
    <MudText Typo="Typo.h4" Class="mb-1" data-testid="class-title">@Culture.Pick(_class.NameAr, _class.NameEn)</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">@Culture.Pick(_class.YearNameAr, _class.YearNameEn) · @Culture.Pick(_class.OrgUnitNameAr, _class.OrgUnitNameEn)</MudText>
    <ClassStudentsTab Class="_class" CanManage="PermState.Has(Permissions.Enrollment.Manage)" CanTransfer="PermState.Has(Permissions.Enrollment.Transfer)"
                      CanRequestException="PermState.Has(Permissions.Enrollment.RequestException)" OnRequestException="RequestException" />
}

@code {
    private ClassSummaryDto? _class;
    private bool _loaded;

    [Parameter] public Guid ClassId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        if (!PermState.Has(Permissions.Classes.View)) return;
        await ApiCalls.RunAsync(
            async () => _class = (await Classes.ListAsync(new ClassQuery(null, true, null, null, null, null, 1, 200))).Items.FirstOrDefault(c => c.Id == ClassId),
            Navigation, L, _ => { });
        _loaded = true;
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;

    /// <summary>The exception request lives with the class course (restriction exceptions page).</summary>
    private void RequestException(RestrictionSkipDto skip) =>
        Navigation.NavigateTo($"class-courses/{skip.ClassCourseId}/exceptions?student={skip.StudentId}");
}
