@using Lms.Client.Services.Api
@using Lms.Shared.Auditing
@inject IAuditApi Api

@* Before/after diff of one audit entry; changed values are highlighted. Values keep their own direction (dir=auto). *@
<MudDrawer Open="Open" OpenChanged="OpenChanged" Anchor="Anchor.End" Variant="DrawerVariant.Temporary"
           Width="min(520px, 100vw)" Elevation="4" Class="lms-audit-drawer" data-testid="audit-drawer">
    <MudDrawerHeader Class="lms-audit-drawer-head">
        <div class="lms-audit-drawer-title">
            <MudText Typo="Typo.h6">@(Entry is null ? "" : EntityLabel(Entry))</MudText>
            @if (Entry is not null)
            {
                <span class="lms-muted lms-item-meta" dir="ltr">@Entry.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            }
        </div>
        <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" aria-label="@L["Common_Close"]"
                       OnClick="() => OpenChanged.InvokeAsync(false)" />
    </MudDrawerHeader>
    <div class="lms-audit-drawer-body">
        @if (_failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="audit-detail-error">@L["Api_Error"]</MudAlert>
        }
        else if (_rows is null)
        {
            <LoadingState Lines="4" />
        }
        else if (_rows.Count == 0)
        {
            <EmptyState Title="@L["Audit_NoChanges"]" Icon="@Icons.Material.Rounded.CompareArrows" TestId="audit-diff-empty" />
        }
        else
        {
            <div class="lms-audit-legend" aria-hidden="true">
                <span class="lms-legend-swatch lms-diff-before"></span>@L["Audit_Before"]
                <span class="lms-legend-swatch lms-diff-after"></span>@L["Audit_After"]
            </div>
            <MudSimpleTable Dense="true" Elevation="0" Class="lms-audit-diff lms-simple-table" data-testid="audit-diff">
                <thead>
                    <tr><th><span class="lms-visually-hidden">@L["Audit_Field"]</span></th><th>@L["Audit_Before"]</th><th>@L["Audit_After"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr data-testid="@($"diff-{row.Property}")">
                            <td dir="ltr" class="lms-diff-prop">@row.Property</td>
                            <td dir="auto" class="@(row.Before != row.After ? "lms-diff-before" : null)">@row.Before</td>
                            <td dir="auto" class="@(row.Before != row.After ? "lms-diff-after" : null)">@row.After</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </div>
    <div class="lms-audit-drawer-foot">
        <MudButton Variant="Variant.Outlined" OnClick="() => OpenChanged.InvokeAsync(false)" data-testid="audit-drawer-close">@L["Common_Close"]</MudButton>
    </div>
</MudDrawer>

@code {
    private IReadOnlyList<AuditDiffRow>? _rows;
    private bool _failed;
    private Guid? _loaded;

    [Parameter] public AuditEntryDto? Entry { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!Open || Entry is null || _loaded == Entry.Id) return;
        _loaded = Entry.Id; _rows = null; _failed = false;
        try
        {
            var detail = await Api.GetAsync(Entry.Id);
            _rows = AuditDiff.Rows(detail.BeforeJson, detail.AfterJson);
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }

    private string EntityLabel(AuditEntryDto e) =>
        e.Action == AuditActions.SecurityEvent ? L[$"AuditEvent_{e.EntityType}"] : L[$"AuditEntity_{e.EntityType}"];
}
