@page "/me/children/{StudentId:guid}/grades"
@attribute [Authorize]
@using Lms.Client.Components.Grading
@using Lms.Shared.Authorization
@inject PermissionState PermState

<PageTitle>@L["StGrades_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <LoadingState Lines="4" TestId="grades-loading" />
}
else if (!PermState.Has(Permissions.Students.ViewChildren) || !PermState.Has(Permissions.Grades.ViewOwn))
{
    <Forbidden /> @* not a guardian: off limits; the server still decides which child (another family's child is 404) *@
}
else
{
    <StudentGradesView StudentId="StudentId" />
}

@code {
    [Parameter] public Guid StudentId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!PermState.Loaded) await PermState.RefreshAsync();
    }
}
