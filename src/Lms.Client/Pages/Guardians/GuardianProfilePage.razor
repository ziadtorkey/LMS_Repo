@page "/guardians/{Id:guid}"
@attribute [Authorize]
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.People
@implements IDisposable
@inject IGuardiansApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["Guardians_Title"]</PageTitle>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" data-testid="profile-error">@_error</MudAlert>
}
else if (_detail is null)
{
    <MudText>@L["Common_Loading"]</MudText>
}
else
{
    var s = _detail.Summary;
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" data-testid="profile-name">@Culture.Pick(s.NameAr, s.NameEn)</MudText>
        @if (PermState.Has(Permissions.Students.Update))
        {
            <div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync"
                           data-testid="action-edit">@L["Guardian_Edit"]</MudButton>
            </div>
        }
        <MudPaper Class="pa-3">
            <MudStack Spacing="1">
                <MudText data-testid="profile-mobile">@L["Student_Mobile"]: <span dir="ltr">@s.Mobile</span></MudText>
                <MudText data-testid="profile-email">@L["Student_Email"]: <span dir="ltr">@s.Email</span></MudText>
                <MudText data-testid="profile-national-id">@L["Student_NationalId"]: <span dir="ltr">@_detail.NationalId</span></MudText>
                <MudText data-testid="profile-portal">@L["Student_Account"]: @(s.HasPortalAccount ? L["Guardian_PortalActive"] : L["Guardian_PortalNone"])</MudText>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.h6">@L["Guardian_Children"]</MudText>
        @if (_detail.Children.Count == 0)
        {
            <MudText data-testid="children-empty">@L["Common_Empty"]</MudText>
        }
        else
        {
            <MudTable Items="_detail.Children" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" data-testid="children-table">
                <HeaderContent>
                    <MudTh>@L["Student_Code"]</MudTh>
                    <MudTh>@L["Common_Name"]</MudTh>
                    <MudTh>@L["Guardian_Relation"]</MudTh>
                    <MudTh>@L["Staff_HomeUnit"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="child">
                    <MudTd DataLabel="@L["Student_Code"]"><span dir="ltr">@child.StudentCode</span></MudTd>
                    <MudTd DataLabel="@L["Common_Name"]">
                        <MudLink Href="@($"students/{child.StudentId}")" data-testid="@($"child-link-{child.StudentId}")">@Culture.Pick(child.NameAr, child.NameEn)</MudLink>
                        @if (child.IsPrimary)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" title="@L["Guardian_Primary"]" />
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["Guardian_Relation"]">@L[$"Relation_{child.Relation}"]</MudTd>
                    <MudTd DataLabel="@L["Staff_HomeUnit"]">@Culture.Pick(child.HomeOrgUnitNameAr, child.HomeOrgUnitNameEn)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
}

@code {
    private GuardianDetailDto? _detail;
    private string? _error;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        PermState.Changed -= OnPermissionsChanged;
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;

    private async Task LoadAsync()
    {
        _error = null;
        await ApiCalls.RunAsync(async () => _detail = await Api.GetAsync(Id), Navigation, L, message => _error = message);
    }

    private async Task EditAsync()
    {
        var dialog = await Dialogs.ShowAsync<EditGuardianDialog>(L["Guardian_Edit"],
            new DialogParameters<EditGuardianDialog> { { x => x.Guardian, _detail! } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { Snackbar.Add(L["Common_Saved"], Severity.Success); await LoadAsync(); }
    }
}
