@page "/level-types"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Organizations
@inject IOrgApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["LevelTypes_Title"]</PageTitle>
<PageHeader Title="@L["LevelTypes_Title"]" Subtitle="@L["LevelTypes_Subtitle"]" TitleTestId="level-types-title">
    <Actions>
        @if (PermState.Has(Permissions.LevelTypes.Create))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add"
                       OnClick="() => EditAsync(null)" data-testid="level-new">@L["LevelTypes_New"]</MudButton>
        }
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-testid="level-error">@_error</MudAlert>
}

<SectionCard Flush="true">
    @if (_loading)
    {
        <LoadingState Lines="4" Class="pa-4" />
    }
    else if (_levels.Count == 0)
    {
        <EmptyState Title="@L["LevelTypes_EmptyTitle"]" Text="@L["LevelTypes_EmptyText"]" Icon="@Icons.Material.Rounded.Layers" TestId="table-empty" />
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="lms-simple-table lms-stack-table">
            <thead>
                <tr>
                    <th>@L["LevelTypes_Order"]</th>
                    <th>@L["Common_Name"]</th>
                    <th>@L["LevelTypes_CanHostClasses"]</th>
                    <th>@L["LevelTypes_Units"]</th>
                    <th><span class="lms-visually-hidden">@L["Common_Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _levels.Count; i++)
                {
                    var index = i;
                    var level = _levels[i];
                    <tr data-testid="@($"level-row-{level.Id}")">
                        <td data-label="@L["LevelTypes_Order"]"><span class="lms-order-badge">@(index + 1)</span></td>
                        <td data-label="@L["Common_Name"]" class="lms-cell-strong">@Culture.Pick(level.NameAr, level.NameEn)</td>
                        <td data-label="@L["LevelTypes_CanHostClasses"]">
                            @if (level.CanHostClasses)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success" Icon="@Icons.Material.Rounded.Check">@L["Common_Yes"]</MudChip>
                            }
                            else
                            {
                                <span class="lms-muted">@L["Common_No"]</span>
                            }
                        </td>
                        <td data-label="@L["LevelTypes_Units"]">@level.UnitCount</td>
                        <td class="lms-cell-actions">
                            <div class="lms-row-actions">
                                @if (PermState.Has(Permissions.LevelTypes.Update))
                                {
                                    <MudIconButton Icon="@Icons.Material.Rounded.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)"
                                                   aria-label="@L["LevelTypes_MoveUp"]" OnClick="() => MoveAsync(index, -1)"
                                                   data-testid="@($"level-up-{level.Id}")" />
                                    <MudIconButton Icon="@Icons.Material.Rounded.ArrowDownward" Size="Size.Small" Disabled="@(index == _levels.Count - 1)"
                                                   aria-label="@L["LevelTypes_MoveDown"]" OnClick="() => MoveAsync(index, 1)"
                                                   data-testid="@($"level-down-{level.Id}")" />
                                    <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" aria-label="@L["Common_Edit"]"
                                                   OnClick="() => EditAsync(level)" data-testid="@($"level-edit-{level.Id}")" />
                                }
                                @if (PermState.Has(Permissions.LevelTypes.Delete))
                                {
                                    <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                   aria-label="@L["Common_Delete"]" OnClick="() => DeleteAsync(level)"
                                                   data-testid="@($"level-delete-{level.Id}")" />
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</SectionCard>

@code {
    private List<LevelTypeDto> _levels = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        try { _levels = [.. await Api.GetLevelTypesAsync()]; }
        catch (Exception ex) when (ApiCalls.TryRedirect(ex, Navigation)) { }
        catch (ApiProblemException ex) { _error = ProblemText.ForClientWide(ex, L); }
        _loading = false;
    }

    private async Task MoveAsync(int index, int direction)
    {
        var order = _levels.Select(l => l.Id).ToList();
        (order[index], order[index + direction]) = (order[index + direction], order[index]);
        _error = null;
        try { await Api.ReorderLevelTypesAsync(new ReorderLevelTypesRequest(order)); }
        catch (ApiProblemException ex) { _error = ProblemText.ForClientWide(ex, L); }
        await LoadAsync();
    }

    private async Task EditAsync(LevelTypeDto? existing)
    {
        var parameters = new DialogParameters<LevelTypeDialog> { { x => x.Existing, existing } };
        var title = existing is null ? L["LevelTypes_New"].Value : L["Common_Edit"].Value;
        var dialog = await Dialogs.ShowAsync<LevelTypeDialog>(title, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(L["Common_Saved"], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(LevelTypeDto level)
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, L["Confirm_DeleteTitle"], Culture.Pick(level.NameAr, level.NameEn), L["Common_Delete"]))
            return;
        _error = null;
        try { await Api.DeleteLevelTypeAsync(level.Id); }
        catch (ApiProblemException ex) { _error = ProblemText.ForClientWide(ex, L); }
        await LoadAsync();
    }

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
