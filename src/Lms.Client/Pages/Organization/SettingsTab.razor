@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Configuration
@using Lms.Client.Pages.Settings
@inject IConfigApi Api
@inject ICultureService Culture
@inject NavigationManager Navigation

<div>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" data-testid="settings-error">@_error</MudAlert>
    }

    @if (_loading)
    {
        <LoadingState Lines="4" TestId="settings-loading" />
    }
    else
    {
        <ClientTimeZoneSetting UnitId="UnitId" CanEdit="CanEdit" />
        <GradeSettingsGroup UnitId="UnitId" CanEdit="CanEdit" />
        @foreach (var category in Categories)
        {
            <section class="mb-6" data-testid="@($"settings-group-{category}")" aria-labelledby="@($"settings-heading-{category}")">
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-2" id="@($"settings-heading-{category}")">@L[$"SettingCategory_{category}"]</MudText>
                @foreach (var definition in _catalog.Where(d => d.Category == category && !IsGrouped(d.Name)))
                {
                    var name = definition.Name;
                    var effective = _values.GetValueOrDefault(name);
                    if (effective is null) continue;
                    var readOnly = !CanEdit || effective.LockedByAncestor;
                    <div class="lms-setting-row" data-testid="@($"setting-row-{name}")">
                        <div class="lms-setting-main">
                            <MudText Class="lms-setting-name">@L["Setting_" + name.Replace('.', '_')]</MudText>
                            <SettingEditor Definition="definition" Value="@effective.ValueJson" Disabled="readOnly"
                                           Label="@L["Setting_" + name.Replace('.', '_')]"
                                           ValueChanged="@(json => SaveAsync(effective, json, effective.DefinedHere && effective.IsLocked))" />
                        </div>
                        <div class="lms-setting-meta">
                            @if (effective.LockedByAncestor)
                            {
                                <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" Title="@L["Settings_Lock"]" />
                            }
                            <MudText Typo="Typo.caption" Class="lms-muted" data-testid="@($"setting-source-{name}")">@SourceText(effective)</MudText>
                            <MudSpacer />
                            <MudCheckBox T="bool" Value="@(effective.DefinedHere && effective.IsLocked)" Disabled="readOnly"
                                         Label="@L["Settings_Lock"]" data-testid="@($"setting-lock-{name}")"
                                         ValueChanged="@(locked => SaveAsync(effective, effective.ValueJson, locked))" />
                            @if (effective.DefinedHere && !readOnly)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Rounded.Undo"
                                           OnClick="() => ResetAsync(name)" data-testid="@($"setting-reset-{name}")">@L["Settings_Reset"]</MudButton>
                            }
                        </div>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid UnitId { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    private static readonly string[] Categories =
        [SettingCategories.General, SettingCategories.Files, SettingCategories.Features, SettingCategories.People, SettingCategories.Academic];

    /// <summary>Settings with their own group above (time zone, grading); the generic list skips them.</summary>
    private static bool IsGrouped(string name) => name == SettingKeys.OrgTimeZone.Name || name.StartsWith("Grades.", StringComparison.Ordinal);

    private IReadOnlyList<SettingDefinition> _catalog = [];
    private Dictionary<string, EffectiveSettingDto> _values = [];
    private string? _error;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private Task<bool> RunAsync(Func<Task> action) => ApiCalls.RunAsync(action, Navigation, L, message => _error = message);

    private async Task LoadAsync()
    {
        await RunAsync(async () =>
        {
            _catalog = await Api.GetSettingCatalogAsync();
            _values = (await Api.GetSettingsAsync(UnitId)).ToDictionary(s => s.Name);
        });
        _loading = false;
    }

    private string SourceText(EffectiveSettingDto setting)
    {
        var name = Culture.Pick(setting.SourceNameAr ?? "", setting.SourceNameEn ?? "");
        if (setting.LockedByAncestor) return string.Format(L["Settings_LockedBy"].Value, name);
        if (setting.DefinedHere) return L["Settings_SetHere"];
        if (setting.SourceOrgUnitId is null) return L["Settings_Default"];
        return string.Format(L["Settings_InheritedFrom"].Value, name);
    }

    private async Task SaveAsync(EffectiveSettingDto setting, string valueJson, bool locked)
    {
        _error = null;
        await RunAsync(() => Api.SetSettingAsync(UnitId, setting.Name, new SetSettingRequest(valueJson, locked)));
        await LoadAsync(); // show the server state (it may also reject or normalise the value)
    }

    private async Task ResetAsync(string name)
    {
        _error = null;
        await RunAsync(() => Api.RemoveSettingAsync(UnitId, name));
        await LoadAsync();
    }
}
