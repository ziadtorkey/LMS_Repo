@page "/org-units/{Id:guid}"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Organizations
@inject IOrgApi Api
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["OrgTree_Settings"]</PageTitle>
<MudLink Href="org-units" Typo="Typo.body2" Class="lms-back-link" data-testid="unit-back">
    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="lms-icon-flip" aria-hidden="true" />
    @L["UnitSettings_Back"]
</MudLink>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="unit-error">@_error</MudAlert>
}
else if (_unit is null)
{
    <LoadingState Lines="5" TestId="unit-loading" />
}
else
{
    <PageHeader Title="@Culture.Pick(_unit.NameAr, _unit.NameEn)" Subtitle="@L["UnitSettings_Subtitle"]" TitleTestId="unit-title">
        <Badges>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="lms-status-chip"
                     Color="@(_unit.Status == OrgUnitStatuses.Inactive ? Color.Default : Color.Success)">@(_unit.Status == OrgUnitStatuses.Inactive ? L["OrgTree_Inactive"] : L["ClientStatus_Active"])</MudChip>
        </Badges>
    </PageHeader>

    @* Stitch unit settings: a segmented tab track on the canvas, each tab's content in its own cards. *@
    <MudTabs Class="lms-tabs lms-tabs-standalone" Elevation="0" Rounded="false" MinimumTabWidth="80px" TabPanelsClass="lms-tab-panels" data-testid="unit-tabs">
            <MudTabPanel Text="@L["UnitSettings_General"]" Icon="@Icons.Material.Rounded.Tune">
                <SectionCard Title="@L["UnitSettings_Identity"]" Subtitle="@L["UnitSettings_IdentityHelp"]" Icon="@Icons.Material.Rounded.Badge" Class="lms-narrow-card">
                    <dl class="lms-details" data-testid="tab-general">
                        <DetailItem Label="@L["Common_NameAr"]" Value="@_unit.NameAr" />
                        <DetailItem Label="@L["Common_NameEn"]" Value="@_unit.NameEn" Ltr="true" />
                        <DetailItem Label="@L["Common_Code"]" Value="@_unit.Code" Ltr="true" />
                        <DetailItem Label="@L["Common_Status"]" Value="@(_unit.Status == OrgUnitStatuses.Inactive ? L["OrgTree_Inactive"].Value : L["ClientStatus_Active"].Value)" />
                    </dl>
                </SectionCard>
            </MudTabPanel>
            <MudTabPanel Text="@L["UnitSettings_Academic"]" Icon="@Icons.Material.Rounded.School">
                <AcademicFlagsTab Unit="_unit" AllUnits="_all" CanEdit="PermState.Has(Permissions.OrgUnits.Update)" OnSaved="LoadAsync" />
            </MudTabPanel>
            <MudTabPanel Text="@L["UnitSettings_Settings"]" Icon="@Icons.Material.Rounded.ToggleOn" Visible="PermState.Has(Permissions.Settings.View)" data-testid="tab-settings">
                <SettingsTab UnitId="_unit.Id" CanEdit="PermState.Has(Permissions.Settings.Update)" />
            </MudTabPanel>
            <MudTabPanel Text="@L["UnitSettings_Courses"]" Icon="@Icons.Material.Rounded.MenuBook" Visible="PermState.Has(Permissions.Courses.View)" data-testid="tab-courses">
                <UnitCoursesTab UnitId="_unit.Id" />
            </MudTabPanel>
            <MudTabPanel Text="@L["UnitSettings_Policies"]" Icon="@Icons.Material.Rounded.Policy" Visible="PermState.Has(Permissions.Policies.View)" data-testid="tab-policies">
                <PoliciesTab UnitId="_unit.Id" CanEdit="PermState.Has(Permissions.Policies.Update)" />
            </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OrgUnitNodeDto? _unit;
    private IReadOnlyList<OrgUnitNodeDto> _all = [];
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        PermState.Changed -= OnPermissionsChanged;
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        await ApiCalls.RunAsync(async () =>
        {
            _all = await Api.GetOrgUnitsAsync(null);
            _unit = _all.FirstOrDefault(u => u.Id == Id);
            if (_unit is null) _error = L["Error_not_found"];
        }, Navigation, L, message => _error = message);
    }

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
