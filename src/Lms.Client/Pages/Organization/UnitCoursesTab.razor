@using Lms.Client.Services.Api
@using Lms.Shared.Courses
@inject ICoursesApi Api
@inject NavigationManager Navigation

@* Courses of one org unit: available here (allocated here or inherited from above) and allocated below. *@
<MudStack Spacing="3">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" data-testid="unit-courses-error">@_error</MudAlert>
    }
    else if (_courses is null)
    {
        <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
    }
    else
    {
        <MudText Typo="Typo.h6">@L["UnitCourses_Available"]</MudText>
        @if (_courses.Available.Count == 0)
        {
            <MudText data-testid="unit-courses-available-empty">@L["UnitCourses_NoneAvailable"]</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" data-testid="unit-courses-available">
                <tbody>
                    @foreach (var row in _courses.Available)
                    {
                        <tr>
                            <td><span dir="ltr">@row.CourseCode</span></td>
                            <td>
                                <MudLink Href="@($"courses/{row.CourseId}")">@CultureText.Pick(row.CourseNameAr, row.CourseNameEn)</MudLink>
                                @if (row.IsInherited)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" data-testid="@($"unit-course-inherited-{row.Id}")">@L["Course_Inherited"]</MudChip>
                                }
                            </td>
                            <td>@CultureText.Pick(row.OrgUnitNameAr, row.OrgUnitNameEn)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.h6">@L["UnitCourses_Below"]</MudText>
        @if (_courses.AllocatedBelow.Count == 0)
        {
            <MudText data-testid="unit-courses-below-empty">@L["UnitCourses_NoneBelow"]</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" data-testid="unit-courses-below">
                <tbody>
                    @foreach (var row in _courses.AllocatedBelow)
                    {
                        <tr>
                            <td><span dir="ltr">@row.CourseCode</span></td>
                            <td><MudLink Href="@($"courses/{row.CourseId}")">@CultureText.Pick(row.CourseNameAr, row.CourseNameEn)</MudLink></td>
                            <td>@CultureText.Pick(row.OrgUnitNameAr, row.OrgUnitNameEn)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudStack>

@code {
    private UnitCoursesDto? _courses;
    private string? _error;

    [Parameter, EditorRequired] public Guid UnitId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        await ApiCalls.RunAsync(async () => _courses = await Api.GetUnitCoursesAsync(UnitId), Navigation, L, message => _error = message);
    }
}
