@using Lms.Client.Components.Assets
@using Lms.Client.Components.Editors
@using Lms.Shared.Forums
@inject ICultureService Culture

@* One post: author, time, the server-sanitised body, attachments and a delete button when the server says the caller may delete it. *@
<MudPaper Outlined="true" Class="pa-3" data-testid="@($"post-{Post.Id}")">
    <MudStack Spacing="1">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.subtitle2">@Culture.Pick(Post.AuthorNameAr, Post.AuthorNameEn)</MudText>
            <MudText Typo="Typo.caption" Class="lms-muted"><span dir="ltr">@Post.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span></MudText>
            @if (Post.EditedAtUtc is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Forum_Edited"]</MudText>
            }
            <MudSpacer />
            @if (Post.CanDelete && !Post.IsOpeningPost && OnDelete.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Rounded.Delete" Size="Size.Small" Color="Color.Error" aria-label="@L["Common_Delete"]"
                               OnClick="() => OnDelete.InvokeAsync(Post)" data-testid="@($"post-delete-{Post.Id}")" />
            }
        </MudStack>
        <SanitizedHtml Html="@Post.BodyHtml" TestId="@($"post-body-{Post.Id}")" />
        @foreach (var file in Post.Attachments)
        {
            <AssetPreview Asset="file" />
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ForumPostDto Post { get; set; } = default!;
    [Parameter] public EventCallback<ForumPostDto> OnDelete { get; set; }
}
