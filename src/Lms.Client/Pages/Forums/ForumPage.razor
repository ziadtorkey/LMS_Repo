@page "/class-courses/{Id:guid}/forum"
@attribute [Authorize]
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.Forums
@inject IForumsApi Forum
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["Forum_Title"]</PageTitle>
<ClassCourseTabs ClassCourseId="Id" Active="forum" />
@if (!PermState.Loaded)
{
    <LoadingState Lines="4" />
}
else if (!PermState.Has(Permissions.Forums.View))
{
    <MudAlert Severity="Severity.Warning" data-testid="forum-forbidden">@L["Forbidden_Title"]</MudAlert>
}
else
{
    <PageHeader Title="@L["Forum_Title"]" Subtitle="@L["Forum_Subtitle"]">
        <Actions>
            @if (PermState.Has(Permissions.Forums.Post))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => _composing = !_composing" data-testid="forum-new">@L["Forum_NewThread"]</MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_composing)
    {
        <SectionCard Title="@L["Forum_NewThread"]" Class="mb-4" TestId="forum-new-panel">
            <MudStack Spacing="2">
                <MudTextField T="string" @bind-Value="_title" Label="@L["Forum_ThreadTitle"]" MaxLength="200" Immediate="true" data-testid="forum-new-title" />
                <PostComposer ClassCourseId="Id" Label="@L["Forum_Message"]" SendLabel="@L["Forum_Post"]" TestId="forum-new-composer" OnSubmit="CreateAsync" />
                @if (_formError is not null)
                {
                    <MudAlert Severity="Severity.Error" data-testid="forum-form-error">@_formError</MudAlert>
                }
            </MudStack>
        </SectionCard>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="forum-error">@_error</MudAlert>
    }
    else if (_loading)
    {
        <SectionCard><LoadingState Lines="4" TestId="forum-loading" /></SectionCard>
    }
    else if (_threads.Count == 0)
    {
        <SectionCard>
            <EmptyState Title="@L["Forum_Empty"]" Text="@L["Forum_EmptyText"]" Icon="@Icons.Material.Rounded.Forum" TestId="forum-empty" />
        </SectionCard>
    }
    else
    {
        <SectionCard TestId="forum-threads-card">
            <ul class="lms-item-list" data-testid="forum-threads">
                @foreach (var t in _threads)
                {
                    <li class="lms-item" data-testid="@($"forum-thread-{t.Id}")">
                        <div class="lms-item-main">
                            <MudLink Href="@($"class-courses/{Id}/forum/{t.Id}")" Class="lms-cell-strong lms-wrap" data-testid="@($"forum-thread-link-{t.Id}")">@t.Title</MudLink>
                            @if (t.IsPinned)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Icon="@Icons.Material.Rounded.PushPin" data-testid="@($"forum-pinned-{t.Id}")">@L["Forum_Pinned"]</MudChip>
                            }
                            @if (t.IsLocked)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Rounded.Lock" data-testid="@($"forum-locked-{t.Id}")">@L["Forum_Locked"]</MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="lms-muted">
                            <bdi>@Culture.Pick(t.AuthorNameAr, t.AuthorNameEn)</bdi> · @L["Forum_Replies", t.ReplyCount]
                        </MudText>
                    </li>
                }
            </ul>
            @if (_threads.Count < _total)
            {
                <div class="mt-3">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MoreAsync" Disabled="_loadingMore" data-testid="forum-more">@L["Forum_MoreThreads", _total - _threads.Count]</MudButton>
                </div>
            }
        </SectionCard>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private IReadOnlyList<ForumThreadDto> _threads = [];
    private int _total, _page = 1;
    private bool _loadingMore;
    private string? _error, _formError, _title;
    private bool _loading = true, _composing;

    protected override async Task OnParametersSetAsync()
    {
        PermState.Changed -= OnPermissionsChanged;
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        if (PermState.Has(Permissions.Forums.View))
            await ApiCalls.RunAsync(async () =>
            {
                var loaded = new List<ForumThreadDto>();
                for (var page = 1; page <= _page; page++)
                {
                    var result = await Forum.ListThreadsAsync(Id, page);
                    loaded.AddRange(result.Items);
                    _total = result.Total;
                }
                _threads = Ordered(loaded);
            }, Navigation, L, m => _error = m);
        _loading = false;
    }

    /// <summary>Pinned threads first, then the most recent activity.</summary>
    private static IReadOnlyList<ForumThreadDto> Ordered(IEnumerable<ForumThreadDto> items) =>
        items.OrderByDescending(t => t.IsPinned).ThenByDescending(t => t.LastActivityAtUtc).ToList();

    private async Task MoreAsync()
    {
        _loadingMore = true;
        _page++;
        await LoadAsync();
        _loadingMore = false;
    }

    private async Task<bool> CreateAsync(string html, IReadOnlyList<Guid> attachments)
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_title)) { _formError = L["Common_Required"]; return false; }
        var ok = await ApiCalls.RunAsync(() => Forum.CreateThreadAsync(Id, new CreateForumThreadRequest(_title.Trim(), html, attachments)),
            Navigation, L, m => _formError = m);
        if (!ok) return false;
        _title = null; _composing = false;
        await LoadAsync();
        StateHasChanged(); // the submit comes from the child composer, which does not re-render this page on its own
        return true;
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
