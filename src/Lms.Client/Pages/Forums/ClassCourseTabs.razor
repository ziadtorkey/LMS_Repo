@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@inject PermissionState PermState
@inject ILessonPlansApi Plans

@* One strip for a class course: [Plan] [My course] · Forum · Announcements. Plan needs Modules.Manage AND teaching this class course today (the
   rule of the plan endpoint: a scoped user without the relationship would get a Plan tab that answers 404). My course is for a student
   enrolled in it. Someone who is both sees both, Plan first. A caller with neither has no first tab. Forum and Announcements need
   Forums.View. The relation is read once per class course, not on every render. *@
<MudStack Row="true" Spacing="1" Class="mb-3" role="navigation" aria-label="@L["ClassCourse_Sections"]" data-testid="class-course-tabs">
    @if (ShowPlan)
    {
        <MudButton Href="@($"class-courses/{ClassCourseId}/plan")" Variant="@VariantOf("plan")" aria-current="@CurrentOf("plan")" data-testid="tab-plan">@L["ClassCourse_TabPlan"]</MudButton>
    }
    @if (_relation.Enrolled)
    {
        <MudButton Href="@($"class-courses/{ClassCourseId}/learn")" Variant="@VariantOf("learn")" aria-current="@CurrentOf("learn")" data-testid="tab-learn">@L["ClassCourse_TabMyCourse"]</MudButton>
    }
    @if (PermState.Has(Permissions.Forums.View))
    {
        <MudButton Href="@($"class-courses/{ClassCourseId}/forum")" Variant="@VariantOf("forum")" aria-current="@CurrentOf("forum")" data-testid="tab-forum">@L["ClassCourse_TabForum"]</MudButton>
        <MudButton Href="@($"class-courses/{ClassCourseId}/announcements")" Variant="@VariantOf("announcements")" aria-current="@CurrentOf("announcements")" data-testid="tab-announcements">@L["ClassCourse_TabAnnouncements"]</MudButton>
    }
</MudStack>

@code {
    private ClassCourseRelation _relation = ClassCourseRelation.None;

    [Parameter, EditorRequired] public Guid ClassCourseId { get; set; }
    /// <summary>"plan", "learn", "forum" or "announcements".</summary>
    [Parameter, EditorRequired] public string Active { get; set; } = "plan";

    private bool ShowPlan => PermState.Has(Permissions.Modules.Manage) && _relation.Teaches;

    private Guid? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ClassCourseId) return;
        _loadedFor = ClassCourseId;
        _relation = await Plans.GetRelationAsync(ClassCourseId);
    }

    private Variant VariantOf(string tab) => tab == Active ? Variant.Filled : Variant.Text;

    /// <summary>The current tab is announced as the current page; the others carry no attribute (null removes it).</summary>
    private string? CurrentOf(string tab) => tab == Active ? "page" : null;
}
