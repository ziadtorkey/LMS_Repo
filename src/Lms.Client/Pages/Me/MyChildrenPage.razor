@page "/me/children"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.People
@implements IDisposable
@inject IGuardiansApi Api
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["MyChildren_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
}
else if (!PermState.Has(Permissions.Students.ViewChildren))
{
    <Forbidden />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4" data-testid="children-title">@L["MyChildren_Title"]</MudText>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="@L["Common_Loading"]" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" data-testid="api-error">@_error</MudAlert>
    }
    else
    {
        @if (_children.Count == 0)
        {
            <MudText data-testid="children-empty">@L["MyChildren_Empty"]</MudText>
        }
        else
        {
            <MudGrid data-testid="children-grid">
                @foreach (var child in _children)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard data-testid="@($"child-card-{child.StudentId}")">
                            <MudCardContent>
                                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                    <StaffAvatar PhotoFileId="child.PhotoFileId" Size="Size.Large" />
                                    <div>
                                        <MudText Typo="Typo.h6" data-testid="@($"child-name-{child.StudentId}")">@Culture.Pick(child.NameAr, child.NameEn)</MudText>
                                        <MudText Typo="Typo.body2"><span dir="ltr">@child.StudentCode</span></MudText>
                                        <MudText Typo="Typo.body2">@Culture.Pick(child.HomeOrgUnitNameAr, child.HomeOrgUnitNameEn)</MudText>
                                        <MudChip T="string" Size="Size.Small">@L[$"Relation_{child.Relation}"]</MudChip>
                                    </div>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        <MudText Typo="Typo.caption" Class="mt-4" data-testid="children-hint">@L["MyChildren_OtherContexts"]</MudText>
    }
}

@code {
    private IReadOnlyList<MyChildDto> _children = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        if (!PermState.Has(Permissions.Students.ViewChildren)) { _loading = false; return; }
        await ApiCalls.RunAsync(async () => _children = await Api.GetMyChildrenAsync(), Navigation, L, message => _error = message);
        _loading = false;
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
