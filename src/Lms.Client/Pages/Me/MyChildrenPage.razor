@page "/me/children"
@attribute [Authorize]
@using Lms.Client.Components
@using Lms.Client.Components.People
@using Lms.Client.Services.Api
@using Lms.Shared.Authorization
@using Lms.Shared.People
@implements IDisposable
@inject IGuardiansApi Api
@inject PermissionState PermState
@inject ICultureService Culture
@inject NavigationManager Navigation

<PageTitle>@L["MyChildren_Title"]</PageTitle>
@if (!PermState.Loaded)
{
    <LoadingState Lines="3" TestId="children-loading" />
}
else if (!PermState.Has(Permissions.Students.ViewChildren))
{
    <Forbidden />
}
else
{
    <PageHeader Title="@L["MyChildren_Title"]" Subtitle="@L["MyChildren_Subtitle"]" TitleTestId="children-title" />
    @if (_loading)
    {
        <LoadingState Lines="3" TestId="children-loading" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="api-error">@_error</MudAlert>
    }
    else
    {
        @if (_children.Count == 0)
        {
            <SectionCard>
                <EmptyState Title="@L["MyChildren_Empty"]" Icon="@Icons.Material.Rounded.FamilyRestroom" TestId="children-empty" />
            </SectionCard>
        }
        else
        {
            <MudGrid Spacing="2" data-testid="children-grid">
                @foreach (var child in _children)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <SectionCard Class="h-100" TestId="@($"child-card-{child.StudentId}")">
                            <div class="lms-person-cell">
                                <StaffAvatar PhotoFileId="child.PhotoFileId" Name="@Culture.Pick(child.NameAr, child.NameEn)" Size="Size.Large" />
                                <div>
                                    <MudText Typo="Typo.subtitle1" data-testid="@($"child-name-{child.StudentId}")">@Culture.Pick(child.NameAr, child.NameEn)</MudText>
                                    <MudText Typo="Typo.body2" Class="lms-muted"><span dir="ltr">@child.StudentCode</span></MudText>
                                    <MudText Typo="Typo.body2">@Culture.Pick(child.HomeOrgUnitNameAr, child.HomeOrgUnitNameEn)</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="lms-role-chip mt-1">@L[$"Relation_{child.Relation}"]</MudChip>
                                    <div class="mt-2"><MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="@($"me/children/{child.StudentId}/timetable")" data-testid="@($"child-timetable-{child.StudentId}")">@L["Tt_Child_Link"]</MudButton></div>
                                </div>
                            </div>
                        </SectionCard>
                    </MudItem>
                }
            </MudGrid>
        }
        <MudText Typo="Typo.caption" Class="lms-muted mt-4 d-block" data-testid="children-hint">@L["MyChildren_OtherContexts"]</MudText>
    }
}

@code {
    private IReadOnlyList<MyChildDto> _children = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        PermState.Changed += OnPermissionsChanged;
        if (!PermState.Loaded) await PermState.RefreshAsync();
        if (!PermState.Has(Permissions.Students.ViewChildren)) { _loading = false; return; }
        await ApiCalls.RunAsync(async () => _children = await Api.GetMyChildrenAsync(), Navigation, L, message => _error = message);
        _loading = false;
    }

    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => PermState.Changed -= OnPermissionsChanged;
}
