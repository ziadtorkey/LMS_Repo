@page "/dev/timetable-spike"
@attribute [Authorize]
@using Lms.Client.Components.Timetable
@using Lms.Client.Services.Timetable

@* Prototype of the timetable builder interaction (spike S3, M5 Task 31). Mock data only; it becomes TimetableBuilderPage when the wave 2
   contract lands. *@
<PageTitle>@L["Tt_Page_Title"]</PageTitle>
<PageHeader Title="@L["Tt_Page_Title"]" Subtitle="@L["Tt_Page_Subtitle"]" TitleTestId="tt-title">
    <Actions>
        <MudSwitch T="bool" Value="_timetable.BlockOnConflict" ValueChanged="OnModeChanged" Color="Color.Primary"
                   Label="@(_timetable.BlockOnConflict ? L["Tt_Mode_Block"] : L["Tt_Mode_Warn"])" data-testid="tt-mode" />
    </Actions>
</PageHeader>

<SectionCard Title="@L["Tt_Grid_Label"]">
    <TimetableGrid Timetable="_timetable" />
</SectionCard>

@code {
    private readonly SpikeTimetable _timetable = new();

    private void OnModeChanged(bool block) => _timetable.BlockOnConflict = block;
}
