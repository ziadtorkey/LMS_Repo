@* Confirms publishing: the drafts become visible to students and teachers, and attendance sessions are generated for the coming days. *@
<MudDialog>
    <DialogContent>
        <MudText data-testid="publish-message">@string.Format(L["Tt_Publish_Confirm"], DraftCount)</MudText>
    </DialogContent>
    <DialogActions>
        <div class="lms-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="() => MudDialog.Cancel()" data-testid="publish-cancel">@L["Common_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close(DialogResult.Ok(true))" data-testid="publish-confirm">@L["Tt_Publish"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public int DraftCount { get; set; }
}
