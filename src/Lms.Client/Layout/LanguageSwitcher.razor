@inject ICultureService Culture

<MudButton Color="Color.Inherit" OnClick="Switch" data-testid="lang-switch" lang="@OtherLanguage">@L["Lang_Other"]</MudButton>

@code {
    private string OtherLanguage => Culture.Current.TwoLetterISOLanguageName == "ar" ? "en" : "ar";

    private Task Switch() => Culture.SetAsync(OtherLanguage);
}
