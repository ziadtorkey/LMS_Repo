@using Lms.Client.Navigation
@inject PermissionState Permissions
@implements IDisposable

@* Home first, then the Stitch sidebar groups (Structure, People, Academic, Security) in catalog order; a group with no visible entry
   is not rendered. Each group is a role="group" labelled by its heading, which is text, not an h2 (it sits before the page h1).
   Collapsed (the 72 px desktop rail): the link text stays in the DOM as each link's name, hidden visually by CSS, and a tooltip shows it. *@
<MudNavMenu aria-label="@L["Nav_Main"]" data-testid="nav-main">
    @foreach (var item in Visible.Where(i => i.Section is null))
    {
        @Link(item)
    }
    @foreach (var section in NavCatalog.Sections)
    {
        var items = Visible.Where(i => i.Section == section).ToList();
        if (items.Count == 0) continue;
        var id = $"navsec-{SectionKey(section)}";
        <div role="group" aria-labelledby="@id" class="lms-nav-group" data-testid="@($"navsection-{SectionKey(section)}")">
            <div id="@id" class="lms-nav-section">@L[section]</div>
            @foreach (var item in items)
            {
                @Link(item)
            }
        </div>
    }
</MudNavMenu>

@code {
    [Parameter] public bool Collapsed { get; set; }

    private IEnumerable<NavItem> Visible => NavCatalog.Items.Where(i =>
        (!i.PlatformAdminOnly || Permissions.IsPlatformAdmin) &&
        (i.RequiredPermission is null || Permissions.Has(i.RequiredPermission)));

    protected override async Task OnInitializedAsync()
    {
        Permissions.Changed += OnChanged;
        await Permissions.RefreshAsync();
    }

    private static string SectionKey(string section) => section["NavSection_".Length..].ToLowerInvariant();

    private RenderFragment Link(NavItem item) =>
        @<MudTooltip Text="@L[item.ResourceKey]" Placement="Placement.End" Disabled="@(!Collapsed)" RootClass="lms-nav-tip">
            <MudNavLink Href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                        Icon="@item.Icon" data-testid="@($"nav-{item.Key}")">@L[item.ResourceKey]</MudNavLink>
        </MudTooltip>;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Permissions.Changed -= OnChanged;
}
