@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Lms.Client.Theme
@inherits LayoutComponentBase
@inject ICultureService Culture
@inject NavigationManager Navigation
@inject IContextStore ContextStore
@inject PermissionState Permissions
@inject IJSRuntime JS

<div data-testid="app-root" class="lms-app @(_railCollapsed ? "lms-rail" : null)" dir="@(Culture.IsRightToLeft ? "rtl" : "ltr")" lang="@Culture.Current.TwoLetterISOLanguageName">
    <a class="lms-skip-link" href="#lms-main" data-testid="skip-link">@L["Nav_SkipToContent"]</a>
    <MudRTLProvider RightToLeft="@Culture.IsRightToLeft">
        <MudThemeProvider Theme="_theme" IsDarkMode="_isDark" />
        <MudPopoverProvider />
        <MudDialogProvider CloseOnEscapeKey="true" />
        <MudSnackbarProvider />
        <MudLayout>
            <MudAppBar Elevation="0" Class="lms-appbar">
                <AuthorizeView>
                    <Authorized>
                        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start"
                                       aria-label="@L["Nav_Menu"]" OnClick="() => _drawerOpen = !_drawerOpen" data-testid="nav-toggle" />
                    </Authorized>
                </AuthorizeView>
                <MudText Typo="Typo.subtitle1" Class="lms-appbar-title d-none d-sm-flex d-md-none">@L["App_Title"]</MudText>
                <MudSpacer />
                <div class="lms-appbar-tools">
                    <AuthorizeView>
                        <Authorized>
                            <ContextSwitcher />
                            <YearSelector />
                            <NotificationBell />
                        </Authorized>
                    </AuthorizeView>
                    @* On phones the app bar is full, so the colour-scheme switch lives in the user menu there. *@
                    <div class="d-none d-sm-flex">
                        <MudTooltip Text="@ThemeLabel">
                            <MudIconButton Icon="@ThemeIcon" Color="Color.Inherit" aria-label="@ThemeLabel" OnClick="ToggleThemeAsync"
                                           data-testid="theme-toggle" />
                        </MudTooltip>
                    </div>
                    <LanguageSwitcher />
                    <AuthorizeView>
                        <Authorized>
                            <MudMenu Icon="@Icons.Material.Rounded.AccountCircle" Color="Color.Inherit" AriaLabel="@L["Menu_User"]"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" data-testid="user-menu">
                                <MudText Class="px-4 py-2" Typo="Typo.subtitle2">@context.User.Identity?.Name</MudText>
                                <MudDivider />
                                <MudMenuItem Icon="@ThemeIcon" OnClick="ToggleThemeAsync" Class="d-sm-none" data-testid="theme-toggle-menu">@ThemeLabel</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Rounded.Logout" OnClick="Logout">@L["Menu_Logout"]</MudMenuItem>
                            </MudMenu>
                        </Authorized>
                        <NotAuthorized>
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="authentication/login">@L["Menu_Login"]</MudButton>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </MudAppBar>
            <AuthorizeView>
                <Authorized>
                    <ContextGate />
                    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Never" Elevation="0"
                               Class="lms-drawer" id="lms-sidebar">
                        <MudDrawerHeader Class="lms-brand">
                            <span class="lms-brand-mark" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Rounded.School" Size="Size.Small" />
                            </span>
                            <span class="lms-brand-text">
                                <MudText Typo="Typo.subtitle1" Class="lms-brand-name">@L["App_Title"]</MudText>
                                <MudText Typo="Typo.caption" Class="lms-brand-sub">@L["App_Subtitle"]</MudText>
                            </span>
                        </MudDrawerHeader>
                        @* Hidden="true" from md (960 px): that is where the rail applies; below it the drawer keeps full labels and no tooltips. *@
                        <MudHidden Breakpoint="Breakpoint.MdAndUp" @bind-Hidden="_isWide" />
                        <NavMenu Collapsed="@(_railCollapsed && _isWide)" />
                        @* Desktop only: below 960 px the drawer is the temporary one, opened from the app bar. *@
                        <div class="lms-rail-toggle d-none d-md-flex">
                            <MudTooltip Text="@RailLabel" Placement="Placement.End">
                                <MudIconButton Icon="@Icons.Material.Rounded.KeyboardDoubleArrowLeft" Class="lms-icon-flip" aria-label="@RailLabel"
                                               aria-expanded="@((!_railCollapsed).ToString().ToLowerInvariant())" aria-controls="lms-sidebar"
                                               OnClick="ToggleRailAsync" data-testid="rail-toggle" />
                            </MudTooltip>
                        </div>
                    </MudDrawer>
                </Authorized>
            </AuthorizeView>
            <MudMainContent Class="lms-main">
                <MudContainer id="lms-main" tabindex="-1" MaxWidth="MaxWidth.ExtraLarge" Class="lms-page">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </MudRTLProvider>
</div>

@code {
    // Colour scheme: wwwroot/js/theme.js (lms.theme in localStorage, otherwise the device setting).
    private MudTheme _theme = default!;
    private bool _drawerOpen = true;
    private bool _isDark;
    private bool _railCollapsed;
    private bool _isWide;

    private string RailLabel => _railCollapsed ? L["Nav_ExpandSidebar"] : L["Nav_CollapseSidebar"];
    private string ThemeLabel => _isDark ? L["Theme_Light"] : L["Theme_Dark"];
    private string ThemeIcon => _isDark ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode;

    // The culture is fixed for the app's lifetime (switching languages reloads the app), so the font stack is chosen once.
    protected override void OnInitialized() => _theme = LmsTheme.Create(Culture.IsRightToLeft);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var dark = await JS.InvokeAsync<bool>("lmsTheme.isDark");
        var rail = await JS.InvokeAsync<bool>("lmsNav.isRailCollapsed");
        if (dark == _isDark && rail == _railCollapsed) return;
        _isDark = dark;
        _railCollapsed = rail;
        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("lmsTheme.set", _isDark);
    }

    // The rail choice is per user and device: wwwroot/js/nav.js (lms.nav.rail in localStorage).
    private async Task ToggleRailAsync()
    {
        _railCollapsed = !_railCollapsed;
        await JS.InvokeVoidAsync("lmsNav.setRailCollapsed", _railCollapsed);
    }

    private async Task Logout()
    {
        await ContextStore.ClearAsync();
        Permissions.Clear();
        Navigation.NavigateToLogout("authentication/logout");
    }
}
