@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inherits LayoutComponentBase
@inject ICultureService Culture
@inject NavigationManager Navigation
@inject IContextStore ContextStore
@inject PermissionState Permissions

<div data-testid="app-root" dir="@(Culture.IsRightToLeft ? "rtl" : "ltr")" lang="@Culture.Current.TwoLetterISOLanguageName">
    <MudRTLProvider RightToLeft="@Culture.IsRightToLeft">
        <MudThemeProvider />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />
        <MudLayout>
            <MudAppBar Elevation="1">
                <AuthorizeView>
                    <Authorized>
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                                       aria-label="@L["Nav_Menu"]" OnClick="() => _drawerOpen = !_drawerOpen" data-testid="nav-toggle" />
                    </Authorized>
                </AuthorizeView>
                <MudText Typo="Typo.h6" Class="d-none d-sm-flex">@L["App_Title"]</MudText>
                <MudSpacer />
                <AuthorizeView>
                    <Authorized>
                        <ContextSwitcher />
                    </Authorized>
                </AuthorizeView>
                <LanguageSwitcher />
                <AuthorizeView>
                    <Authorized>
                        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AriaLabel="@L["Menu_User"]"
                                 data-testid="user-menu">
                            <MudText Class="px-4 py-2" Typo="Typo.subtitle2">@context.User.Identity?.Name</MudText>
                            <MudMenuItem OnClick="Logout">@L["Menu_Logout"]</MudMenuItem>
                        </MudMenu>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Color="Color.Inherit" Href="authentication/login">@L["Menu_Login"]</MudButton>
                    </NotAuthorized>
                </AuthorizeView>
            </MudAppBar>
            <AuthorizeView>
                <Authorized>
                    <ContextGate />
                    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always" Elevation="1">
                        <NavMenu />
                    </MudDrawer>
                </Authorized>
            </AuthorizeView>
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </MudRTLProvider>
</div>

@code {
    private bool _drawerOpen = true;

    private async Task Logout()
    {
        await ContextStore.ClearAsync();
        Permissions.Clear();
        Navigation.NavigateToLogout("authentication/logout");
    }
}
