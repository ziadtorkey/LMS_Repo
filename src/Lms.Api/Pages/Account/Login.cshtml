@page "/Account/Login"
@using Lms.Api.Resources
@using Microsoft.Extensions.Localization
@model Lms.Api.Pages.Account.LoginModel
@inject IStringLocalizer<AccountResource> L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    // Keep the chosen language when moving to the recovery page.
    var forgotQuery = Request.Query.TryGetValue("culture", out var culture)
        ? $"?culture={Uri.EscapeDataString(culture.ToString())}&ui-culture={Uri.EscapeDataString(culture.ToString())}"
        : string.Empty;
}
<h1>@L["Heading"]</h1>
<form method="post">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <label>@L["Email"]
        <input data-testid="login-email" name="Input.Email" type="email" autocomplete="username" value="@Model.Input.Email" required />
    </label>
    <label>@L["Password"]
        <input data-testid="login-password" name="Input.Password" type="password" autocomplete="current-password" required />
    </label>
    @if (Model.Error is not null)
    {
        <div class="error" role="alert" data-testid="login-error">@Model.Error</div>
    }
    <button data-testid="login-submit" type="submit">@L["SignIn"]</button>
</form>
<div class="links"><a data-testid="forgot-password-link" href="/Account/ForgotPassword@(forgotQuery)">@L["ForgotPassword"]</a></div>
