@page "/Account/ResetPassword"
@using Lms.Api.Resources
@using Microsoft.Extensions.Localization
@model Lms.Api.Pages.Account.ResetPasswordModel
@inject IStringLocalizer<AccountResource> L
@{
    ViewData["Title"] = (Model.Invite ? L["InviteHeading"] : L["ResetHeading"]).Value;
}
<h1>@(Model.Invite ? L["InviteHeading"] : L["ResetHeading"])</h1>
@if (Model.Done)
{
    <div class="success" role="status" data-testid="reset-success">@L["PasswordChanged"]</div>
    <div class="links"><a data-testid="reset-signin" href="/Account/Login">@L["BackToSignIn"]</a></div>
}
else if (!Model.LinkValid)
{
    <div class="error" role="alert" data-testid="reset-error">@L["LinkInvalid"]</div>
    <div class="links"><a href="/Account/ForgotPassword">@L["ForgotPassword"]</a></div>
}
else
{
    <form method="post">
        <label>@L["NewPassword"]
            <input data-testid="reset-password" name="Input.Password" type="password" autocomplete="new-password" required />
        </label>
        <label>@L["ConfirmPassword"]
            <input data-testid="reset-confirm" name="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
        </label>
        @if (Model.Error is not null)
        {
            <div class="error" role="alert" data-testid="reset-error">@Model.Error</div>
        }
        <button data-testid="reset-submit" type="submit">@L["SetPassword"]</button>
    </form>
}
