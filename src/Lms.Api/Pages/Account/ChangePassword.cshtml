@page "/Account/ChangePassword"
@using Lms.Api.Resources
@using Microsoft.Extensions.Localization
@model Lms.Api.Pages.Account.ChangePasswordModel
@inject IStringLocalizer<AccountResource> L
@{
    ViewData["Title"] = L["ChangePassword_Title"].Value;
}
<h1>@L["ChangePassword_Title"]</h1>
<p data-testid="change-intro">@L["ChangePassword_Intro"]</p>
<form method="post">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <label>@L["ChangePassword_Current"]
        <input data-testid="change-current" name="Input.Current" type="password" autocomplete="current-password" required />
    </label>
    <label>@L["ChangePassword_New"]
        <input data-testid="change-new" name="Input.NewPassword" type="password" autocomplete="new-password" required />
    </label>
    <label>@L["ChangePassword_Confirm"]
        <input data-testid="change-confirm" name="Input.Confirm" type="password" autocomplete="new-password" required />
    </label>
    @if (Model.Error is not null)
    {
        <div class="error" role="alert" data-testid="change-error">@Model.Error</div>
    }
    <button data-testid="change-submit" type="submit">@L["ChangePassword_Submit"]</button>
</form>
