@page "/Account/ForgotPassword"
@using Lms.Api.Resources
@using Microsoft.Extensions.Localization
@model Lms.Api.Pages.Account.ForgotPasswordModel
@inject IStringLocalizer<AccountResource> L
@{
    ViewData["Title"] = L["ForgotHeading"].Value;
}
<h1>@L["ForgotHeading"]</h1>
@if (Model.Sent)
{
    <div class="success" role="status" data-testid="forgot-confirmation">@L["ResetSent"]</div>
}
else
{
    <form method="post">
        <label>@L["Email"]
            <input data-testid="forgot-email" name="Input.Email" type="email" autocomplete="username" required />
        </label>
        @if (Model.Error is not null)
        {
            <div class="error" role="alert" data-testid="forgot-error">@Model.Error</div>
        }
        <button data-testid="forgot-submit" type="submit">@L["SendLink"]</button>
    </form>
}
<div class="links"><a href="/Account/Login">@L["BackToSignIn"]</a></div>
