@using System.Globalization
@using Lms.Api.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AccountResource> L
@{
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var otherCulture = isArabic ? "en" : "ar";

    // The language link keeps the rest of the query (return url, reset token...) and swaps only the culture.
    var kept = Context.Request.Query
        .Where(q => q.Key != "culture" && q.Key != "ui-culture")
        .Select(q => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(q.Value.ToString())}");
    var languageQuery = string.Join("&", kept.Append($"culture={otherCulture}").Append($"ui-culture={otherCulture}"));
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #f4f5f7; margin: 0; display: grid; place-items: center; min-height: 100vh; }
        main { background: #fff; padding: 2rem; border-radius: 8px; width: min(24rem, 92vw); box-shadow: 0 1px 6px rgba(0,0,0,.12); }
        label { display: block; margin-top: 1rem; font-size: .9rem; }
        input { width: 100%; padding: .6rem; margin-top: .3rem; box-sizing: border-box; }
        button { margin-top: 1.5rem; width: 100%; padding: .7rem; cursor: pointer; }
        .error { color: #b00020; margin-top: 1rem; }
        .success { color: #1b5e20; margin-top: 1rem; }
        .lang { text-align: end; font-size: .85rem; }
        .links { margin-top: 1rem; font-size: .9rem; }
    </style>
</head>
<body>
    <main>
        <div class="lang"><a href="?@languageQuery">@L["SwitchLanguage"]</a></div>
        @RenderBody()
    </main>
</body>
</html>
